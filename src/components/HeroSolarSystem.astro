---
/**
 * The studio process as a small solar system.
 *
 * Four independent satellites share one continuous orbit, so the movement
 * communicates the production sequence instead of acting as decoration only:
 * Fikir -> Produksiyon -> Post -> Teslim.
 */
const stages = [
  { no: "01", label: "FİKİR", className: "idea" },
  { no: "02", label: "PRODÜKSİYON", className: "production" },
  { no: "03", label: "POST", className: "post" },
  { no: "04", label: "TESLİM", className: "delivery" },
];
---

<div class="solar" aria-hidden="true" data-hero-solar>
  <span class="solar__glow"></span>
  <div class="solar__plane">
    <svg class="solar__tracks" viewBox="0 0 100 100" preserveAspectRatio="none">
      <ellipse class="solar__track solar__track--outer" cx="50" cy="50" rx="42" ry="27.5"></ellipse>
      <ellipse class="solar__track solar__track--flow" cx="50" cy="50" rx="42" ry="27.5" pathLength="100"></ellipse>
    </svg>

    <ol class="solar__stages">
      {stages.map((stage, index) => (
        <li class={`solar__stage solar__stage--${stage.className}`} style={`--stage:${index};`}>
          <span class="solar__planet">
            <span class="solar__world">
              <span class="solar__glyph"><i></i><i></i><i></i></span>
            </span>
            <span class="solar__label"><b>{stage.no}</b> / {stage.label}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>

  <div class="solar__axis solar__axis--x">
    <svg class="solar__tracks" viewBox="0 0 100 100" preserveAspectRatio="none">
      <ellipse class="solar__track solar__track--middle" cx="50" cy="50" rx="31" ry="20.5" pathLength="100"></ellipse>
    </svg>
  </div>

  <div class="solar__axis solar__axis--y">
    <svg class="solar__tracks" viewBox="0 0 100 100" preserveAspectRatio="none">
      <ellipse class="solar__track solar__track--inner" cx="50" cy="50" rx="19" ry="12.5" pathLength="100"></ellipse>
    </svg>
  </div>

  <span class="solar__core">
    <img src="/hero/rast-sun-logo.svg" alt="" width="660" height="400" loading="eager" decoding="async" />
  </span>

  <span class="solar__signal solar__signal--one"></span>
  <span class="solar__signal solar__signal--two"></span>
  <span class="solar__caption">FİKİRDEN TESLİME / SÜREKLİ ÜRETİM</span>
</div>

<style>
  .solar {
    position: relative;
    width: min(100%, 40rem);
    aspect-ratio: 1;
    isolation: isolate;
    overflow: visible;
    pointer-events: none;
  }

  .solar__plane {
    position: absolute;
    inset: 0;
    z-index: 1;
    transform: none;
    transform-origin: 50% 50%;
  }

  .solar__axis {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    pointer-events: none;
    will-change: transform;
  }
  .solar__axis--x {
    z-index: 2;
    transform: rotateZ(-8deg) scaleY(0.62);
    animation: solar-axis-x 15s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }
  .solar__axis--y {
    z-index: 3;
    transform: rotateZ(13deg) scaleX(0.56);
    animation: solar-axis-y 18s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }

  .solar__glow {
    position: absolute;
    inset: 13% 2% 11% 5%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 53% 49%, rgba(240, 91, 13, 0.16), transparent 17%),
      radial-gradient(ellipse at 58% 52%, rgba(134, 51, 15, 0.10), transparent 60%);
    filter: blur(26px);
  }

  .solar__tracks {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 18px rgba(226, 83, 3, 0.07));
  }
  .solar__track {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .solar__track--outer {
    stroke: rgba(255, 255, 255, 0.135);
    stroke-width: 1;
  }
  .solar__track--flow {
    stroke: rgba(255, 102, 34, 0.66);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 1 16 0.3 11;
    animation: solar-track-flow 28s linear infinite;
  }
  .solar__track--middle {
    stroke: rgba(255, 255, 255, 0.17);
    stroke-width: 1;
    stroke-dasharray: 0.6 3.1;
    animation: solar-track-middle 34s linear infinite reverse;
  }
  .solar__track--inner {
    stroke: rgba(255, 110, 48, 0.22);
    stroke-width: 1;
    stroke-dasharray: 8 4 1 5;
    animation: solar-track-inner 31s linear infinite;
  }

  .solar__core {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 20;
    width: clamp(6.5rem, 19%, 7.5rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    gap: 0.25rem;
    text-align: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.16), transparent 9%),
      radial-gradient(circle, rgba(73, 34, 18, 0.54), rgba(17, 11, 8, 0.98) 52%, rgba(3, 3, 3, 0.99) 78%);
    box-shadow:
      0 0 0 8px rgba(255, 255, 255, 0.018),
      0 0 24px rgba(255, 96, 24, 0.2),
      0 0 58px rgba(225, 71, 0, 0.12),
      inset 0 0 24px rgba(255, 125, 52, 0.12);
    filter: drop-shadow(0 0 14px rgba(255, 94, 24, 0.14));
    transform: translate(-50%, -50%);
  }
  .solar__core::before {
    content: "";
    position: absolute;
    inset: 7%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 111, 36, 0.17), transparent 70%);
    filter: blur(8px);
    animation: solar-corona 7s ease-in-out infinite alternate;
  }
  .solar__core img {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: 82%;
    height: 82%;
    object-fit: contain;
    opacity: 0.9;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.2)) drop-shadow(0 0 9px rgba(255, 99, 28, 0.2));
    transform: translate(-50%, -50%);
  }

  .solar__stages {
    position: absolute;
    inset: 0;
    z-index: 5;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .solar__stage {
    --orbit-delay: calc(var(--stage) * -10s);
    position: absolute;
    left: 0;
    top: 0;
    width: 8.6rem;
    height: 6.4rem;
    offset-path: ellipse(42% 27.5% at 50% 50%);
    offset-anchor: 50% 50%;
    offset-distance: 0%;
    offset-rotate: 0deg;
    animation: solar-stage 40s linear infinite;
    animation-delay: var(--orbit-delay);
    will-change: offset-distance;
  }
  .solar__planet {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    filter: drop-shadow(0 18px 26px rgba(0, 0, 0, 0.46));
    transform: none;
  }
  .solar__world {
    position: absolute;
    width: var(--planet-size, 5.6rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.17);
    border-radius: 50%;
    background:
      radial-gradient(circle at 31% 24%, rgba(255, 255, 255, 0.23), transparent 9%),
      radial-gradient(circle at 52% 54%, rgba(49, 29, 20, 0.92), rgba(4, 4, 4, 0.98) 69%);
    box-shadow:
      inset -12px -14px 24px rgba(0, 0, 0, 0.62),
      inset 5px 6px 12px rgba(255, 255, 255, 0.035),
      0 0 22px rgba(226, 83, 3, 0.13);
  }
  .solar__world::before {
    content: "";
    position: absolute;
    inset: 10%;
    border: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 50%;
  }
  .solar__world::after {
    content: "";
    position: absolute;
    left: 21%;
    right: 21%;
    bottom: 13%;
    height: 8%;
    border-radius: 50%;
    background: rgba(239, 83, 13, 0.18);
    filter: blur(7px);
  }
  .solar__glyph {
    position: relative;
    z-index: 2;
    width: 2rem;
    height: 2rem;
    color: rgba(247, 247, 244, 0.86);
    filter: drop-shadow(0 0 7px rgba(255, 100, 34, 0.28));
  }
  .solar__glyph i {
    position: absolute;
    display: block;
    background: currentColor;
  }
  .solar__label {
    position: absolute;
    left: 50%;
    bottom: -0.15rem;
    translate: -50% 0;
    padding: 0.43rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 999px;
    background: rgba(11, 10, 9, 0.62);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    font-family: var(--font-utility);
    font-size: 0.51rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgba(242, 242, 240, 0.76);
    white-space: nowrap;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
  }
  .solar__label b {
    color: #ef6a27;
    font-weight: 700;
  }
  .solar__stage--idea { --planet-size: 4.7rem; }
  .solar__stage--production { --planet-size: 6.1rem; }
  .solar__stage--post { --planet-size: 5.2rem; }
  .solar__stage--delivery { --planet-size: 4.9rem; }

  /* Fikir: a controlled spark — the moment the system starts. */
  .solar__stage--idea .solar__glyph i:nth-child(1),
  .solar__stage--idea .solar__glyph i:nth-child(2) {
    left: 50%;
    top: 50%;
    width: 1.8rem;
    height: 1px;
    transform: translate(-50%, -50%);
  }
  .solar__stage--idea .solar__glyph i:nth-child(2) { transform: translate(-50%, -50%) rotate(90deg); }
  .solar__stage--idea .solar__glyph i:nth-child(3) {
    left: 50%;
    top: 50%;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #ff6929;
    box-shadow: 0 0 10px rgba(255, 105, 41, 0.82);
    transform: translate(-50%, -50%);
  }
  .solar__stage--idea .solar__glyph::before,
  .solar__stage--idea .solar__glyph::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.35rem;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .solar__stage--idea .solar__glyph::after { transform: translate(-50%, -50%) rotate(-45deg); }

  /* Prodüksiyon: an aperture with three moving blades. */
  .solar__stage--production .solar__glyph {
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 50%;
    animation: solar-aperture 22s linear infinite;
  }
  .solar__stage--production .solar__glyph::after {
    content: "";
    position: absolute;
    inset: 35%;
    border: 1px solid #ff6a2a;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(255, 106, 42, 0.46);
  }
  .solar__stage--production .solar__glyph i {
    left: 50%;
    top: 50%;
    width: 0.82rem;
    height: 0.22rem;
    border-radius: 999px;
    transform-origin: 0 50%;
    background: rgba(247, 247, 244, 0.72);
  }
  .solar__stage--production .solar__glyph i:nth-child(1) { transform: rotate(0deg) translateX(0.42rem); }
  .solar__stage--production .solar__glyph i:nth-child(2) { transform: rotate(120deg) translateX(0.42rem); }
  .solar__stage--production .solar__glyph i:nth-child(3) { transform: rotate(240deg) translateX(0.42rem); }

  /* Post: three edit lanes and their playheads. */
  .solar__stage--post .solar__glyph i {
    left: 0.1rem;
    width: 1.8rem;
    height: 1px;
    background: rgba(247, 247, 244, 0.64);
  }
  .solar__stage--post .solar__glyph i::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: #ff6929;
    box-shadow: 0 0 7px rgba(255, 105, 41, 0.58);
    transform: translateY(-50%);
  }
  .solar__stage--post .solar__glyph i:nth-child(1) { top: 0.42rem; }
  .solar__stage--post .solar__glyph i:nth-child(1)::after { left: 20%; }
  .solar__stage--post .solar__glyph i:nth-child(2) { top: 0.98rem; }
  .solar__stage--post .solar__glyph i:nth-child(2)::after { left: 66%; }
  .solar__stage--post .solar__glyph i:nth-child(3) { top: 1.54rem; }
  .solar__stage--post .solar__glyph i:nth-child(3)::after { left: 42%; }

  /* Teslim: the only final-state symbol in the loop. */
  .solar__stage--delivery .solar__glyph i:nth-child(1) {
    left: 0.48rem;
    top: 0.18rem;
    width: 0.72rem;
    height: 1.38rem;
    border-right: 2px solid #ff6a2a;
    border-bottom: 2px solid #ff6a2a;
    background: transparent;
    transform: rotate(43deg);
  }
  .solar__stage--delivery .solar__glyph i:nth-child(2),
  .solar__stage--delivery .solar__glyph i:nth-child(3) { display: none; }

  .solar__signal {
    position: absolute;
    z-index: 3;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 104, 39, 0.9);
    box-shadow: 0 0 8px 2px rgba(240, 79, 14, 0.6);
  }
  .solar__signal--one {
    left: 34%;
    top: 47%;
    animation: solar-pulse 5.2s ease-in-out infinite;
  }
  .solar__signal--two {
    right: 25%;
    bottom: 30%;
    animation: solar-pulse 5.2s ease-in-out -2.6s infinite;
  }
  .solar__caption {
    position: absolute;
    right: 3%;
    bottom: 4%;
    z-index: 8;
    font-family: var(--font-utility);
    font-size: 0.52rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(241, 241, 239, 0.42);
  }

  @keyframes solar-stage { to { offset-distance: 100%; } }
  @keyframes solar-axis-x {
    from { transform: rotateZ(-8deg) scaleY(0.56); }
    to { transform: rotateZ(-8deg) scaleY(0.76); }
  }
  @keyframes solar-axis-y {
    from { transform: rotateZ(13deg) scaleX(0.52); }
    to { transform: rotateZ(13deg) scaleX(0.82); }
  }
  @keyframes solar-track-flow { to { stroke-dashoffset: -100; } }
  @keyframes solar-track-middle { to { stroke-dashoffset: 100; } }
  @keyframes solar-track-inner { to { stroke-dashoffset: -100; } }
  @keyframes solar-pulse {
    0%, 100% { opacity: 0.25; scale: 0.8; }
    50% { opacity: 1; scale: 1.25; }
  }
  @keyframes solar-corona {
    from { opacity: 0.62; transform: scale(0.94); }
    to { opacity: 1; transform: scale(1.08); }
  }
  @keyframes solar-aperture { to { transform: rotate(360deg); } }

  @media (max-width: 979.98px) {
    .solar {
      position: relative;
      top: auto;
      right: auto;
      width: min(76vw, 20rem);
      max-height: 100%;
      opacity: 0.74;
      z-index: 1;
    }
    .solar__label,
    .solar__caption,
    .solar__track--flow,
    .solar__signal {
      display: none;
    }
    .solar__stage {
      width: 5.4rem;
      height: 4.4rem;
    }
    .solar__stage--idea { --planet-size: 3.05rem; }
    .solar__stage--production { --planet-size: 3.75rem; }
    .solar__stage--post { --planet-size: 3.3rem; }
    .solar__stage--delivery { --planet-size: 3.15rem; }
    .solar__core {
      width: clamp(4.5rem, 21%, 5.25rem);
    }
    .solar__glow {
      inset: 18% 8% 16%;
      filter: blur(20px);
    }
  }

  @media (max-width: 420px) {
    .solar {
      width: min(74vw, 17.5rem);
    }
    .solar__stage {
      width: 4.8rem;
      height: 3.9rem;
    }
    .solar__stage--idea { --planet-size: 2.75rem; }
    .solar__stage--production { --planet-size: 3.35rem; }
    .solar__stage--post { --planet-size: 3rem; }
    .solar__stage--delivery { --planet-size: 2.85rem; }
    .solar__core {
      width: 4.4rem;
    }
  }

  @media (max-width: 380px) {
    .solar {
      width: min(68vw, 14.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solar__track,
    .solar__plane,
    .solar__axis,
    .solar__stage,
    .solar__signal,
    .solar__glyph,
    .solar__core::before {
      animation-play-state: paused;
    }
  }
</style>

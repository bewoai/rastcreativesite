---
/**
 * Evren footer: one glass plate — motto, pages, contact, socials, legal.
 * Styles: src/styles/evren.css (.ev-foot).
 */
import Logo from "../Logo.astro";
import { BRAND, CONTACT, SITE, SOCIAL } from "../../consts";
import { EV_NAV, EV_NAV_EN } from "../../lib/evren";
import { langOfPath } from "../../lib/i18n";

const year = new Date().getFullYear();
const en = langOfPath(Astro.url.pathname) === "en";
---

<footer class="ev-foot">
  <div class="ev-foot__inner ev-glass">
    <div class="ev-foot__brand">
      <Logo />
      {
        en ? (
          <p class="ev-foot__motto">Good work gets <em>watched.</em></p>
        ) : (
          <p class="ev-foot__motto">İyi iş kendini <em>izletir.</em></p>
        )
      }
      <p class="ev-foot__about">{en ? BRAND.entityEn : BRAND.entity}</p>
    </div>
    {
      en ? (
        <nav class="ev-foot__col" aria-label="Footer">
          {EV_NAV_EN.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="/en/tools/">Free tools</a>
          <a href="/araclar/" hreflang="tr" lang="tr">Ücretsiz araçlar (Türkçe)</a>
        </nav>
      ) : (
    <nav class="ev-foot__col" aria-label="Alt gezinme">
      {EV_NAV.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/sektorler/">Sektörler</a>
      <a href="/sakarya-reklam-ajansi/">Sakarya'da hizmetler</a>
      <a href="/hekim-icerik-sistemi/">Hekimler için</a>
      <a href="/fotograftan-yapay-zeka-reklam-videosu/">Fotoğraftan video</a>
      <a href="/sss/">SSS</a>
      <a href="/sozluk/">Sözlük</a>
      <a href="/cekim-planlayici/">Çekim planlayıcı</a>
      <a href="/araclar/">Araçlar</a>
      <a href="/en/tools/" hreflang="en" lang="en">Free tools (English)</a>
    </nav>
      )
    }
    <div class="ev-foot__col">
      <span>{en ? "Serdivan, Sakarya, Turkey" : CONTACT.city}</span>
      <a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </div>
    <div class="ev-foot__col">
      {
        SOCIAL.map((s) => (
          <a href={s.href} target="_blank" rel="me noopener noreferrer">
            {s.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
    <div class="ev-foot__bottom">
      <span>© {year} {SITE.name}</span>
      <span>
        <a href="/kvkk/">{en ? "Privacy (KVKK)" : "KVKK ve Gizlilik"}</a> ·
        <button type="button" class="ev-foot__consent" data-consent-open>{en ? "Cookie preferences" : "Çerez tercihleri"}</button> ·
        <a href="/telif/">{en ? "Copyright" : "Telif"}</a>
      </span>
    </div>
  </div>
</footer>

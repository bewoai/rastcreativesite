---
/**
 * Free creative LUT pack (5 x 33^3 .cube) for Rec.709 footage.
 * Files: public/araclar/lut-paketi/ (zip + before/after webp from our own BTS photos).
 * LUTs are generated with numpy; pipeline: docs/sections/araclar-paketler.md. No prices.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import Button from "../../../components/Button.astro";
import { PRIMARY_CTA, SITE } from "../../../consts";
import { breadcrumb, faqPage } from "../../../lib/schema";
import ToolHeader from "../../../components/araclar/ToolHeader.astro";
import MoreTools from "../../../components/araclar/MoreTools.astro";
import ToolFaq from "../../../components/araclar/ToolFaq.astro";

const PATH = "/araclar/lut-paketi/";
const PAGE_URL = new URL(PATH, SITE.url).href;
const DIR = "/araclar/lut-paketi/";
const ZIP = DIR + "rast-lut-pack.zip";
const ZIP_MB = "1,9 MB";
const title = "Ücretsiz LUT Paketi (.cube): Premiere, DaVinci";
const description =
  "Rast LUT Pack: 5 ücretsiz .cube LUT. Sıcak film, soğuk gece, doğal kontrast, soluk matte, altın saat. Rec.709 için, ten rengini korur, ticari kullanım serbest.";

const LUTS = [
  {
    slug: "rast-sicak-film",
    name: "Rast Sıcak Film",
    frame: "kamera-roportaj",
    alt: "AVM'de röportaj çekimi, kamera ekranında konuşan kişi",
    text: "Yumuşak siyahlar, sıcak ışıklar, hafif film kontrastı. Röportaj, vlog ve iç mekân için güvenli bir başlangıç.",
  },
  {
    slug: "rast-soguk-gece",
    name: "Rast Soğuk Gece",
    frame: "sokak-kadraj",
    alt: "Akşamüstü sokakta kamera ekranında kadraj",
    text: "Serin gölgeler, biraz düşük pozlama, nötre yakın beyazlar. Şehir, gece ve gerilimli sahneler için.",
  },
  {
    slug: "rast-dogal-kontrast",
    name: "Rast Doğal Kontrast",
    frame: "etkinlik-sahne",
    alt: "Açık havada konser sahnesini çeken kameraman",
    text: "Nötr renk, biraz daha derin kontrast ve canlılık. Kurumsal, etkinlik ve ürün videolarında “düz” görüntüyü toparlar.",
  },
  {
    slug: "rast-soluk-matte",
    name: "Rast Soluk Matte",
    frame: "ofis-isik-kurulumu",
    alt: "Ofiste ışık kurulumu ve çekim hazırlığı",
    text: "Kaldırılmış siyahlar, yumuşatılmış beyazlar, düşük doygunluk. Moda, lifestyle ve sakin anlatımlar için.",
  },
  {
    slug: "rast-altin-saat-hafif",
    name: "Rast Altın Saat Hafif",
    frame: "etkinlik-sahne",
    alt: "Açık havada konser sahnesini çeken kameraman",
    text: "Gün batımı sıcaklığını abartmadan ekler; turuncu ve sarılar biraz zenginleşir, ten rengi yerinde kalır.",
  },
];

const faqs = [
  {
    question: "Bu LUT'lar log (S-Log, V-Log, D-Log) görüntüde çalışır mı?",
    answer:
      "Doğrudan değil. Bunlar dönüşüm değil, yaratıcı (look) LUT'lardır ve normal Rec.709 görüntü için hesaplandı. Log çektiyseniz önce kameranızın üreticisinin Rec.709 dönüşüm LUT'unu ya da Resolve'daki renk alanı dönüşümünü uygulayın, Rast LUT'unu ondan sonraki adımda kullanın.",
  },
  {
    question: "Premiere Pro'da LUT nasıl yüklenir?",
    answer:
      "Lumetri Renk panelinde Yaratıcı (Creative) bölümünü açın, Görünüm (Look) menüsünden Gözat'ı seçip .cube dosyasını gösterin. Yoğunluk (Intensity) kaydırıcısıyla gücünü ayarlayın; çoğu görüntüde %50–80 en doğal sonucu verir. Kalıcı olması için dosyaları Premiere'in LUTs/Creative klasörüne de kopyalayabilirsiniz.",
  },
  {
    question: "DaVinci Resolve'da LUT nereye konur?",
    answer:
      "Proje Ayarları > Renk Yönetimi > LUT Klasörünü Aç ile klasörü açın, Rast klasörünü içine kopyalayın ve “LUT listesini güncelle”ye basın. Color sayfasında bir node'a sağ tıklayıp 3D LUT > Rast altından seçin. Gücünü azaltmak için LUT'u ayrı bir node'a koyup Key Output Gain'i düşürün.",
  },
  {
    question: "CapCut ve Final Cut Pro'da kullanılabilir mi?",
    answer:
      "Evet. CapCut masaüstünde Ayarla (Adjust) > LUT bölümünden .cube dosyasını içe aktarın. Final Cut Pro'da Efektler > Renk > Özel LUT (Custom LUT) efektini klibe ekleyin ve LUT menüsünden “Özel LUT Seç” ile dosyayı gösterin.",
  },
  {
    question: "Ten rengini bozar mı?",
    answer:
      "LUT'ları hesaplarken cilt tonu aralığındaki renk kaymasını sınırladık: kendi çekimlerimizdeki yüz ve kol bölgelerinde renk tonu 2 dereceden az kaydı. Yine de ışığı çok farklı (yeşil floresan, karışık ışık) görüntülerde önce beyaz dengesini düzeltin, LUT'u sonra uygulayın.",
  },
  {
    question: "Ticari işlerde kullanabilir miyim?",
    answer:
      "Evet. LUT'lar CC BY 4.0 lisanslıdır: müşteri işleri, reklam ve sosyal medya videoları dahil kullanabilir, değiştirebilirsiniz. Tek şart atıf: “Renk LUT'u: Rast Creative Studio — rastcreative.com”. LUT dosyalarını olduğu gibi yeniden satmayın.",
  },
];

const citeHtml = `<a href="${PAGE_URL}">Rast LUT Pack — Rast Creative</a>`;

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
    { name: "LUT paketi", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${PAGE_URL}#paket`,
    name: "Rast LUT Pack",
    alternateName: "Ücretsiz .cube LUT paketi (Rec.709)",
    url: PAGE_URL,
    description,
    inLanguage: "tr",
    isAccessibleForFree: true,
    encodingFormat: "application/zip",
    license: "https://creativecommons.org/licenses/by/4.0/deed.tr",
    creator: { "@id": `${SITE.url}#business` },
    publisher: { "@id": `${SITE.url}#business` },
    datePublished: "2026-10-31",
    keywords: "lut, cube lut, ücretsiz lut, premiere lut, davinci resolve lut, capcut lut, renk düzenleme",
    associatedMedia: {
      "@type": "MediaObject",
      name: "rast-lut-pack.zip",
      contentUrl: new URL(ZIP, SITE.url).href,
      encodingFormat: "application/zip",
    },
    hasPart: LUTS.map((l) => ({
      "@type": "CreativeWork",
      name: l.name,
      description: l.text,
      encodingFormat: "text/plain",
      image: new URL(`${DIR}sonra-${l.slug}.webp`, SITE.url).href,
    })),
  },
  faqPage(faqs),
];

// ---------- English twin (/en/tools/free-lut-pack/, src/lib/i18n.ts) ----------
interface Props {
  lang?: "tr" | "en";
}
const { lang = "tr" } = Astro.props;
const en = lang === "en";
const EN_PATH = "/en/tools/free-lut-pack/";
const EN_URL = new URL(EN_PATH, SITE.url).href;
const ZIP_MB_EN = ZIP_MB.replace(",", ".");
const LUT_EN: Record<string, { name: string; alt: string; text: string }> = {
  "rast-sicak-film": { name: "Rast Warm Film", alt: "Interview shoot in a mall, person talking on the camera monitor", text: "Soft blacks, warm highlights, a touch of film contrast. A safe starting point for interviews, vlogs and interiors." },
  "rast-soguk-gece": { name: "Rast Cool Night", alt: "Framing a street scene at dusk on the camera monitor", text: "Cool shadows, slightly lower exposure, near-neutral whites. For city, night and tense scenes." },
  "rast-dogal-kontrast": { name: "Rast Natural Contrast", alt: "Camera operator filming an outdoor concert stage", text: "Neutral color with a bit more depth and vibrance. Lifts “flat” footage in corporate, event and product videos." },
  "rast-soluk-matte": { name: "Rast Faded Matte", alt: "Lighting setup and shoot prep in an office", text: "Lifted blacks, softened whites, lower saturation. For fashion, lifestyle and calm storytelling." },
  "rast-altin-saat-hafif": { name: "Rast Subtle Golden Hour", alt: "Camera operator filming an outdoor concert stage", text: "Adds sunset warmth without overdoing it; oranges and yellows get richer while skin tones stay put." },
};
const LUTS_VIEW = en ? LUTS.map((l) => ({ ...l, ...(LUT_EN[l.slug] ?? {}) })) : LUTS;
const enTitle = "Free LUT Pack (.cube) for Premiere Pro, DaVinci, CapCut";
const enDescription =
  "Rast LUT Pack: 5 free .cube LUTs for Rec.709 footage. Warm film, cool night, natural contrast, faded matte, golden hour. Skin-tone safe, commercial use allowed.";
const enFaqs = [
  {
    question: "Do these LUTs work on log footage (S-Log, V-Log, D-Log)?",
    answer:
      "Not directly. These are creative (look) LUTs, not conversion LUTs, built for normal Rec.709 footage. If you shot log, first apply your camera maker's Rec.709 conversion LUT or a color space transform in Resolve, then add the Rast LUT as the next step.",
  },
  {
    question: "How do I load a LUT in Premiere Pro?",
    answer:
      "Open the Creative section of the Lumetri Color panel, choose Browse in the Look menu and select the .cube file. Set the strength with the Intensity slider; 50–80% looks most natural on most footage. To keep the LUTs available, you can also copy the files into Premiere's LUTs/Creative folder.",
  },
  {
    question: "Where do LUTs go in DaVinci Resolve?",
    answer:
      "Go to Project Settings > Color Management > Open LUT Folder, copy the Rast folder inside and click “Update Lists”. On the Color page, right-click a node and pick 3D LUT > Rast. To reduce the strength, put the LUT on its own node and lower Key Output Gain.",
  },
  {
    question: "Can I use them in CapCut and Final Cut Pro?",
    answer:
      "Yes. In CapCut desktop, import the .cube file under Adjust > LUT. In Final Cut Pro, add the Effects > Color > Custom LUT effect to the clip and choose “Choose Custom LUT…” in the LUT menu.",
  },
  {
    question: "Will they ruin skin tones?",
    answer:
      "We limited the hue shift in the skin-tone range when building the LUTs: on faces and arms in our own footage the hue moved by less than 2 degrees. With very different light (green fluorescents, mixed light) fix the white balance first, then apply the LUT.",
  },
  {
    question: "Can I use them for commercial work?",
    answer:
      "Yes. The LUTs are licensed CC BY 4.0: use and modify them in client work, ads and social media videos. The only condition is credit: “Color LUT: Rast Creative Studio — rastcreative.com”. Don't resell the LUT files as they are.",
  },
];
const enCiteHtml = `<a href="${EN_URL}">Rast LUT Pack (free .cube LUTs) — Rast Creative</a>`;
const enJsonLd = [
  breadcrumb([
    { name: "Rast Creative", path: "/" },
    { name: "Free tools", path: "/en/tools/" },
    { name: "Free LUT pack", path: EN_PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${EN_URL}#pack`,
    name: "Rast LUT Pack",
    alternateName: "Free .cube LUT pack (Rec.709)",
    url: EN_URL,
    description: enDescription,
    inLanguage: "en",
    isAccessibleForFree: true,
    encodingFormat: "application/zip",
    license: "https://creativecommons.org/licenses/by/4.0/",
    creator: { "@id": `${SITE.url}#business` },
    publisher: { "@id": `${SITE.url}#business` },
    datePublished: "2026-10-31",
    keywords: "free luts, cube lut, premiere pro lut, davinci resolve lut, capcut lut, color grading",
    associatedMedia: {
      "@type": "MediaObject",
      name: "rast-lut-pack.zip",
      contentUrl: new URL(ZIP, SITE.url).href,
      encodingFormat: "application/zip",
    },
  },
  faqPage(enFaqs),
];

---

<BaseLayout title={en ? enTitle : title} description={en ? enDescription : description} jsonLd={en ? enJsonLd : jsonLd}>
{
  en ? (
    <Fragment>
  <Section width="wide" space="tight">
    <ToolHeader
      href={EN_PATH}
      h1="Free LUT pack: 5 .cube LUTs for Rec.709 footage"
      cta={{ href: ZIP, label: `Download the pack (ZIP, ${ZIP_MB_EN})`, download: true }}
      cta2={{ href: "#onizleme", label: "Before / after" }}
      preview
      badgeExtra="Free · CC BY 4.0"
    >
      <p>
        Five creative LUTs that give normal (Rec.709) phone or camera footage a consistent look in one step. Not heavy filters:
        all of them are subtle and built to protect skin tones. The comparisons below are from our own shoots; drag the slider
        to see before and after.
      </p>
    </ToolHeader>

    <div class="facts">
      <ul>
        <li><strong>5 LUTs</strong> · .cube · 33×33×33</li>
        <li>For <strong>Rec.709</strong> footage (not a log conversion)</li>
        <li><strong>Premiere, DaVinci, Final Cut, CapCut</strong></li>
        <li><strong>License:</strong> CC BY 4.0</li>
      </ul>
    </div>
  </Section>
    </Fragment>
  ) : (
    <Fragment>
  <Section width="wide" space="tight">
    <ToolHeader
      href="/araclar/lut-paketi/"
      h1="Rast LUT Pack: Rec.709 görüntü için 5 ücretsiz LUT"
      cta={{ href: ZIP, label: `Paketi indir (ZIP, ${ZIP_MB})`, download: true }}
      cta2={{ href: "#onizleme", label: "Önce / sonra" }}
      preview
      badgeExtra="Ücretsiz · CC BY 4.0"
    >
        <p>
          Telefon ya da kamerayla normal (Rec.709) çektiğiniz görüntüye tek adımda tutarlı bir görünüm veren beş yaratıcı LUT.
          Sert filtreler değil: hepsi abartısız, ten rengini koruyacak şekilde hesaplandı. Aşağıdaki karşılaştırmalar kendi
          çekimlerimizden; kaydırıcıyı sürükleyip önce/sonra farkını görebilirsiniz.
        </p>
      
    </ToolHeader>

    <div class="facts">
      <ul>
        <li><strong>5 LUT</strong> · .cube · 33×33×33</li>
        <li><strong>Rec.709</strong> görüntü için (log dönüşümü değil)</li>
        <li><strong>Premiere, DaVinci, Final Cut, CapCut</strong></li>
        <li><strong>Lisans:</strong> CC BY 4.0</li>
      </ul>
    </div>
  </Section>
    </Fragment>
  )
}

  {
  en ? (
    <Fragment>
  <Section width="wide" space="tight" id="onizleme">
    <SectionHeading eyebrow="Before / after">See the LUTs on our own footage</SectionHeading>
    <div class="luts">
      {
        LUTS_VIEW.map((l, i) => (
          <article class="lut" id={l.slug}>
            <figure class="ba" style="--pos: 50%">
              <img
                src={`${DIR}once-${l.frame}.webp`}
                alt={`${l.alt}, before the LUT`}
                width="1200"
                height="676"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <img
                class="ba__after"
                src={`${DIR}sonra-${l.slug}.webp`}
                alt={`${l.alt}, after the ${l.name} LUT`}
                width="1200"
                height="676"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <span class="ba__tag ba__tag--l" aria-hidden="true">Before</span>
              <span class="ba__tag ba__tag--r" aria-hidden="true">After</span>
              <span class="ba__line" aria-hidden="true" />
              <input type="range" min="0" max="100" value="50" aria-label={`${l.name}: before/after comparison slider`} />
            </figure>
            <div class="lut__txt">
              <h3>{l.name}</h3>
              <p>{l.text}</p>
              <code>{l.slug}.cube</code>
            </div>
          </article>
        ))
      }
    </div>
    <p class="dl">
      <a class="ev-btn ev-btn--sun" href={ZIP} download>All 5 LUTs (ZIP, {ZIP_MB_EN})</a>
    </p>
  </Section>
    </Fragment>
  ) : (
    <Fragment>
<Section width="wide" space="tight" id="onizleme">
    <SectionHeading eyebrow="Önce / sonra">LUT'ları kendi çekimlerimizde görün</SectionHeading>
    <div class="luts">
      {
        LUTS.map((l, i) => (
          <article class="lut" id={l.slug}>
            <figure class="ba" style="--pos: 50%">
              <img
                src={`${DIR}once-${l.frame}.webp`}
                alt={`${l.alt}, LUT uygulanmadan önce`}
                width="1200"
                height="676"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <img
                class="ba__after"
                src={`${DIR}sonra-${l.slug}.webp`}
                alt={`${l.alt}, ${l.name} LUT uygulandıktan sonra`}
                width="1200"
                height="676"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <span class="ba__tag ba__tag--l" aria-hidden="true">Önce</span>
              <span class="ba__tag ba__tag--r" aria-hidden="true">Sonra</span>
              <span class="ba__line" aria-hidden="true" />
              <input type="range" min="0" max="100" value="50" aria-label={`${l.name}: önce/sonra karşılaştırma kaydırıcısı`} />
            </figure>
            <div class="lut__txt">
              <h3>{l.name}</h3>
              <p>{l.text}</p>
              <code>{l.slug}.cube</code>
            </div>
          </article>
        ))
      }
    </div>
    <p class="dl">
      <a class="ev-btn ev-btn--sun" href={ZIP} download>5 LUT'un hepsi (ZIP, {ZIP_MB})</a>
    </p>
  </Section>
    </Fragment>
  )
}

  {
  en ? (
    <Fragment>
  <Section width="default" space="tight" id="kurulum">
    <SectionHeading eyebrow="Install">How to add the LUTs to your editor</SectionHeading>
    <div class="howto">
      <div>
        <h3>Premiere Pro</h3>
        <p>Lumetri Color &gt; <strong>Creative</strong> &gt; <strong>Look</strong> &gt; Browse… &gt; the .cube file. Try 50–80% on the Intensity slider. Set exposure and white balance in Basic Correction first.</p>
      </div>
      <div>
        <h3>DaVinci Resolve</h3>
        <p>Project Settings &gt; Color Management &gt; <strong>Open LUT Folder</strong>; copy the folder in and click “Update Lists”. On the Color page, right-click a node &gt; 3D LUT &gt; Rast. Put the LUT on the node after your correction node.</p>
      </div>
      <div>
        <h3>Final Cut Pro</h3>
        <p>Drag the Effects &gt; Color &gt; <strong>Custom LUT</strong> effect onto the clip, then in the Inspector choose LUT &gt; “Choose Custom LUT…” and select the .cube file. Lower the strength with Mix.</p>
      </div>
      <div>
        <h3>CapCut (desktop)</h3>
        <p>Select the clip, go to <strong>Adjust</strong> &gt; LUT &gt; Import and add the .cube file; set the intensity with the slider. .cube support in the mobile app depends on the version.</p>
      </div>
    </div>
    <ul class="tips">
      <li><strong>Order matters:</strong> exposure and white balance first, then the LUT. A LUT won't fix bad footage; it gives good footage character.</li>
      <li><strong>Shot in log?</strong> Apply your camera's Rec.709 conversion first, then the Rast LUT.</li>
      <li><strong>Consistency:</strong> pick one LUT per video and use the same intensity on every clip; even out scenes with small exposure tweaks.</li>
      <li><strong>Export:</strong> export in Rec.709 / sRGB so the grade looks the same on phones.</li>
    </ul>
    <p>
      Want to polish the sound too? Try the <a href="/en/tools/free-sound-effects-pack/">free SFX pack</a>; for text placement on
      vertical video, the <a href="/en/tools/reels-safe-zone-checker/">safe zone checker</a>. To export without wrecking the
      grade, check the <a href="/en/tools/video-bitrate-calculator/">video bitrate calculator</a>.
    </p>
    <p class="small">The .cube files keep their original Turkish file names: rast-sicak-film = Warm Film, rast-soguk-gece = Cool Night, rast-dogal-kontrast = Natural Contrast, rast-soluk-matte = Faded Matte, rast-altin-saat-hafif = Subtle Golden Hour.</p>
  </Section>
    </Fragment>
  ) : (
    <Fragment>
<Section width="default" space="tight" id="kurulum">
    <SectionHeading eyebrow="Kurulum">Programınıza nasıl eklenir?</SectionHeading>
    <div class="howto">
      <div>
        <h3>Premiere Pro</h3>
        <p>Lumetri Renk &gt; <strong>Yaratıcı (Creative)</strong> &gt; <strong>Görünüm (Look)</strong> &gt; Gözat… &gt; .cube dosyası. Yoğunluk kaydırıcısıyla %50–80 arası deneyin. Önce Temel Düzeltme'de pozlama ve beyaz dengesini oturtun.</p>
      </div>
      <div>
        <h3>DaVinci Resolve</h3>
        <p>Proje Ayarları &gt; Renk Yönetimi &gt; <strong>LUT Klasörünü Aç</strong>; klasörü kopyalayın, “LUT listesini güncelle”. Color sayfasında node'a sağ tık &gt; 3D LUT &gt; Rast. LUT'u düzeltme node'undan sonraki node'a koyun.</p>
      </div>
      <div>
        <h3>Final Cut Pro</h3>
        <p>Efektler &gt; Renk &gt; <strong>Özel LUT (Custom LUT)</strong> efektini klibe sürükleyin, Denetçi'de LUT &gt; “Özel LUT Seç…” ile .cube dosyasını gösterin. Mix ile gücünü azaltın.</p>
      </div>
      <div>
        <h3>CapCut (masaüstü)</h3>
        <p>Klibi seçin, <strong>Ayarla (Adjust)</strong> &gt; LUT &gt; İçe aktar ile .cube dosyasını ekleyin; yoğunluğu kaydırıcıyla ayarlayın. Mobil uygulamada .cube desteği sürüme göre değişebilir.</p>
      </div>
    </div>
    <ul class="tips">
      <li><strong>Sıra önemli:</strong> önce pozlama ve beyaz dengesi, sonra LUT. LUT bozuk bir görüntüyü düzeltmez, iyi bir görüntüye karakter verir.</li>
      <li><strong>Log çektiyseniz:</strong> önce kameranızın Rec.709 dönüşümü, sonra Rast LUT'u.</li>
      <li><strong>Tutarlılık:</strong> bir videoda tek LUT seçin ve tüm kliplere aynı yoğunlukta uygulayın; farkı sahneler arası küçük pozlama ayarlarıyla kapatın.</li>
      <li><strong>Dışa aktarma:</strong> renk farkının telefonda da aynı görünmesi için Rec.709 / sRGB ile dışa aktarın.</li>
    </ul>

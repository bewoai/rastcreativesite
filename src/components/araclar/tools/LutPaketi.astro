<script>
  document.querySelectorAll<HTMLElement>(".ba").forEach((fig) => {
    const r = fig.querySelector<HTMLInputElement>("input[type=range]")!;
    const set = () => fig.style.setProperty("--pos", `${r.value}%`);
    r.addEventListener("input", set);
    set();
  });
  // Log camera selector (tabs). Without JS every panel stays visible.
  document.querySelectorAll<HTMLElement>("[data-logsel]").forEach((box) => {
    const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const show = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((b) => {
        const on = b === t;
        b.setAttribute("aria-selected", on ? "true" : "false");
        b.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(b.getAttribute("aria-controls")!);
        panel?.classList.toggle("is-on", on);
        if (on) panel?.querySelectorAll("img").forEach((im) => (im.loading = "eager"));
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => show(t));
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        if (k !== "ArrowRight" && k !== "ArrowLeft") return;
        e.preventDefault();
        show(tabs[(i + (k === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });
    box.classList.add("is-js");
  });
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]");
  copyBtn?.addEventListener("click", async () => {
    const ta = document.querySelector<HTMLTextAreaElement>("[data-cite]")!;
    const out = document.querySelector<HTMLElement>("[data-copied]")!;
    try {
      await navigator.clipboard.writeText(ta.value);
    } catch {
      ta.select();
      document.execCommand("copy");
    }
    out.textContent = copyBtn.dataset.done ?? "Kopyalandı.";
  });
</script>


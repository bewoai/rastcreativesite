---
/**
 * Free video bitrate / file size calculator. 100% client-side math, no file
 * input at all. Reference numbers: src/data/export-specs.ts (official sources,
 * shared with /rehber/video-export-ayarlari/). State syncs to the URL query so
 * a calculation can be shared. Linkable asset — keep it useful, no prices.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EmbedLayout from "../../../layouts/EmbedLayout.astro";
import EmbedBox from "../EmbedBox.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import Button from "../../../components/Button.astro";
import { PRIMARY_CTA, SITE } from "../../../consts";
import { breadcrumb, faqPage } from "../../../lib/schema";
import { YOUTUBE, VIMEO, LIMITS, EXPORT_SOURCES, CHECKED } from "../../../data/export-specs";
import ToolHeader from "../../../components/araclar/ToolHeader.astro";
import MoreTools from "../../../components/araclar/MoreTools.astro";
import ToolFaq from "../../../components/araclar/ToolFaq.astro";

const PATH = "/araclar/bitrate-hesaplayici/";
const PAGE_URL = new URL(PATH, SITE.url).href;
const title = "Video Bitrate ve Dosya Boyutu Hesaplayıcı";
const description =
  "Ücretsiz video bitrate hesaplayıcı: bitrate ve süreden dosya boyutunu, hedef boyuttan (ör. 500 MB, 4 GB) gereken bitrate'i ve kartın kaç dakika kaydedeceğini bulun.";

const fmt = (n: number) => String(n).replace(".", ",");
const range = (r: readonly number[]) => (r[0] === r[1] ? `${fmt(r[0])}` : `${fmt(r[0])}–${fmt(r[1])}`);

const faqs = [
  {
    question: "Video dosya boyutu nasıl hesaplanır?",
    answer:
      "Dosya boyutu (MB) = (video bitrate + ses bitrate, kbps) × süre (saniye) ÷ 8 ÷ 1000. Örneğin 3 dakikalık, 8 Mbps video ve 320 kbps sesli bir dosya yaklaşık (8000 + 320) × 180 ÷ 8000 ≈ 187 MB olur. Değişken bitrate (VBR) ve kapsayıcı (MP4/MOV) payı yüzünden gerçek dosya birkaç yüzde farklı çıkabilir.",
  },
  {
    question: "1080p video için kaç Mbps bitrate gerekir?",
    answer: `YouTube, 1080p SDR yüklemeler için 24/25/30 fps'te ${range(YOUTUBE.sdr["1080"].std)} Mbps, 48/50/60 fps'te ${range(YOUTUBE.sdr["1080"].high)} Mbps önerir; Vimeo 1080p için ${range(VIMEO["1080"])} Mbps aralığını verir. Platform videoyu zaten yeniden sıkıştırdığı için bu değerlerin biraz üstünde bir kaynak dosya yüklemek genelde daha temiz sonuç verir.`,
  },
  {
    question: "4K video için kaç Mbps bitrate gerekir?",
    answer: `YouTube 4K (2160p) SDR yüklemeler için 24/25/30 fps'te ${range(YOUTUBE.sdr["2160"].std)} Mbps, 48/50/60 fps'te ${range(YOUTUBE.sdr["2160"].high)} Mbps; HDR için ${range(YOUTUBE.hdr["2160"].std)} ve ${range(YOUTUBE.hdr["2160"].high)} Mbps önerir. Vimeo 4K için ${range(VIMEO["2160"])} Mbps aralığını verir.`,
  },
  {
    question: "Videoyu 500 MB ya da 4 GB altına nasıl sığdırırım?",
    answer: `“Hedef boyut → bitrate” sekmesinde hedef boyutu ve süreyi girin; araç ses bitrate'ini çıkarıp yüzde 2 güvenlik payı bırakarak kullanabileceğiniz en yüksek video bitrate'ini verir. TikTok reklamlarında (Spark olmayan) sınır ${LIMITS.tiktokAdMaxMB} MB, Meta'da (Instagram ve Facebook reklam videoları) ${LIMITS.metaMaxGB} GB'tır.`,
  },
  {
    question: "Hesaplanan boyut ile bilgisayarımın gösterdiği boyut neden farklı?",
    answer:
      "Araç 1 MB = 1.000.000 bayt kullanır (platformlar ve kart üreticileri gibi). Windows Gezgini 1 GB'ı 1.073.741.824 bayt sayar, bu yüzden aynı dosya Windows'ta yaklaşık yüzde 7 daha küçük görünür. Sonuçta ikisini de gösteriyoruz.",
  },
  {
    question: "Girdiğim değerler bir sunucuya gönderiliyor mu?",
    answer:
      "Hayır. Araç dosya istemez, tüm hesap tarayıcınızda yapılır. Değerler yalnızca paylaşabilmeniz için adres çubuğundaki bağlantıya yazılır; sayfada üçüncü taraf takip kodu yoktur.",
  },
];

const citeHtml = `<a href="${PAGE_URL}">Video bitrate hesaplayıcı — Rast Creative</a>`;

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
    { name: "Bitrate hesaplayıcı", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Video Bitrate ve Dosya Boyutu Hesaplayıcı",
    alternateName: "Video bitrate calculator",
    url: PAGE_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "Modern bir web tarayıcısı; JavaScript gerekli",
    isAccessibleForFree: true,
    inLanguage: "tr",
    offers: { "@type": "Offer", price: "0", priceCurrency: "TRY" },
    description,
    featureList: [
      "Bitrate ve süreden dosya boyutu",
      "Hedef dosya boyutundan gereken video bitrate'i",
      "Kart ya da diskin kaç dakika kayıt alacağı",
      "YouTube, Vimeo ve Apple ProRes referans değerleri",
      "Hesaba göre FFmpeg komutu",
      "Paylaşılabilir hesap bağlantısı",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
  },
  faqPage(faqs),
];

const ytRows = (["2160", "1440", "1080", "720"] as const).map((r) => ({
  res: r === "2160" ? "2160p (4K)" : r === "1440" ? "1440p" : `${r}p`,
  sdrStd: range(YOUTUBE.sdr[r].std),
  sdrHigh: range(YOUTUBE.sdr[r].high),
  hdrStd: range(YOUTUBE.hdr[r].std),
  hdrHigh: range(YOUTUBE.hdr[r].high),
  vimeo: range(VIMEO[r]),
}));

// ---------- English twin (/en/tools/video-bitrate-calculator/, src/lib/i18n.ts) ----------
interface Props {
  lang?: "tr" | "en";
  /** /embed/ widget (src/pages/embed/): tool only, minimal chrome, see src/layouts/EmbedLayout.astro. */
  embed?: boolean;
}
const { lang = "tr", embed = false } = Astro.props;
const Layout = embed ? EmbedLayout : BaseLayout;
const en = lang === "en";
const t = (tr: string, eng: string) => (en ? eng : tr);
const EN_PATH = "/en/tools/video-bitrate-calculator/";
const EN_URL = new URL(EN_PATH, SITE.url).href;
const rangeEn = (r: readonly number[]) => (r[0] === r[1] ? `${r[0]}` : `${r[0]}–${r[1]}`);
const enTitle = "Video Bitrate Calculator & File Size Calculator";
const enDescription =
  "Free video bitrate calculator: get file size from bitrate and duration, the bitrate needed to hit a target size (e.g. 500 MB, 4 GB) and how long a card records.";
const enFaqs = [
  {
    question: "How do you calculate video file size from bitrate?",
    answer:
      "File size (MB) = (video bitrate + audio bitrate, in kbps) × duration (seconds) ÷ 8 ÷ 1000. For example, a 3-minute video at 8 Mbps with 320 kbps audio is about (8000 + 320) × 180 ÷ 8000 ≈ 187 MB. Variable bitrate (VBR) and container overhead (MP4/MOV) can make the real file a few percent different.",
  },
  {
    question: "What bitrate do I need for 1080p video?",
    answer: `YouTube recommends ${rangeEn(YOUTUBE.sdr["1080"].std)} Mbps for 1080p SDR uploads at 24/25/30 fps and ${rangeEn(YOUTUBE.sdr["1080"].high)} Mbps at 48/50/60 fps; Vimeo gives ${rangeEn(VIMEO["1080"])} Mbps for 1080p. Because platforms re-compress your upload anyway, a source file slightly above these values usually looks cleaner.`,
  },
  {
    question: "What bitrate do I need for 4K video?",
    answer: `For 4K (2160p) SDR uploads, YouTube recommends ${rangeEn(YOUTUBE.sdr["2160"].std)} Mbps at 24/25/30 fps and ${rangeEn(YOUTUBE.sdr["2160"].high)} Mbps at 48/50/60 fps; for HDR ${rangeEn(YOUTUBE.hdr["2160"].std)} and ${rangeEn(YOUTUBE.hdr["2160"].high)} Mbps. Vimeo gives ${rangeEn(VIMEO["2160"])} Mbps for 4K.`,
  },
  {
    question: "How do I get a video under 500 MB or 4 GB?",
    answer: `Use the “Target size → bitrate” mode: enter the target size and the duration. The calculator subtracts the audio bitrate, keeps a 2% safety margin and gives you the highest video bitrate you can use. The limit for (non-Spark) TikTok ads is ${LIMITS.tiktokAdMaxMB} MB; for Meta ad videos (Instagram and Facebook) it is ${LIMITS.metaMaxGB} GB.`,
  },
  {
    question: "Why is the calculated size different from what my computer shows?",
    answer:
      "The calculator uses 1 MB = 1,000,000 bytes, like platforms and card makers do. Windows File Explorer counts 1 GB as 1,073,741,824 bytes, so the same file looks about 7% smaller in Windows. The result shows both.",
  },
  {
    question: "Are the values I enter sent to a server?",
    answer:
      "No. The calculator doesn't ask for a file and all the math runs in your browser. Values are only written to the address bar so you can share the calculation; the tool has no third-party tracking.",
  },
];
const enCiteHtml = `<a href="${EN_URL}">Video bitrate calculator — Rast Creative</a>`;
const enJsonLd = [
  breadcrumb([
    { name: "Rast Creative", path: "/" },
    { name: "Free tools", path: "/en/tools/" },
    { name: "Video bitrate calculator", path: EN_PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Video Bitrate and File Size Calculator",
    alternateName: ["Video file size calculator", "Bitrate calculator"],
    url: EN_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "A modern web browser with JavaScript",
    isAccessibleForFree: true,
    inLanguage: "en",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description: enDescription,
    featureList: [
      "File size from bitrate and duration",
      "Video bitrate needed for a target file size",
      "Recording time for a memory card or drive",
      "YouTube, Vimeo and Apple ProRes reference bitrates",
      "FFmpeg two-pass command for the result",
      "Shareable calculation link",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
    dateModified: "2026-10-31",
  },
  faqPage(enFaqs),
];
const ytRowsEn = (["2160", "1440", "1080", "720"] as const).map((r) => ({
  res: r === "2160" ? "2160p (4K)" : r === "1440" ? "1440p" : `${r}p`,
  sdrStd: rangeEn(YOUTUBE.sdr[r].std),
  sdrHigh: rangeEn(YOUTUBE.sdr[r].high),
  hdrStd: rangeEn(YOUTUBE.hdr[r].std),
  hdrHigh: rangeEn(YOUTUBE.hdr[r].high),
  vimeo: rangeEn(VIMEO[r]),
}));
const EN_SOURCES = [
  { text: "YouTube Help, “YouTube recommended upload encoding settings”: MP4 with the moov atom at the front (Fast Start), AAC-LC 48 kHz, H.264 High Profile, 2 consecutive B-frames, closed GOP (half the frame rate), CABAC, variable bitrate, 4:2:0, BT.709; SDR/HDR bitrate tables.", url: EXPORT_SOURCES[0].url, host: EXPORT_SOURCES[0].host },
  { text: "Vimeo Help Center, “Video and audio compression guidelines” (updated 12 Dec 2025): H.264 High Profile, ProRes 422 HQ or H.265; constant frame rate; 1080p 10–20 Mbps, 4K 30–60 Mbps; AAC-LC 320 kb/s, 48 kHz.", url: EXPORT_SOURCES[1].url, host: EXPORT_SOURCES[1].host },
  { text: "Meta Ads Guide, Instagram Reels video ads: MP4/MOV, H.264, square pixels, constant frame rate, progressive scan, stereo AAC 128 kbps+, max 4 GB, 1440×2560 recommended.", url: EXPORT_SOURCES[2].url, host: EXPORT_SOURCES[2].host },
  { text: "Instagram Help Center, “Reel size & aspect ratios”: ratio between 1.91:1 and 9:16, at least 30 FPS and 720 pixels; the “Upload at highest quality” setting.", url: EXPORT_SOURCES[3].url, host: EXPORT_SOURCES[3].host },
  { text: "TikTok Ads Manager, “TikTok Auction In-Feed Ads” (non-Spark ads): vertical 9:16 at least 540×960, .mp4/.mov, max 500 MB, bitrate at least 516 kbps.", url: EXPORT_SOURCES[4].url, host: EXPORT_SOURCES[4].host },
  { text: "Apple ProRes White Paper (April 2022), “Target Data Rates” appendix: e.g. 1920×1080 30p ProRes 422 HQ ≈ 220 Mbps, 3840×2160 25p ≈ 737 Mbps.", url: EXPORT_SOURCES[5].url, host: EXPORT_SOURCES[5].host },
];
---

<Layout title={en ? enTitle : title} description={en ? enDescription : description} jsonLd={embed ? undefined : en ? enJsonLd : jsonLd} full={en ? EN_PATH : PATH}>
  <Section width="wide" space="tight">
{!embed && (
    <ToolHeader
      href={en ? EN_PATH : "/araclar/bitrate-hesaplayici/"}
      h1={en ? "Video bitrate calculator and file size calculator" : "Video bitrate ve dosya boyutu hesaplayıcı"}
    >
      {en ? (
        <p>
          File size (MB) = (video + audio bitrate in Mbps) × seconds ÷ 8. Use it to see how big an export will be, how far
          to drop the bitrate to fit an upload limit, or how many minutes your card records. YouTube, Vimeo and Apple ProRes
          values come from the official docs. <strong>Nothing is uploaded</strong>; the math runs in your browser.
        </p>
      ) : (
        <p>
          Dışa aktarmadan önce dosyanın kaç MB tutacağını, bir platformun boyut sınırına sığmak için bitrate'i ne kadar
          düşürmeniz gerektiğini ya da kartınızın kaç dakika kayıt alacağını hesaplayın. YouTube, Vimeo ve Apple ProRes
          değerleri resmî kaynaklardan alınmıştır. <strong>Dosya yüklemezsiniz</strong>; hesap tarayıcınızda yapılır.
        </p>
      )}
      
    </ToolHeader>
)}

    <form id="arac" class="tool" data-calc onsubmit="return false" novalidate>
      <fieldset class="modes">
        <legend>{t("Ne hesaplamak istiyorsunuz?", "What do you want to calculate?")}</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="mode" value="size" checked /><span>{t("Bitrate → dosya boyutu", "Bitrate → file size")}</span></label>
          <label class="chip"><input type="radio" name="mode" value="bitrate" /><span>{t("Hedef boyut → bitrate", "Target size → bitrate")}</span></label>
          <label class="chip"><input type="radio" name="mode" value="card" /><span>{t("Kart kaç dakika kaydeder?", "Card recording time")}</span></label>
        </div>
      </fieldset>

      <div class="grid">
        <div class="col">
          <fieldset data-show="size bitrate">
            <legend>{t("Video süresi", "Video duration")}</legend>
            <div class="dur">
              <label>{t("Saat", "Hours")} <input type="number" inputmode="numeric" min="0" max="99" step="1" value="0" data-in="h" /></label>
              <label>{t("Dakika", "Minutes")} <input type="number" inputmode="numeric" min="0" max="59" step="1" value="3" data-in="m" /></label>
              <label>{t("Saniye", "Seconds")} <input type="number" inputmode="numeric" min="0" max="59" step="1" value="0" data-in="s" /></label>
            </div>
          </fieldset>

          <fieldset data-show="bitrate">
            <legend>{t("Hedef dosya boyutu", "Target file size")}</legend>
            <div class="row">
              <input type="number" inputmode="decimal" min="0" step="any" value="500" data-in="target" aria-label={t("Hedef boyut", "Target size")} />
              <select data-in="targetUnit" aria-label={t("Birim", "Unit")}>
                <option value="MB" selected>MB</option>
                <option value="GB">GB</option>
              </select>
            </div>
            <div class="quick">
              <span class="small">{t("Hızlı seç:", "Quick pick:")}</span>
              <button type="button" class="mini" data-target="500" data-unit="MB">{t("500 MB (TikTok reklam)", "500 MB (TikTok ads)")}</button>
              <button type="button" class="mini" data-target="4" data-unit="GB">4 GB (Meta)</button>
              <button type="button" class="mini" data-target="25" data-unit="MB">25 MB</button>
            </div>
          </fieldset>

          <fieldset data-show="card">
            <legend>{t("Kart / disk kapasitesi", "Card / drive capacity")}</legend>
            <div class="row">
              <input type="number" inputmode="decimal" min="0" step="any" value="128" data-in="cap" aria-label={t("Kapasite", "Capacity")} />
              <select data-in="capUnit" aria-label={t("Birim", "Unit")}>
                <option value="GB" selected>GB</option>
                <option value="TB">TB</option>
              </select>
            </div>
            <p class="small">{t("Kartın üzerinde yazan değeri girin. Biçimlendirme sonrası kullanılabilir alan birkaç yüzde daha azdır.", "Enter the capacity printed on the card. Usable space after formatting is a few percent lower.")}</p>
          </fieldset>

          <fieldset data-show="size card">
            <legend>Video bitrate</legend>
            <div class="row">
              <input type="number" inputmode="decimal" min="0" step="any" value="16" data-in="vbr" aria-label="Video bitrate" />
              <span class="unit">Mbps</span>
            </div>
          </fieldset>

          <fieldset data-show="size bitrate card">
            <legend>{t("Ses bitrate", "Audio bitrate")}</legend>
            <select data-in="abr" aria-label={t("Ses bitrate", "Audio bitrate")}>
              <option value="0">{t("Ses yok", "No audio")}</option>
              <option value="128">{t("128 kbps (Meta alt sınırı)", "128 kbps (Meta minimum)")}</option>
              <option value="192">192 kbps</option>
              <option value="256">256 kbps</option>
              <option value="320" selected>{t("320 kbps (Vimeo önerisi)", "320 kbps (Vimeo recommendation)")}</option>
              <option value="384">{t("384 kbps (YouTube stereo önerisi)", "384 kbps (YouTube stereo recommendation)")}</option>
              <option value="512">{t("512 kbps (YouTube 5.1 önerisi)", "512 kbps (YouTube 5.1 recommendation)")}</option>
              <option value="1536">1536 kbps (PCM 48 kHz 16-bit stereo)</option>
              <option value="2304">2304 kbps (PCM 48 kHz 24-bit stereo)</option>
            </select>
          </fieldset>
        </div>

        <div class="col">
          <fieldset class="ref" data-show="size card bitrate">
            <legend>{t("Referans değer bul", "Look up a reference bitrate")}</legend>
            <div class="refgrid">
              <label>Platform / codec
                <select data-in="plat">
                  <option value="yt-sdr" selected>YouTube (SDR)</option>
                  <option value="yt-hdr">YouTube (HDR)</option>
                  <option value="vimeo">Vimeo</option>
                  <option value="pr-proxy">ProRes 422 Proxy</option>
                  <option value="pr-lt">ProRes 422 LT</option>
                  <option value="pr-422">ProRes 422</option>
                  <option value="pr-hq">ProRes 422 HQ</option>
                  <option value="pr-4444">ProRes 4444</option>
                  <option value="pr-xq">ProRes 4444 XQ</option>
                </select>
              </label>
              <label>{t("Çözünürlük", "Resolution")}
                <select data-in="res">
                  <option value="3840x2160">4K UHD (3840×2160)</option>
                  <option value="4096x2160">DCI 4K (4096×2160)</option>
                  <option value="2560x1440">1440p (2560×1440)</option>
                  <option value="1920x1080" selected>1080p (1920×1080 / 1080×1920)</option>
                  <option value="1280x720">720p (1280×720)</option>
                </select>
              </label>
              <label>{t("Kare hızı", "Frame rate")}
                <select data-in="fps">
                  <option value="24">{t("23,976 / 24 fps", "23.976 / 24 fps")}</option>
                  <option value="25" selected>25 fps</option>
                  <option value="30">{t("29,97 / 30 fps", "29.97 / 30 fps")}</option>
                  <option value="50">50 fps</option>
                  <option value="60">{t("59,94 / 60 fps", "59.94 / 60 fps")}</option>
                </select>
              </label>
            </div>
            <p class="refout" data-ref aria-live="polite"></p>
            <button type="button" class="ev-btn" data-use>{t("Bu değeri video bitrate'e yaz", "Use this as the video bitrate")}</button>
          </fieldset>
        </div>
      </div>

      <div class="result" aria-live="polite">
        <p class="big" data-big></p>
        <ul class="details" data-details></ul>
        <p class="warn" data-warn hidden></p>
      </div>

      <details class="ff" data-ffwrap>
        <summary>{t("Bu hesapla FFmpeg komutu (H.264, iki geçiş)", "FFmpeg command for this result (H.264, two-pass)")}</summary>
        {en ? (
          <p class="small">
            For when you don't have an editor at hand or want to re-compress a file. Replace <code>input.mov</code> with your
            file name. On Windows, use <code>NUL</code> instead of <code>/dev/null</code> in the first line.
          </p>
        ) : (
        <p class="small">
          Kurgu programınız yoksa ya da bir dosyayı yeniden sıkıştırmak istiyorsanız. <code>girdi.mov</code> yerine kendi dosyanızın
          adını yazın. Windows'ta ilk satırdaki <code>/dev/null</code> yerine <code>NUL</code> kullanın.
        </p>
        )}
        <textarea readonly rows="5" data-ff aria-label={t("FFmpeg komutu", "FFmpeg command")}></textarea>
        <button type="button" class="ev-btn" data-copy-ff>{t("Komutu kopyala", "Copy command")}</button>
      </details>

      <div class="actions">
        <button type="button" class="ev-btn ev-btn--sun" data-share>{t("Hesabın bağlantısını kopyala", "Copy link to this calculation")}</button>
        <button type="button" class="ev-btn" data-copy-result>{t("Sonucu metin olarak kopyala", "Copy result as text")}</button>
        <span class="small" data-copied aria-live="polite"></span>
      </div>
      <noscript><p class="warn">{t("Hesaplayıcı için JavaScript gerekli. Aşağıdaki tablolar ve formül JavaScript olmadan da kullanılabilir.", "The calculator needs JavaScript. The tables and formula below work without it.")}</p></noscript>
    </form>
    {
  embed ? null : en ? (
    <Fragment>
    <ol class="at-steps" aria-label="How to use">
      <li><strong>Pick what to calculate.</strong> File size, the bitrate for a target size, or card recording time.</li>
      <li><strong>Enter your values.</strong> Don't know the bitrate? Pick a platform and resolution and fill in the recommended value with one click.</li>
      <li><strong>Use the result.</strong> Type it into your editor's export settings, copy the FFmpeg command or share a link to the calculation.</li>
    </ol>
    </Fragment>
  ) : (
    <Fragment>
<ol class="at-steps" aria-label="Nasıl kullanılır">
      <li><strong>Ne hesaplayacağınızı seçin.</strong> Dosya boyutu, hedef boyuta göre bitrate ya da kart kayıt süresi.</li>
      <li><strong>Değerleri girin.</strong> Bitrate'i bilmiyorsanız platform ve çözünürlük seçip önerilen değeri tek tıkla doldurun.</li>
      <li><strong>Sonucu kullanın.</strong> Değeri kurgu programınıza yazın, FFmpeg komutunu kopyalayın ya da hesabın bağlantısını paylaşın.</li>
    </ol>
    </Fragment>
  )
}
  </Section>

  {!embed && (
  <Fragment>
  <EmbedBox href={en ? EN_PATH : PATH} />


  {
  en ? (
    <Fragment>
  <Section width="default" space="tight" id="formul">
    <SectionHeading eyebrow="Formula">How to calculate video file size from bitrate</SectionHeading>
    <div class="prose">
      <p>
        Bitrate is the amount of data a video uses per second. It's written in Mbps (megabits per second), while file size is
        measured in megabytes (MB), and 1 byte = 8 bits. So:
      </p>
      <p class="formula">File size (MB) = (video Mbps + audio Mbps) × duration (s) ÷ 8</p>
      <p class="formula">Required video bitrate (Mbps) = target size (MB) × 8 ÷ duration (s) − audio Mbps</p>
      <p>
        Example: a 60-second 1080×1920 Reel exported at 16 Mbps video and 320 kbps (0.32 Mbps) audio comes to
        (16 + 0.32) × 60 ÷ 8 ≈ <strong>122 MB</strong>. To fit the same clip into 25 MB you'd need 25 × 8 ÷ 60 − 0.32 ≈
        <strong>3 Mbps</strong> of video; that's low for 1080p, and the quality drop will be visible.
      </p>
      <p class="small">
        With variable bitrate (VBR) encoding the encoder aims for the average, and the container (MP4/MOV) adds a little
        overhead. That's why the target-size mode keeps a 2% safety margin.
      </p>
    </div>
  </Section>
    </Fragment>
  ) : (
    <Fragment>
<Section width="default" space="tight" id="formul">
    <SectionHeading eyebrow="Formül">Bitrate ile dosya boyutu nasıl hesaplanır?</SectionHeading>
    <div class="prose">
      <p>
        Bitrate, videonun saniyede kullandığı veri miktarıdır. Mbps (megabit/saniye) olarak yazılır; dosya boyutu ise
        megabayt (MB) ile ölçülür ve 1 bayt = 8 bit'tir. Bu yüzden:
      </p>
      <p class="formula">Dosya boyutu (MB) = (video Mbps + ses Mbps) × süre (sn) ÷ 8</p>
      <p class="formula">Gereken video bitrate (Mbps) = hedef boyut (MB) × 8 ÷ süre (sn) − ses Mbps</p>
      <p>
        Örnek: 60 saniyelik bir Reels'i 1080×1920, 16 Mbps video ve 320 kbps (0,32 Mbps) sesle dışa aktarırsanız
        (16 + 0,32) × 60 ÷ 8 ≈ <strong>122 MB</strong> tutar. Aynı süreyi 25 MB'a sığdırmak için 25 × 8 ÷ 60 − 0,32 ≈
        <strong>3 Mbps</strong> video bitrate'e inmeniz gerekir; 1080p için bu düşük bir değerdir, kalite gözle görülür düşer.
      </p>
      <p class="small">
        Değişken bitrate (VBR) kodlamada program ortalamayı tutturmaya çalışır; kapsayıcı (MP4/MOV) da küçük bir pay ekler.
        Hedef boyut hesabında bu yüzden yüzde 2 güvenlik payı bırakıyoruz.
      </p>
    </div>
  </Section>
    </Fragment>
  )
}


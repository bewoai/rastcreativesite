<script>
  import { YOUTUBE, VIMEO, PRORES, PRORES_CODECS, LIMITS } from "../../../data/export-specs";

  // Page language (BaseLayout sets <html lang="en"> on /en/ twins): same logic, two languages.
  const EN = document.documentElement.lang === "en";
  const L = (tr: string, en: string) => (EN ? en : tr);

  const form = document.querySelector<HTMLFormElement>("[data-calc]");
  if (form) init(form);

  function init(root: HTMLFormElement) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const inp = (k: string) => $<HTMLInputElement>(`[data-in="${k}"]`);
    const nf = (d = 1) => new Intl.NumberFormat(EN ? "en-US" : "tr-TR", { maximumFractionDigits: d, minimumFractionDigits: 0 });
    const n = (k: string) => {
      const v = parseFloat(String(inp(k).value).replace(",", "."));
      return Number.isFinite(v) && v >= 0 ? v : 0;
    };
    const big = $("[data-big]");
    const details = $("[data-details]");
    const warn = $("[data-warn]");
    const refOut = $("[data-ref]");
    const ff = $<HTMLTextAreaElement>("[data-ff]");
    const ffWrap = $<HTMLDetailsElement>("[data-ffwrap]");
    const copied = $("[data-copied]");
    let refValue = 0;
    let lastText = "";

    const mode = () => (root.querySelector<HTMLInputElement>('input[name="mode"]:checked')?.value ?? "size") as "size" | "bitrate" | "card";
    const seconds = () => n("h") * 3600 + n("m") * 60 + n("s");

    function sizeLine(bytes: number) {
      const mb = bytes / 1e6;
      const main = mb >= 1000 ? `${nf(2).format(mb / 1000)} GB` : `${nf(1).format(mb)} MB`;
      const gib = bytes / 1024 ** 3;
      const win = gib >= 1 ? `${nf(2).format(gib)} GB` : `${nf(1).format(bytes / 1024 ** 2)} MB`;
      return { main, win };
    }
    const dur = (s: number) => {
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = Math.round(s % 60);
      return [h ? `${h} ${L("sa", "h")}` : "", m ? `${m} ${L("dk", "min")}` : "", !h && sec ? `${sec} ${L("sn", "s")}` : ""].filter(Boolean).join(" ") || L("0 sn", "0 s");
    };

    // ---------- reference lookup ----------
    function reference() {
      const plat = inp("plat").value;
      const res = inp("res").value;
      const fps = inp("fps").value;
      const high = Number(fps) >= 48;
      const key = res === "4096x2160" || res === "3840x2160" ? "2160" : res.split("x")[1];
      let text = "";
      refValue = 0;
      if (plat.startsWith("yt-")) {
        const t = plat === "yt-hdr" ? YOUTUBE.hdr : YOUTUBE.sdr;
        const r = (t as Record<string, { std: readonly number[]; high: readonly number[] }>)[key]?.[high ? "high" : "std"];
        if (r) {
          refValue = r[1];
          const v = r[0] === r[1] ? nf().format(r[0]) : `${nf().format(r[0])}–${nf().format(r[1])}`;
          text = L(`YouTube ${plat === "yt-hdr" ? "HDR" : "SDR"} önerisi: ${v} Mbps (${high ? "48/50/60" : "24/25/30"} fps).`, `YouTube ${plat === "yt-hdr" ? "HDR" : "SDR"} recommendation: ${v} Mbps (${high ? "48/50/60" : "24/25/30"} fps).`);
        }
      } else if (plat === "vimeo") {
        const r = (VIMEO as Record<string, readonly number[] | number>)[key] as readonly number[] | undefined;
        if (r) {
          refValue = r[1];
          text = L(`Vimeo önerisi: ${r[0]}–${r[1]} Mbps (kare hızından bağımsız). Üst değeri dolduruyoruz.`, `Vimeo recommendation: ${r[0]}–${r[1]} Mbps (any frame rate). We fill in the upper value.`);
        }
      } else if (plat.startsWith("pr-")) {
        const codec = plat.slice(3) as (typeof PRORES_CODECS)[number];
        const idx = PRORES_CODECS.indexOf(codec);
        const row = PRORES[res]?.[fps];
        if (row) {
          refValue = row[idx];
          text = L(`Apple'ın hedef değeri: yaklaşık ${nf(0).format(row[idx])} Mbps. ProRes .mov olarak dışa aktarılır; boyut içerikle çok az değişir.`, `Apple's target data rate: about ${nf(0).format(row[idx])} Mbps. ProRes exports as .mov; size barely changes with content.`);
        } else text = L("Apple bu çözünürlük için tablo vermiyor (ProRes için 720p, 1080p, UHD ve DCI 4K seçin).", "Apple doesn't list this resolution (for ProRes pick 720p, 1080p, UHD or DCI 4K).");
      }
      if (!text) text = L("Bu kombinasyon için kaynakta değer yok.", "The sources give no value for this combination.");
      refOut.textContent = text;
      $<HTMLButtonElement>("[data-use]").disabled = !refValue;
      if (refValue) $<HTMLButtonElement>("[data-use]").textContent = L(`${nf().format(refValue)} Mbps'yi video bitrate'e yaz`, `Use ${nf().format(refValue)} Mbps as the video bitrate`);
    }

    function ytFor() {
      const res = inp("res").value;
      const key = res === "4096x2160" || res === "3840x2160" ? "2160" : res.split("x")[1];
      const r = (YOUTUBE.sdr as Record<string, { std: readonly number[]; high: readonly number[] }>)[key];
      return r ? r[Number(inp("fps").value) >= 48 ? "high" : "std"] : null;
    }

    // ---------- main calc ----------
    function calc() {
      const m = mode();
      root.querySelectorAll<HTMLElement>("[data-show]").forEach((el) => {
        el.hidden = !el.dataset.show!.split(" ").includes(m);
      });
      const abrK = n("abr") || Number(inp("abr").value);
      const secs = seconds();
      const items: string[] = [];
      const warns: string[] = [];
      let videoKbps = 0;

      if (m === "size") {
        const vK = n("vbr") * 1000;
        videoKbps = vK;
        if (!secs || !vK) {
          big.textContent = L("Süre ve video bitrate girin.", "Enter a duration and a video bitrate.");
        } else {
          const bytes = ((vK + abrK) * 1000 * secs) / 8;
          const s = sizeLine(bytes);
          big.innerHTML = L(`Tahmini dosya boyutu: <strong>${s.main}</strong>`, `Estimated file size: <strong>${s.main}</strong>`);
          items.push(L(`Windows Gezgini'nde yaklaşık ${s.win} görünür.`, `Shows as about ${s.win} in Windows File Explorer.`));
          items.push(L(`Dakika başına ≈ ${nf(1).format(((vK + abrK) * 60) / 8000)} MB · toplam bitrate ${nf(2).format((vK + abrK) / 1000)} Mbps · süre ${dur(secs)}.`, `≈ ${nf(1).format(((vK + abrK) * 60) / 8000)} MB per minute · total bitrate ${nf(2).format((vK + abrK) / 1000)} Mbps · duration ${dur(secs)}.`));
          if (bytes > LIMITS.metaMaxGB * 1e9) warns.push(L(`Bu dosya Meta'nın ${LIMITS.metaMaxGB} GB reklam videosu sınırını aşıyor.`, `This file is over Meta's ${LIMITS.metaMaxGB} GB ad video limit.`));
          else if (bytes > LIMITS.tiktokAdMaxMB * 1e6) items.push(L(`TikTok reklam sınırı (${LIMITS.tiktokAdMaxMB} MB) için fazla; Meta'nın ${LIMITS.metaMaxGB} GB sınırının altında.`, `Too big for TikTok ads (${LIMITS.tiktokAdMaxMB} MB limit); under Meta's ${LIMITS.metaMaxGB} GB limit.`));
        }
      } else if (m === "bitrate") {
        const tgt = n("target") * (inp("targetUnit").value === "GB" ? 1e9 : 1e6);
        if (!secs || !tgt) {
          big.textContent = L("Hedef boyut ve süre girin.", "Enter a target size and a duration.");
        } else {
          const totalK = (tgt * 0.98 * 8) / secs / 1000;
          const vK = Math.floor(totalK - abrK);
          videoKbps = vK;
          if (vK <= 0) {
            big.textContent = L("Bu süre için hedef boyut ses verisine bile yetmiyor.", "For this duration the target size doesn't even fit the audio.");
            warns.push(L("Süreyi kısaltın, sesi düşürün ya da hedef boyutu büyütün.", "Shorten the video, lower the audio bitrate or raise the target size."));
          } else {
            big.innerHTML = `${L("En fazla video bitrate", "Max video bitrate")}: <strong>${nf(1).format(vK / 1000)} Mbps</strong> <span class="small">(${nf(0).format(vK)} kbps)</span>`;
            items.push(L(`Toplam ${nf(2).format(totalK / 1000)} Mbps; ${nf(0).format(abrK)} kbps ses ve %2 güvenlik payı düşüldü · süre ${dur(secs)}.`, `${nf(2).format(totalK / 1000)} Mbps total, minus ${nf(0).format(abrK)} kbps audio and a 2% safety margin · duration ${dur(secs)}.`));
            items.push(L("Kurgu programında “VBR, 2 geçiş” seçip hedef bitrate'e bu değeri yazın; maksimum bitrate'i hedefin en fazla 1,5 katı tutun.", "In your editor choose “VBR, 2 pass” and enter this as the target bitrate; keep the maximum bitrate at no more than 1.5× the target."));
            const yt = ytFor();
            if (yt) {
              const ratio = vK / 1000 / yt[0];
              items.push(L(`Seçili çözünürlük ve kare hızı için YouTube önerisi ${nf().format(yt[0])} Mbps; bu değer onun yaklaşık ${nf(ratio < 1 ? 2 : 1).format(ratio)} katı.`, `YouTube recommends ${nf().format(yt[0])} Mbps for the selected resolution and frame rate; this is about ${nf(ratio < 1 ? 2 : 1).format(ratio)}× that.`));
              if (ratio > 3) items.push(L("Hedef boyut bu süre için bol: bu kadar yükseğe çıkmanız gerekmez, önerilen bitrate'in biraz üstü yeterli.", "Plenty of room for this duration: you don't need to go this high, a little above the recommended bitrate is enough."));
              if (ratio < 0.6) warns.push(L("Bu bitrate seçili çözünürlük için düşük; blok ve bantlaşma görülebilir. Çözünürlüğü düşürmeyi (ör. 1080p → 720p) ya da videoyu kısaltmayı düşünün.", "This bitrate is low for the selected resolution; expect blocking and banding. Consider a lower resolution (e.g. 1080p → 720p) or a shorter video."));
            }
            if (vK < LIMITS.tiktokAdMinKbps) warns.push(L(`TikTok reklamları en az ${LIMITS.tiktokAdMinKbps} kbps ister; bu değerin altındasınız.`, `TikTok ads need at least ${LIMITS.tiktokAdMinKbps} kbps; you're below that.`));
          }
        }
      } else {
        const cap = n("cap") * (inp("capUnit").value === "TB" ? 1e12 : 1e9);
        const vK = n("vbr") * 1000;
        videoKbps = vK;
        if (!cap || !vK) {
          big.textContent = L("Kapasite ve video bitrate girin.", "Enter a capacity and a video bitrate.");
        } else {
          const s = (cap * 8) / ((vK + abrK) * 1000);
          big.innerHTML = L(`Yaklaşık kayıt süresi: <strong>${dur(s)}</strong>`, `Approximate recording time: <strong>${dur(s)}</strong>`);
          items.push(L(`Biçimlendirme payıyla gerçekte biraz daha az (kabaca ${dur(s * 0.95)}).`, `A little less in practice after formatting (roughly ${dur(s * 0.95)}).`));
          items.push(L(`Toplam ${nf(1).format((vK + abrK) / 1000)} Mbps ile saatte ≈ ${nf(0).format(((vK + abrK) * 3600) / 8e6)} GB yazılır.`, `At ${nf(1).format((vK + abrK) / 1000)} Mbps total, about ${nf(0).format(((vK + abrK) * 3600) / 8e6)} GB is written per hour.`));
          items.push(L("Kameranın gerçek bitrate'i için kayıt menüsündeki değere bakın (ör. “150 Mbps”, “ALL-I”).", "Check your camera's recording menu for its real bitrate (e.g. “150 Mbps”, “ALL-I”)."));
        }
      }

      details.innerHTML = items.map((t) => `<li>${t}</li>`).join("");
      warn.hidden = !warns.length;
      warn.textContent = warns.join(" ");

      // ffmpeg (only for delivery modes with a valid bitrate)
      ffWrap.hidden = m === "card" || videoKbps <= 0;
      if (!ffWrap.hidden) {
        const fpsN = Number(inp("fps").value);
        const g = Math.max(1, Math.round(fpsN / 2));
        const common = `-c:v libx264 -preset slow -profile:v high -pix_fmt yuv420p -b:v ${Math.round(videoKbps)}k -g ${g} -bf 2`;
        const audio = abrK ? `-c:a aac -b:a ${Math.min(abrK, 512)}k -ar 48000` : "-an";
        ff.value =
          `ffmpeg -y -i ${L("girdi.mov", "input.mov")} ${common} -pass 1 -an -f null /dev/null\n` +
          `ffmpeg -i ${L("girdi.mov", "input.mov")} ${common} -pass 2 ${audio} -movflags +faststart ${L("cikti.mp4", "output.mp4")}`;
      }

      lastText = [big.textContent, ...items, ...warns].join("\n") + `\n— ${L("Hesap", "Calculated with")}: Rast Creative Studio · ${location.origin}${location.pathname}`;
      syncUrl();
    }

    // ---------- URL state ----------
    const KEYS = ["h", "m", "s", "target", "targetUnit", "cap", "capUnit", "vbr", "abr", "plat", "res", "fps"];
    function syncUrl() {
      const p = new URLSearchParams();
      p.set("mod", mode());
      KEYS.forEach((k) => p.set(k, inp(k).value));
      history.replaceState(null, "", `${location.pathname}?${p.toString()}${location.hash}`);
    }
    function readUrl() {
      const p = new URLSearchParams(location.search);
      const md = p.get("mod");
      if (md) {
        const r = root.querySelector<HTMLInputElement>(`input[name="mode"][value="${CSS.escape(md)}"]`);
        if (r) r.checked = true;
      }
      KEYS.forEach((k) => {
        const v = p.get(k);
        if (v === null) return;
        const el = inp(k);
        if (el instanceof HTMLSelectElement) {
          if ([...el.options].some((o) => o.value === v)) el.value = v;
        } else if (/^\d+([.,]\d+)?$/.test(v)) el.value = v.replace(",", ".");
      });
    }

    async function copy(text: string, out: HTMLElement, msg = L("Kopyalandı.", "Copied.")) {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.append(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      out.textContent = msg;
      setTimeout(() => (out.textContent = ""), 2500);
    }

    root.addEventListener("input", () => {
      reference();
      calc();
    });
    root.addEventListener("change", () => {
      reference();
      calc();
    });
    $("[data-use]").addEventListener("click", () => {
      if (!refValue) return;
      inp("vbr").value = String(refValue);
      if (mode() === "bitrate") (root.querySelector<HTMLInputElement>('input[name="mode"][value="size"]')!).checked = true;
      calc();
    });
    root.querySelectorAll<HTMLButtonElement>("[data-target]").forEach((b) =>
      b.addEventListener("click", () => {
        inp("target").value = b.dataset.target!;
        inp("targetUnit").value = b.dataset.unit!;
        calc();
      }),
    );
    $("[data-share]").addEventListener("click", () => copy(location.href, copied, L("Bağlantı kopyalandı.", "Link copied.")));
    $("[data-copy-result]").addEventListener("click", () => copy(lastText, copied));
    $("[data-copy-ff]").addEventListener("click", () => copy(ff.value, copied, L("Komut kopyalandı.", "Command copied.")));

    readUrl();
    reference();
    calc();
  }

  const citeBtn = document.querySelector<HTMLButtonElement>("[data-copy]");
  citeBtn?.addEventListener("click", async () => {
    const ta = document.querySelector<HTMLTextAreaElement>("[data-cite]")!;
    const out = document.querySelector<HTMLElement>("[data-cite-copied]")!;
    try {
      await navigator.clipboard.writeText(ta.value);
    } catch {
      ta.select();
      document.execCommand("copy");
    }
    out.textContent = L("Kopyalandı.", "Copied.");
  });
</script>


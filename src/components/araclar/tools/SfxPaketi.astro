---
/**
 * Free SFX pack for short-form editing (Rast SFX Pack Vol.1).
 * Files: public/araclar/sfx-paketi/ (zip + MP3 previews), list: src/data/sfx-paketi.json.
 * Build pipeline + sources: docs/sections/araclar-paketler.md. No prices.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import Button from "../../../components/Button.astro";
import { PRIMARY_CTA, SITE } from "../../../consts";
import { breadcrumb, faqPage } from "../../../lib/schema";
import SOUNDS from "../../../data/sfx-paketi.json";
import ToolHeader from "../../../components/araclar/ToolHeader.astro";
import MoreTools from "../../../components/araclar/MoreTools.astro";
import ToolFaq from "../../../components/araclar/ToolFaq.astro";

const PATH = "/araclar/sfx-paketi/";
const PAGE_URL = new URL(PATH, SITE.url).href;
const DIR = "/araclar/sfx-paketi/";
const ZIP = DIR + "rast-sfx-pack-vol1.zip";
const ZIP_MB = "9,5 MB";
const title = "Ücretsiz SFX Paketi: Whoosh, Riser, Impact";
const description =
  "Rast SFX Pack Vol.1: Reels, TikTok ve Shorts kurgusu için 40 ücretsiz ses efekti. Whoosh, riser, impact, glitch, deklanşör, bildirim. WAV, ticari kullanım serbest.";

const CATS: Record<string, { label: string; hint: string }> = {
  whoosh: { label: "Whoosh", hint: "Kesme, kaydırma ve zoom geçişleri. Sesin en yüksek anını kesmeye denk getirin." },
  riser: { label: "Riser", hint: "Gerilim kurar. Sonunu kesmeden 1–2 kare önce bitirin, ardından impact ya da sessizlik." },
  impact: { label: "Impact / vuruş", hint: "Başlık girişleri, logo, ürün reveal. Altına bir sub drop eklemek etkiyi büyütür." },
  swell: { label: "Swell", hint: "Ters zil ve parlamalar: bir geçişe ya da logoya doğru şişen sesler." },
  glitch: { label: "Glitch", hint: "Dijital bozulma, ekran geçişi, hata/teknoloji teması." },
  ui: { label: "Tık ve pop (arayüz)", hint: "Metin, ikon ve kartların ekrana gelişi; ekran kaydı videoları." },
  kamera: { label: "Deklanşör", hint: "Fotoğraf karesi donması, flaş, “anı yakala” geçişleri." },
  kagit: { label: "Kağıt ve bant", hint: "Kolaj, scrapbook ve el yapımı tarz kurgular; sticker ve not girişleri." },
  bildirim: { label: "Bildirim", hint: "Mesaj, yorum ya da sipariş bildirimi kartları." },
  gecis: { label: "Geçiş efektleri", hint: "Zip, bant düşüşü, plak cızırtısı: ritmi kıran, komik ya da ani geçişler." },
  drone: { label: "Drone / alt katman", hint: "10 saniyelik alt katman. Müziğin olmadığı anlarda boşluğu doldurur; -20 dB civarında kullanın." },
};

const NAMES: Record<string, string> = {
  "kisa-hizli": "Kısa, hızlı",
  "kisa-kirbac": "Kısa, kırbaç",
  "kisa-siki": "Kısa, sıkı",
  "uzun-derin": "Uzun, derin",
  "uzun-pelerin": "Uzun, pelerin",
  ters: "Ters (reverse)",
  hava: "Hava",
  hizli: "Hızlı",
  gerilim: "Gerilim",
  "sonsuz-yukselis": "Sonsuz yükseliş (Shepard)",
  "kisa-rulo": "Kısa rulo",
  klasik: "Klasik",
  derin: "Derin",
  yumruk: "Yumruk",
  "sub-drop": "Sub drop",
  "ters-zil": "Ters zil",
  halka: "Halka",
  "logo-parlama": "Logo parlaması",
  kekeme: "Kekeme (stutter)",
  veri: "Veri",
  vhs: "VHS",
  tik: "Tık",
  "pop-yumusak": "Yumuşak pop",
  anahtar: "Anahtar (toggle)",
  klavye: "Klavye",
  "deklansor-dslr": "DSLR deklanşör",
  "deklansor-film": "Film kamera deklanşörü",
  "deklansor-gercek": "Gerçek deklanşör kaydı",
  kaydirma: "Kağıt kaydırma",
  burusturma: "Buruşturma",
  "sayfa-cevirme": "Sayfa çevirme",
  "bant-yirtma": "Bant yırtma",
  ding: "Ding",
  zil: "Zil",
  chime: "Chime",
  zip: "Zip",
  "bant-dususu": "Bant düşüşü (tape stop)",
  "plak-cizik": "Plak cızırtısı",
  karanlik: "Karanlık",
};

type Snd = { dosya: string; kategori: string; sure: number; kaynak: string; yazar: string | null; url: string | null };
const items = (SOUNDS as Snd[]).map((s) => {
  const base = s.dosya.split("/")[1].replace(".wav", "");
  const key = base.replace(`rast-sfx-${s.kategori}-`, "");
  return {
    ...s,
    base,
    name: NAMES[key] ?? key,
    mp3: `${DIR}onizleme/${base}.mp3`,
    cc0: s.kaynak === "CC0",
    sec: s.sure.toFixed(1).replace(".", ","),
  };
});
const cats = Object.keys(CATS).map((id) => ({ id, ...CATS[id], items: items.filter((i) => i.kategori === id) }));
const ownCount = items.filter((i) => !i.cc0).length;
const cc0Count = items.length - ownCount;

const faqs = [
  {
    question: "Bu ses efektlerini ticari videolarda kullanabilir miyim?",
    answer:
      "Evet. Müşteri videoları, reklamlar, Reels, TikTok ve YouTube dahil her türlü projede kullanabilirsiniz. Rast üretimi sesler CC BY 4.0 lisanslıdır: video açıklamasına ya da künyeye “Ses efektleri: Rast Creative Studio — rastcreative.com” yazmanız yeterli. CC0 sesler için atıf şartı yok.",
  },
  {
    question: "Hangi sesler CC0, hangileri CC BY 4.0?",
    answer: `Pakette ${ownCount} ses bizim ürettiğimiz (CC BY 4.0), ${cc0Count} ses Freesound'daki CC0 (kamu malı) kayıtlardan seçilip işlendi. Sayfadaki listede her sesin yanında lisansı yazıyor; zip içindeki OKU-BENI.txt ve credits.json da dosya dosya lisansı, orijinal adresi ve yazarı gösteriyor.`,
  },
  {
    question: "Telif hakkı bildirimi (Content ID) alır mıyım?",
    answer:
      "Bu sesleri hiçbir telif tespit sistemine kaydetmedik ve kaydetmeyeceğiz. Yine de CC0 sesler herkese açık olduğu için başka biri aynı sesi kendi işine koyup kaydettirebilir; nadir de olsa haksız bir bildirim alırsanız lisansı (CC0 / CC BY 4.0) ve bu sayfayı göstererek itiraz edebilirsiniz.",
  },
  {
    question: "Dosya formatı ve seviyeleri nasıl?",
    answer:
      "WAV, 48 kHz, 16-bit, stereo. Baştaki ve sondaki sessizlik kırpıldı, kenarlar yumuşatıldı. Kısa sesler -1,5 dBTP tepe seviyesine, 2,5 saniyeden uzun sesler yaklaşık -16 LUFS'a ayarlandı. Kurguda çoğu sesi -6 ile -15 dB arasında kısarak kullanmanız gerekir; müziğin ve konuşmanın altında kalmalı.",
  },
  {
    question: "CapCut, Premiere Pro ya da DaVinci Resolve'da nasıl kullanırım?",
    answer:
      "Zip'i açın, klasörü bilgisayarınızda kalıcı bir yere koyun. Premiere ve Resolve'da klasörü projeye sürükleyin; CapCut'ta Ses > Yerel/İçe aktar ile ekleyin. Sesi zaman çizelgesinde görsel olayın olduğu kareye hizalayın; whoosh'un en yüksek anı kesmeye, impact'in başı vuruş karesine denk gelmeli.",
  },
  {
    question: "Paketi başka bir sitede ya da ses paketi olarak paylaşabilir miyim?",
    answer:
      "Sesleri videolarınızın içinde kullanmanız serbest. Paketi olduğu gibi yeniden satmayın ya da kendi ses paketiniz gibi dağıtmayın; başkalarına önermek isterseniz bu sayfanın bağlantısını paylaşın.",
  },
];

const citeHtml = `<a href="${PAGE_URL}">Rast SFX Pack Vol.1 — Rast Creative</a>`;

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
    { name: "SFX paketi", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${PAGE_URL}#paket`,
    name: "Rast SFX Pack Vol.1",
    alternateName: "Ücretsiz ses efekti paketi (whoosh, riser, impact)",
    url: PAGE_URL,
    description,
    inLanguage: "tr",
    isAccessibleForFree: true,
    encodingFormat: "audio/wav",
    license: "https://creativecommons.org/licenses/by/4.0/deed.tr",
    creator: { "@id": `${SITE.url}#business` },
    publisher: { "@id": `${SITE.url}#business` },
    datePublished: "2026-10-31",
    keywords: "ses efekti, sfx paketi, whoosh, riser, impact, glitch, deklanşör, reels, tiktok",
    associatedMedia: {
      "@type": "MediaObject",
      name: "rast-sfx-pack-vol1.zip",
      contentUrl: new URL(ZIP, SITE.url).href,
      encodingFormat: "application/zip",
    },
    hasPart: items.map((i) => ({
      "@type": "AudioObject",
      name: `${CATS[i.kategori].label}: ${i.name}`,
      contentUrl: new URL(i.mp3, SITE.url).href,
      encodingFormat: "audio/mpeg",
      duration: `PT${i.sure.toFixed(2)}S`,
      license: i.cc0
        ? "https://creativecommons.org/publicdomain/zero/1.0/deed.tr"
        : "https://creativecommons.org/licenses/by/4.0/deed.tr",
    })),
  },
  faqPage(faqs),
];

// ---------- English twin (/en/tools/free-sound-effects-pack/, src/lib/i18n.ts) ----------
interface Props {
  lang?: "tr" | "en";
}
const { lang = "tr" } = Astro.props;
const en = lang === "en";
const EN_PATH = "/en/tools/free-sound-effects-pack/";
const EN_URL = new URL(EN_PATH, SITE.url).href;
const CATS_EN: Record<string, { label: string; hint: string }> = {
  whoosh: { label: "Whoosh", hint: "Cuts, slides and zoom transitions. Line up the loudest moment with the cut." },
  riser: { label: "Riser", hint: "Builds tension. End it 1–2 frames before the cut, then hit an impact or silence." },
  impact: { label: "Impact / hit", hint: "Title cards, logos, product reveals. Layer a sub drop underneath for more weight." },
  swell: { label: "Swell", hint: "Reverse cymbals and shimmers that swell into a transition or a logo." },
  glitch: { label: "Glitch", hint: "Digital distortion, screen transitions, error or tech themes." },
  ui: { label: "Clicks and pops (UI)", hint: "Text, icons and cards popping on screen; screen-recording videos." },
  kamera: { label: "Camera shutter", hint: "Freeze frames, flashes and “capture the moment” transitions." },
  kagit: { label: "Paper and tape", hint: "Collage, scrapbook and handmade-style edits; sticker and note pop-ins." },
  bildirim: { label: "Notification", hint: "Message, comment or order notification cards." },
  gecis: { label: "Transitions", hint: "Zip, tape stop, vinyl scratch: rhythm-breaking, funny or sudden transitions." },
  drone: { label: "Drone / bed", hint: "10-second background bed. Fills gaps where there's no music; use it around -20 dB." },
};
const NAMES_EN: Record<string, string> = {
  "kisa-hizli": "Short, fast", "kisa-kirbac": "Short, whip", "kisa-siki": "Short, tight", "uzun-derin": "Long, deep",
  "uzun-pelerin": "Long, cape", ters: "Reverse", hava: "Air", hizli: "Fast", gerilim: "Tension",
  "sonsuz-yukselis": "Endless rise (Shepard)", "kisa-rulo": "Short roll", klasik: "Classic", derin: "Deep", yumruk: "Punch",
  "sub-drop": "Sub drop", "ters-zil": "Reverse cymbal", halka: "Ring", "logo-parlama": "Logo shimmer", kekeme: "Stutter",
  veri: "Data", vhs: "VHS", tik: "Click", "pop-yumusak": "Soft pop", anahtar: "Toggle", klavye: "Keyboard",
  "deklansor-dslr": "DSLR shutter", "deklansor-film": "Film camera shutter", "deklansor-gercek": "Real shutter recording",
  kaydirma: "Paper slide", burusturma: "Crumple", "sayfa-cevirme": "Page turn", "bant-yirtma": "Tape rip", ding: "Ding",
  zil: "Bell", chime: "Chime", zip: "Zip", "bant-dususu": "Tape stop", "plak-cizik": "Vinyl scratch", karanlik: "Dark",
};
const catsEn = cats.map((c) => ({
  ...c,
  ...(CATS_EN[c.id] ?? {}),
  items: c.items.map((i) => ({ ...i, name: NAMES_EN[i.base.replace(`rast-sfx-${i.kategori}-`, "")] ?? i.name, sec: i.sure.toFixed(1) })),
}));
const ZIP_MB_EN = ZIP_MB.replace(",", ".");
const enTitle = "Free Sound Effects Pack: Whoosh, Riser, Impact SFX";
const enDescription =
  "Rast SFX Pack Vol.1: 40 free sound effects for Reels, TikTok and YouTube Shorts edits. Whooshes, risers, impacts, glitches, shutters, dings. WAV, commercial use OK.";
const enFaqs = [
  {
    question: "Can I use these sound effects in commercial videos?",
    answer:
      "Yes. Use them in client videos, ads, Reels, TikTok, YouTube and any other project. Sounds made by Rast are licensed CC BY 4.0: add “Sound effects: Rast Creative Studio — rastcreative.com” to the video description or credits. CC0 sounds need no credit.",
  },
  {
    question: "Which sounds are CC0 and which are CC BY 4.0?",
    answer: `${ownCount} sounds in the pack were made by us (CC BY 4.0) and ${cc0Count} were picked from CC0 (public domain) recordings on Freesound and processed. The list on this page shows the license next to every sound; credits.json and the readme in the zip list the license, original URL and author file by file.`,
  },
  {
    question: "Will I get copyright claims (Content ID)?",
    answer:
      "We haven't registered these sounds with any content-ID system and won't. Because CC0 sounds are public, someone else could put the same sound in their own work and register it; if you ever get an unfair claim, dispute it by pointing to the license (CC0 / CC BY 4.0) and this page.",
  },
  {
    question: "What format and levels are the files?",
    answer:
      "WAV, 48 kHz, 16-bit, stereo. Leading and trailing silence is trimmed and the edges are faded. Short sounds peak at -1.5 dBTP; sounds longer than 2.5 seconds are set to about -16 LUFS. In the edit you'll usually pull most sounds down by 6 to 15 dB so they sit under the music and voice.",
  },
  {
    question: "How do I use them in CapCut, Premiere Pro or DaVinci Resolve?",
    answer:
      "Unzip the pack and keep the folder somewhere permanent. In Premiere and Resolve, drag the folder into your project; in CapCut, add it via Audio > Device/Import. Line each sound up with the visual event: the peak of a whoosh on the cut, the start of an impact on the hit frame.",
  },
  {
    question: "Can I share the pack on another site or as a sound pack?",
    answer:
      "Using the sounds inside your videos is fine. Don't resell the pack as is or distribute it as your own sound pack; if you want to recommend it, share a link to this page.",
  },
];
const enCiteHtml = `<a href="${EN_URL}">Rast SFX Pack Vol.1 (free sound effects) — Rast Creative</a>`;
const enJsonLd = [
  breadcrumb([
    { name: "Rast Creative", path: "/" },
    { name: "Free tools", path: "/en/tools/" },
    { name: "Free SFX pack", path: EN_PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${EN_URL}#pack`,
    name: "Rast SFX Pack Vol.1",
    alternateName: "Free sound effects pack (whoosh, riser, impact)",
    url: EN_URL,
    description: enDescription,
    inLanguage: "en",
    isAccessibleForFree: true,
    encodingFormat: "audio/wav",
    license: "https://creativecommons.org/licenses/by/4.0/",
    creator: { "@id": `${SITE.url}#business` },
    publisher: { "@id": `${SITE.url}#business` },
    datePublished: "2026-10-31",
    keywords: "free sound effects, sfx pack, whoosh, riser, impact, glitch, camera shutter, reels, tiktok",
    associatedMedia: {
      "@type": "MediaObject",
      name: "rast-sfx-pack-vol1.zip",
      contentUrl: new URL(ZIP, SITE.url).href,
      encodingFormat: "application/zip",
    },
  },
  faqPage(enFaqs),
];

---

<BaseLayout title={en ? enTitle : title} description={en ? enDescription : description} jsonLd={en ? enJsonLd : jsonLd}>
{
  en ? (
    <Fragment>
  <Section width="wide" space="tight">
    <ToolHeader
      href={EN_PATH}
      h1="Free sound effects pack: 40 SFX for short-form video editing"
      cta={{ href: ZIP, label: `Download the pack (ZIP, ${ZIP_MB_EN})`, download: true }}
      cta2={{ href: "#sesler", label: "Listen first" }}
      preview
      badgeExtra="Free · WAV"
    >
      <p>
        In Reels, TikTok and Shorts edits, every cut and every text pop-in should have a sound. We packed the whooshes, risers,
        impacts, glitches, shutters, paper and notification sounds we use in our own work. Preview them all below in your
        browser and download in one click. No sign-up, no email required.
      </p>
    </ToolHeader>

    <div class="facts">
      <ul>
        <li><strong>{items.length} sounds</strong>, {cats.length} categories</li>
        <li><strong>WAV</strong> · 48 kHz · 16-bit · stereo</li>
        <li><strong>Level-matched</strong> · silence trimmed</li>
        <li><strong>License:</strong> {ownCount} sounds CC BY 4.0, {cc0Count} sounds CC0</li>
      </ul>
    </div>
  </Section>
    </Fragment>
  ) : (
    <Fragment>
  <Section width="wide" space="tight">
    <ToolHeader
      href="/araclar/sfx-paketi/"
      h1="Rast SFX Pack Vol.1: kısa video kurgusu için 40 ses efekti"
      cta={{ href: ZIP, label: `Paketi indir (ZIP, ${ZIP_MB})`, download: true }}
      cta2={{ href: "#sesler", label: "Önce dinle" }}
      preview
      badgeExtra="Ücretsiz · WAV"
    >
        <p>
          Reels, TikTok ve Shorts kurgusunda her kesmenin, her metin girişinin bir sesi olmalı. Kendi işlerimizde
          kullandığımız whoosh, riser, impact, glitch, deklanşör, kağıt ve bildirim seslerini tek pakette topladık.
          Hepsini aşağıda tarayıcıda dinleyebilir, tek tıkla indirebilirsiniz. Kayıt yok, e-posta istemiyoruz.
        </p>
      
    </ToolHeader>

    <div class="facts">
      <ul>
        <li><strong>{items.length} ses</strong>, {cats.length} kategori</li>
        <li><strong>WAV</strong> · 48 kHz · 16-bit · stereo</li>
        <li><strong>Seviyesi ayarlı</strong> · sessizlik kırpılmış</li>
        <li><strong>Lisans:</strong> {ownCount} ses CC BY 4.0, {cc0Count} ses CC0</li>
      </ul>
    </div>
  </Section>
    </Fragment>
  )
}

  {
  en ? (
    <Fragment>
  <Section width="wide" space="tight" id="sesler">
    <SectionHeading eyebrow="Preview">Listen to the sounds</SectionHeading>
    <p class="small">Previews are MP3 (128 kbps); the pack has uncompressed WAVs. Audio doesn't load until you press play.</p>
    <div class="cats">
      {
        catsEn.map((c) => (
          <section class="cat" id={`kategori-${c.id}`} aria-labelledby={`h-${c.id}`}>
            <h3 id={`h-${c.id}`}>
              {c.label} <span class="count">{c.items.length}</span>
            </h3>
            <p class="hint">{c.hint}</p>
            <ul class="snd">
              {c.items.map((s) => (
                <li>
                  <div class="snd__meta">
                    <span class="snd__name">{s.name}</span>
                    <span class="snd__sub">
                      {s.sec} s · <span class:list={["lic", s.cc0 && "lic--cc0"]}>{s.cc0 ? "CC0" : "CC BY 4.0"}</span>
                      {s.cc0 && s.url && (
                        <>
                          {" "}· <a href={s.url} rel="noopener" target="_blank">source: {s.yazar}</a>
                        </>
                      )}
                    </span>
                    <code class="snd__file">{s.base}.wav</code>
                  </div>
                  <audio controls preload="none" src={s.mp3} aria-label={`${c.label}: ${s.name} preview`} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="dl">
      <a class="ev-btn ev-btn--sun" href={ZIP} download>All sounds (ZIP, {ZIP_MB_EN})</a>
    </p>
  </Section>
    </Fragment>
  ) : (
    <Fragment>
<Section width="wide" space="tight" id="sesler">
    <SectionHeading eyebrow="Önizleme">Sesleri dinleyin</SectionHeading>
    <p class="small">Önizlemeler MP3'tür (128 kbps); pakettekiler sıkıştırılmamış WAV. Ses, oynat'a basana kadar yüklenmez.</p>
    <div class="cats">
      {
        cats.map((c) => (
          <section class="cat" id={`kategori-${c.id}`} aria-labelledby={`h-${c.id}`}>
            <h3 id={`h-${c.id}`}>
              {c.label} <span class="count">{c.items.length}</span>
            </h3>
            <p class="hint">{c.hint}</p>
            <ul class="snd">
              {c.items.map((s) => (
                <li>
                  <div class="snd__meta">
                    <span class="snd__name">{s.name}</span>
                    <span class="snd__sub">
                      {s.sec} sn · <span class:list={["lic", s.cc0 && "lic--cc0"]}>{s.cc0 ? "CC0" : "CC BY 4.0"}</span>
                      {s.cc0 && s.url && (
                        <>
                          {" "}· <a href={s.url} rel="noopener" target="_blank">kaynak: {s.yazar}</a>
                        </>
                      )}
                    </span>
                    <code class="snd__file">{s.base}.wav</code>
                  </div>
                  <audio controls preload="none" src={s.mp3} aria-label={`${c.label}: ${s.name} önizleme`} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="dl">
      <a class="ev-btn ev-btn--sun" href={ZIP} download>Tüm sesler (ZIP, {ZIP_MB})</a>
    </p>
  </Section>
    </Fragment>
  )
}

  {
  en ? (
    <Fragment>
  <Section width="default" space="tight" id="kullanim">
    <SectionHeading eyebrow="In practice">How to use sound effects in an edit</SectionHeading>
    <ul class="tips">
      <li><strong>One sound per visual event:</strong> text pop-ins, cards, zooms, cuts. Most sounds aren't noticed on their own, but you feel it when they're missing; even “quiet” professional videos carry dozens of small sounds.</li>
      <li><strong>Sync:</strong> put the peak of a whoosh on the cut frame and the start of an impact on the hit frame. End a riser 1–2 frames before the cut.</li>
      <li><strong>Levels:</strong> keep SFX under the voice (-10 to -18 dB for most sounds). UI clicks are the quietest layer, impacts the loudest.</li>
      <li><strong>Don't repeat:</strong> if the same sound comes twice in a row, shift its pitch by 5–10% or alternate between two whooshes.</li>
      <li><strong>Layer:</strong> stack two sounds for big moments, like impact + sub drop, or swell + ding for a logo.</li>
      <li><strong>Final check:</strong> listen once through a phone speaker before you export; that's how most social video is heard.</li>
    </ul>
    <p>
      Placing text on vertical video? The <a href="/en/tools/reels-safe-zone-checker/">Reels / TikTok safe zone checker</a> helps;
      for color, try our <a href="/en/tools/free-lut-pack/">free LUT pack</a>, and for captions the
      <a href="/en/tools/srt-subtitle-checker/">SRT subtitle checker</a>. To get file size right on export, use the
      <a href="/en/tools/video-bitrate-calculator/">video bitrate calculator</a>.
    </p>
  </Section>
    </Fragment>
  ) : (
    <Fragment>
<Section width="default" space="tight" id="kullanim">
    <SectionHeading eyebrow="Pratik">SFX kurguda nasıl oturur?</SectionHeading>
    <ul class="tips">
      <li><strong>Her görsel olaya bir ses:</strong> metin girişi, kart, zoom, kesme. Seslerin çoğu tek başına duyulmaz ama yokluğu hissedilir; “sessiz” görünen profesyonel videolarda bile onlarca küçük ses vardır.</li>
      <li><strong>Hizalama:</strong> whoosh'un en yüksek anını kesmenin olduğu kareye, impact'in başlangıcını vuruş karesine koyun. Riser'ı kesmeden 1–2 kare önce bitirin.</li>
      <li><strong>Seviye:</strong> konuşma varsa SFX'i onun altında tutun (çoğu ses için -10 ile -18 dB arası). Arayüz tıkları en kısık, impact'ler en güçlü katman olmalı.</li>
      <li><strong>Tekrar etmeyin:</strong> aynı ses arka arkaya gelecekse perdesini %5–10 oynatın ya da iki farklı whoosh arasında gidip gelin.</li>
      <li><strong>Katmanlayın:</strong> büyük anlar için impact + sub drop, logo için swell + ding gibi iki sesi üst üste koyun.</li>
      <li><strong>Son kontrol:</strong> dışa aktarmadan önce telefon hoparlöründen bir kez dinleyin; sosyal medya videoları çoğunlukla oradan izlenir.</li>
    </ul>
    <p>
      Dikey videoda metinlerin nereye konacağını da planlıyorsanız <a href="/araclar/guvenli-alan/">Reels / TikTok güvenli alan kontrolü</a>
      işinize yarar; renk için <a href="/araclar/lut-paketi/">ücretsiz LUT paketimize</a>, kapak için
      <a href="/araclar/kapak-sablonlari/">Reels ve YouTube kapak şablonlarına</a>, altyazı için
      <a href="/araclar/altyazi-kontrolu/">altyazı kontrolüne</a> bakabilirsiniz. Ses ve görüntüyü bozmadan dışa aktarmak için
      <a href="/rehber/video-export-ayarlari/">video export ayarları rehberi</a> hazır.
    </p>
  </Section>

`;

  const SAMPLE = `WEBVTT

00:00:00.500 --> 00:00:01.000
Merhaba!

00:00:01.020 --> 00:00:04.000
Bugün size Sakarya'da bir gün boyunca çektiğimiz tanıtım filminin hikâyesini anlatacağız.

00:00:03.800 --> 00:00:06.000
Ã‡ekim gÃ¼nÃ¼ sabah altÄ±da baÅŸladÄ±.

00:00:06.200 --> 00:00:07.000
Işık, ses ve kurgu ekibi hazırdı ama hava hiç de planladığımız gibi değildi.

00:00:07.500   -->   00:00:16.000
Yine de   akşam üstü
güzel bir ışık yakaladık.

00:00:16.040 --> 00:00:18.500
Detaylar videonun sonunda.
`;

  // mojibake (UTF-8 read as cp1252/1254) → Turkish + common letters
  const MOJI: [string, string][] = [
    ["Ã‡", "Ç"], ["Ã§", "ç"], ["Ä\u009e", "Ğ"], ["Äž", "Ğ"], ["ÄŸ", "ğ"], ["Ä°", "İ"], ["Ä±", "ı"],
    ["Ã–", "Ö"], ["Ã¶", "ö"], ["Å\u009e", "Ş"], ["Åž", "Ş"], ["ÅŸ", "ş"], ["Ãœ", "Ü"], ["Ã¼", "ü"],
    ["Ã¢", "â"], ["Ã®", "î"], ["Ã»", "û"], ["Ã©", "é"], ["â€™", "’"], ["â€˜", "‘"], ["â€œ", "“"], ["â€\u009d", "”"],
    ["â€", "”"], ["â€¦", "…"], ["â€“", "–"], ["â€”", "—"], ["Â ", " "], ["Â", ""],
  ];
  // dedupe order: longer first
  MOJI.sort((a, b) => b[0].length - a[0].length);
  const mojiRe = /Ã.|Ä.|Å.|â€|Â(?=[\s\u00a0-\u00bf]|$)/;
  const fixMoji = (s: string) => {
    let o = s;
    for (const [a, b] of MOJI) o = o.split(a).join(b);
    return o;
  };

  // ---------------------------------------------------------------- parsing
  function toSec(t: string) {
    const m = t.trim().match(/^(?:(\d+):)?(\d{1,2}):(\d{2})[.,](\d{1,3})$/);
    if (!m) return NaN;
    return (Number(m[1] || 0) * 3600 + Number(m[2]) * 60 + Number(m[3]) + Number(m[4].padEnd(3, "0")) / 1000);
  }
  function fmtSrt(s: number) {
    const ms = Math.max(0, Math.round(s * 1000));
    const h = Math.floor(ms / 3600000), m = Math.floor((ms % 3600000) / 60000), sec = Math.floor((ms % 60000) / 1000), r = ms % 1000;
    return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(sec).padStart(2, "0")},${String(r).padStart(3, "0")}`;
  }
  const short = (s: number) => fmtSrt(s).slice(3);
  const nf = (x: number, d = 1) => (EN ? x.toFixed(d) : x.toFixed(d).replace(".", ","));

  function parse(text: string) {
    const errs: string[] = [];
    const t = text.replace(/^\uFEFF/, "").replace(/\r\n?/g, "\n");
    const isVtt = /^WEBVTT/.test(t.trim());
    const blocks = t.split(/\n{2,}/);
    const cues: Cue[] = [];
    let n = 0;
    for (const b of blocks) {
      const lines = b.split("\n").filter((l, i, a) => !(i === a.length - 1 && l === ""));
      if (!lines.length || !lines.join("").trim()) continue;
      if (/^WEBVTT/.test(lines[0]) || /^(NOTE|STYLE|REGION)\b/.test(lines[0])) continue;
      const ti = lines.findIndex((l) => l.includes("-->"));
      if (ti < 0) {
        errs.push(L(`Zaman satırı bulunamayan blok atlandı: “${lines[0].slice(0, 40)}”`, `Skipped a block with no timing line: “${lines[0].slice(0, 40)}”`));
        continue;
      }
      const [a, rest] = lines[ti].split("-->");
      const bTime = rest.trim().split(/\s+/)[0];
      const start = toSec(a), end = toSec(bTime);
      n++;
      if (isNaN(start) || isNaN(end)) {
        errs.push(L(`${n}. altyazıda zaman biçimi okunamadı: “${lines[ti].trim()}”`, `Couldn't read the timing in subtitle ${n}: “${lines[ti].trim()}”`));
        continue;
      }
      const textLines = lines.slice(ti + 1);
      cues.push({ idx: n, start, end, lines: textLines, raw: b });
    }
    return { cues, errs, isVtt };
  }

  const clean = (l: string) => l.replace(/<[^>]+>/g, "").replace(/\{\\[^}]*\}/g, "");
  const tidy = (l: string) => l.replace(/[ \t\u00a0]+/g, " ").trim();
  const charCount = (lines: string[]) => lines.map((l) => clean(l).trim()).join(" ").length;

  // ---------------------------------------------------------------- checking
  function rules() {
    const v = (k: string) => Number((document.querySelector(`[data-r="${k}"]`) as HTMLInputElement).value);
    return { cpl: v("cpl"), lines: v("lines"), cps: v("cps"), cpsMax: v("cpsMax"), minDur: v("minDur"), maxDur: v("maxDur"), gapFrames: v("gapFrames"), fps: v("fps") };
  }

  function check(cues: Cue[], R: ReturnType<typeof rules>) {
    const frame = 1 / R.fps;
    const minGap = R.gapFrames * frame - 0.0005;
    const report = cues.map((c, i) => {
      const iss: Issue[] = [];
      const ls = c.lines.map((l) => clean(l));
      const dur = c.end - c.start;
      const chars = charCount(c.lines);
      const cps = dur > 0 ? chars / dur : Infinity;
      const maxLine = Math.max(0, ...ls.map((l) => tidy(l).length));
      if (dur <= 0) iss.push({ level: "err", text: L("Bitiş başlangıçtan önce", "Ends before it starts") });
      if (!ls.join("").trim()) iss.push({ level: "err", text: L("Boş altyazı", "Empty subtitle") });
      if (maxLine > R.cpl) iss.push({ level: "err", text: L(`Satır ${maxLine} karakter (en fazla ${R.cpl})`, `Line is ${maxLine} characters (max ${R.cpl})`) });
      if (ls.length > R.lines) iss.push({ level: "err", text: L(`${ls.length} satır (en fazla ${R.lines})`, `${ls.length} lines (max ${R.lines})`) });
      if (dur > 0 && cps > R.cpsMax) iss.push({ level: "err", text: L(`Okuma hızı ${nf(cps)} KBS (üst sınır ${nf(R.cpsMax)})`, `Reading speed ${nf(cps)} CPS (max ${nf(R.cpsMax)})`) });
      else if (dur > 0 && cps > R.cps) iss.push({ level: "warn", text: L(`Okuma hızı ${nf(cps)} KBS (hedef ${nf(R.cps)})`, `Reading speed ${nf(cps)} CPS (target ${nf(R.cps)})`) });
      if (dur > 0 && dur < R.minDur - 0.0005) iss.push({ level: "warn", text: L(`Süre ${nf(dur, 2)} sn (en az ${nf(R.minDur, 2)})`, `Duration ${nf(dur, 2)} s (min ${nf(R.minDur, 2)})`) });
      if (dur > R.maxDur + 0.0005) iss.push({ level: "warn", text: L(`Süre ${nf(dur, 2)} sn (en fazla ${nf(R.maxDur, 1)})`, `Duration ${nf(dur, 2)} s (max ${nf(R.maxDur, 1)})`) });
      const next = cues[i + 1];
      if (next) {
        const gap = next.start - c.end;
        if (gap < -0.0005) iss.push({ level: "err", text: L(`Sonrakiyle ${nf(-gap, 3)} sn çakışıyor`, `Overlaps the next one by ${nf(-gap, 3)} s`) });
        else if (gap < minGap) iss.push({ level: "err", text: L(`Sonrakiyle boşluk ${(gap * 1000).toFixed(0)} ms (< ${R.gapFrames} kare)`, `Gap to next ${(gap * 1000).toFixed(0)} ms (< ${R.gapFrames} frames)`) });
        else if (gap < 0.5 && gap > 2 * frame + 0.0005) iss.push({ level: "info", text: L(`Boşluk ${Math.round(gap / frame)} kare: 2 kareye kapatılabilir`, `Gap of ${Math.round(gap / frame)} frames: can be closed to 2`) });
      }
      if (i > 0 && c.start < cues[i - 1].start) iss.push({ level: "err", text: L("Sıra dışı (önceki altyazıdan önce başlıyor)", "Out of order (starts before the previous subtitle)") });
      const raw = c.lines.join("\n");
      if (mojiRe.test(raw)) iss.push({ level: "err", text: L("Bozuk Türkçe karakter (kodlama)", "Broken characters (encoding)") });
      if (/\uFFFD/.test(raw)) iss.push({ level: "err", text: L("Okunamayan karakter (�) — dosya kodlaması yanlış", "Unreadable character (�): wrong file encoding") });
      else if (!EN && /[A-Za-zçğıöşüÇĞİÖŞÜ]\?[a-zçğıöşü]/.test(raw)) iss.push({ level: "warn", text: "Kelime içinde “?” — kayıp Türkçe harf olabilir" });
      if (c.lines.some((l) => /^\s|\s$| {2,}/.test(l))) iss.push({ level: "info", text: L("Fazla boşluk", "Extra spaces") });
      if (/-->.*\b(position|line|align|size):/.test(c.raw)) iss.push({ level: "info", text: L("VTT konum ayarı (SRT'de kaldırılır)", "VTT position setting (removed in SRT)") });
      return { cue: c, iss, chars, cps, dur, maxLine };
    });
    return report;
  }

  // ---------------------------------------------------------------- fixing
  function balance(l: string, max: number) {
    const s = tidy(l);
    if (s.length <= max) return [s];
    const mid = s.length / 2;
    let best = -1;
    for (let i = 0; i < s.length; i++) if (s[i] === " " && (best < 0 || Math.abs(i - mid) < Math.abs(best - mid))) best = i;
    if (best < 0) return [s];
    const a = s.slice(0, best), b = s.slice(best + 1);
    return a.length <= max && b.length <= max ? [a, b] : [s];
  }

  function fix(cues: Cue[], R: ReturnType<typeof rules>, opt: Record<string, boolean>) {
    const frame = 1 / R.fps;
    const minGap = R.gapFrames * frame;
    const out = cues
      .map((c) => ({ ...c, lines: c.lines.map((l) => (opt.mojibake ? fixMoji(l) : l)).map(tidy).filter((l) => l !== "") }))
      .filter((c) => c.lines.length && c.end > c.start)
      .sort((a, b) => a.start - b.start);
    const changes: string[] = [];
    for (let i = 0; i < out.length; i++) {
      const c = out[i];
      const n = out[i + 1];
      if (opt.balance && c.lines.length === 1 && c.lines[0].length > R.cpl && R.lines >= 2) {
        const b = balance(c.lines[0], R.cpl);
        if (b.length === 2) {
          c.lines = b;
          changes.push(L(`#${i + 1}: iki satıra bölündü`, `#${i + 1}: split over two lines`));
        }
      }
      if (n) {
        const gap = n.start - c.end;
        if (opt.overlap && gap < minGap - 0.0005) {
          const newEnd = n.start - minGap;
          if (newEnd > c.start + 0.2) {
            c.end = newEnd;
            changes.push(L(`#${i + 1}: bitiş ${short(newEnd)} (çakışma/boşluk)`, `#${i + 1}: end ${short(newEnd)} (overlap/gap)`));
          }
        } else if (opt.chain && gap > minGap + 0.0005 && gap < 0.5) {
          c.end = n.start - minGap;
          changes.push(L(`#${i + 1}: boşluk 2 kareye kapatıldı`, `#${i + 1}: gap closed to 2 frames`));
        }
      }
      if (opt.short && c.end - c.start < R.minDur) {
        const limit = n ? n.start - minGap : Infinity;
        const want = c.start + R.minDur;
        const newEnd = Math.min(want, limit);
        if (newEnd > c.end + 0.0005) {
          c.end = newEnd;
          changes.push(L(`#${i + 1}: süre ${nf(newEnd - c.start, 2)} sn'ye uzatıldı`, `#${i + 1}: extended to ${nf(newEnd - c.start, 2)} s`));
        }
      }
    }
    const srt = out.map((c, i) => `${i + 1}\n${fmtSrt(c.start)} --> ${fmtSrt(c.end)}\n${c.lines.join("\n")}\n`).join("\n");
    return { srt, changes, cues: out };
  }

  // ---------------------------------------------------------------- UI
  const root = document.querySelector<HTMLElement>("[data-tool]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const input = $<HTMLTextAreaElement>("[data-input]");
    const enc = $<HTMLElement>("[data-enc]");
    const results = $<HTMLElement>("[data-results]");
    const summary = $<HTMLElement>("[data-summary]");
    const rows = $<HTMLElement>("[data-rows]");
    const only = $<HTMLInputElement>("[data-only]");
    const cueSel = $<HTMLSelectElement>("[data-cue]");
    let fileName = L("altyazi", "subtitles");
    let lastReport: ReturnType<typeof check> = [];
    let lastCues: Cue[] = [];

    function decode(buf: ArrayBuffer) {
      try {
        const t = new TextDecoder("utf-8", { fatal: true }).decode(buf);
        enc.hidden = true;
        return t;
      } catch {
        const t = new TextDecoder(EN ? "windows-1252" : "windows-1254").decode(buf);
        enc.textContent = L("Dosya UTF-8 değil; Türkçe Windows-1254 kodlamasıyla okundu. Düzeltilmiş SRT UTF-8 olarak indirilir.", "The file isn't UTF-8; it was read as Windows-1252. The fixed SRT downloads as UTF-8.");
        enc.hidden = false;
        return t;
      }
    }
    wireDrop($<HTMLElement>("[data-drop]"), $<HTMLInputElement>("[data-file]"), async (fs) => {
      const f = fs[0];
      if (f.size > 5_000_000) {
        enc.textContent = L("Dosya çok büyük (5 MB üstü). Altyazı dosyası mı seçtiniz?", "The file is too large (over 5 MB). Did you pick a subtitle file?");
        enc.hidden = false;
        return;
      }
      fileName = f.name.replace(/\.[^.]+$/, "");
      input.value = decode(await f.arrayBuffer());
      run();
    });
    $<HTMLButtonElement>("[data-sample]").addEventListener("click", () => {
      fileName = L("ornek", "sample");
      input.value = EN ? SAMPLE_EN : SAMPLE;
      enc.hidden = true;
      run();
    });
    $<HTMLButtonElement>("[data-check]").addEventListener("click", run);
    $<HTMLSelectElement>("[data-preset]").addEventListener("change", (e) => {
      const p = PRESETS[(e.target as HTMLSelectElement).value];
      if (p) for (const k in p) (document.querySelector(`[data-r="${k}"]`) as HTMLInputElement).value = String(p[k]);
      if (input.value.trim()) run();
    });
    root.querySelectorAll<HTMLInputElement>("[data-r]").forEach((el) =>
      el.addEventListener("change", () => {
        $<HTMLSelectElement>("[data-preset]").value = "ozel";
        if (input.value.trim()) run();
      }),
    );
    only.addEventListener("change", render);
    root.querySelector('[data-fix="mojibake"]')!.addEventListener("change", render);

    function run() {
      const { cues, errs, isVtt } = parse(input.value);
      lastCues = cues;
      lastReport = check(cues, rules());
      results.hidden = false;
      const nErr = lastReport.filter((r) => r.iss.some((i) => i.level === "err")).length;
      const nWarn = lastReport.filter((r) => !r.iss.some((i) => i.level === "err") && r.iss.some((i) => i.level === "warn")).length;
      const total = cues.length;
      const avgCps = total ? lastReport.reduce((a, r) => a + (isFinite(r.cps) ? r.cps : 0), 0) / total : 0;
      const allText = cues.map((c) => c.lines.join(" ")).join(" ");
      const trWords = /[çğıöşüÇĞİÖŞÜ]/.test(allText);
      let s = L(`${total} altyazı okundu${isVtt ? " (WebVTT)" : ""}. ${nErr} altyazıda hata, ${nWarn} altyazıda uyarı. Ortalama okuma hızı ${avgCps.toFixed(1).replace(".", ",")} KBS.`, `${total} subtitles read${isVtt ? " (WebVTT)" : ""}. ${nErr} with errors, ${nWarn} with warnings. Average reading speed ${avgCps.toFixed(1)} CPS.`);
      if (errs.length) s += L(` Okunamayan: ${errs.join(" · ")}`, ` Unreadable: ${errs.join(" · ")}`);
      if (!EN && total > 5 && !trWords && /[a-z]{3,}/i.test(allText)) s += " Metinde hiç ç, ğ, ı, ö, ş, ü yok: Türkçe karakterler kaybolmuş olabilir.";
      if (!total) s = L("Altyazı bulunamadı. Dosyanın SRT ya da VTT olduğundan emin olun.", "No subtitles found. Make sure the file is SRT or VTT.");
      summary.textContent = s;
      const nOk = total - nErr - nWarn;
      const stats = $<HTMLElement>("[data-stats]");
      stats.innerHTML = "";
      if (total)
        ([["err", nErr, L("hata", "errors")], ["warn", nWarn, L("uyarı", "warnings")], ["ok", nOk, L("sorunsuz", "OK")]] as const).forEach(([k, n, t]) => {
          const c = document.createElement("span");
          c.className = `ak-chip ak-chip--${k}${n ? "" : " is-zero"}`;
          c.textContent = `${n} ${t}`;
          stats.append(c);
        });
      cueSel.innerHTML = "";
      cues.forEach((c, i) => {
        const o = document.createElement("option");
        o.value = String(i);
        o.textContent = `#${c.idx} ${short(c.start)} — ${clean(fixMoji(c.lines.join(" "))).slice(0, 50)}`;
        cueSel.append(o);
      });
      // preview the first broken-character cue (shows the repaired Turkish text), else the first problem
      const firstMoji = lastReport.findIndex((r) => mojiRe.test(r.cue.lines.join("\n")));
      const firstBad = lastReport.findIndex((r) => r.iss.some((i) => i.level !== "info"));
      cueSel.value = String(Math.max(0, firstMoji >= 0 ? firstMoji : firstBad));
      render();
      burn();
    }

    function render() {
      rows.innerHTML = "";
      const mojiOn = root.querySelector<HTMLInputElement>('[data-fix="mojibake"]')!.checked;
      const sel = Number(cueSel.value || -1);
      const el = (tag: string, cls: string, txt?: string) => {
        const e = document.createElement(tag);
        if (cls) e.className = cls;
        if (txt != null) e.textContent = txt;
        return e;
      };
      lastReport.forEach((r, i) => {
        if (only.checked && !r.iss.length) return;
        const lv = r.iss.some((x) => x.level === "err") ? "err" : r.iss.some((x) => x.level === "warn") ? "warn" : "ok";
        const li = el("li", `ak-row ak-row--${lv}${i === sel ? " is-sel" : ""}`);
        li.tabIndex = 0;
        li.dataset.i = String(i);
        const st = el("div", "ak-st");
        st.append(el("span", `ak-chip ak-chip--${lv}`, lv === "err" ? L("Hata", "Error") : lv === "warn" ? L("Uyarı", "Warning") : L("Tamam", "OK")), el("span", "ak-n", `#${r.cue.idx}`));
        const time = el("div", "ak-time", `${short(r.cue.start)} → ${short(r.cue.end)}`);
        const text = el("div", "ak-text");
        const raw = r.cue.lines.map(clean).join("\n");
        if (mojiRe.test(raw)) {
          text.append(el("s", "ak-raw", raw));
          const f = el("span", "ak-fixed");
          f.append(el("b", "", mojiOn ? L("SRT'de düzeltilir:", "Fixed in SRT:") : L("Doğrusu:", "Should read:")), document.createTextNode(" " + fixMoji(raw)));
          text.append(f);
        } else text.append(el("span", "", raw));
        const meta = el("div", "ak-meta");
        const m1 = el("span", r.maxLine > rules().cpl ? "is-bad" : "");
        m1.append(el("b", "", String(r.maxLine)), document.createTextNode(L(" kr/satır", " chars/line")));
        const m2 = el("span", isFinite(r.cps) && r.cps > rules().cpsMax ? "is-bad" : isFinite(r.cps) && r.cps > rules().cps ? "is-warn" : "");
        m2.append(el("b", "", isFinite(r.cps) ? nf(r.cps) : "—"), document.createTextNode(L(" KBS", " CPS")));
        meta.append(m1, m2);
        const box = el("div", "ak-iss");
        if (!r.iss.length) box.append(el("span", "yt-badge yt-badge--ok", L("Sorun yok", "No issues")));
        [...r.iss].sort((a, b) => ["err", "warn", "info"].indexOf(a.level) - ["err", "warn", "info"].indexOf(b.level)).forEach((x) =>
          box.append(el("span", `yt-badge yt-badge--${x.level === "err" ? "err" : x.level === "warn" ? "warn" : "info"}`, x.text)),
        );
        li.append(st, time, text, meta, box);
        const pick = () => {
          cueSel.value = String(i);
          rows.querySelectorAll(".is-sel").forEach((e) => e.classList.remove("is-sel"));
          li.classList.add("is-sel");
          burn();
          document.querySelector("[data-burn]")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
        };
        li.addEventListener("click", pick);
        li.addEventListener("keydown", (e) => e.key === "Enter" && pick());
        rows.append(li);
      });
      if (!rows.children.length) {
        rows.append(el("li", "ak-empty", lastReport.length ? L("Seçili kurallara göre sorunlu altyazı yok.", "No subtitles with issues under the selected rules.") : "—"));
      }
    }

    $<HTMLButtonElement>("[data-dl]").addEventListener("click", () => {
      if (!lastCues.length) return;
      const opt: Record<string, boolean> = {};
      root.querySelectorAll<HTMLInputElement>("[data-fix]").forEach((c) => (opt[c.dataset.fix!] = c.checked));
      const res = fix(lastCues, rules(), opt);
      downloadBlob(new Blob(["\uFEFF" + res.srt.replace(/\n/g, "\r\n")], { type: "application/x-subrip;charset=utf-8" }), `${L("rast-duzeltilmis", "rast-fixed")}-${fileName.replace(/[^\w-]+/g, "-").slice(0, 40)}.srt`);
      summary.textContent += L(` İndirilen dosyada ${res.changes.length} zaman/satır düzeltmesi yapıldı.`, ` The downloaded file has ${res.changes.length} timing/line fixes.`);
    });

    // ---------------------------------------------------------------- burn-in preview
    const canvas = $<HTMLCanvasElement>("[data-canvas]");
    const ctx = canvas.getContext("2d")!;
    const fsIn = $<HTMLInputElement>("[data-fs]");
    const posIn = $<HTMLInputElement>("[data-pos]");
    const bw = $<HTMLElement>("[data-burnwarn]");
    const bok = $<HTMLElement>("[data-burnok]");
    const logo = loadLogo();
    const UF = `"Space Grotesk Variable", system-ui, -apple-system, "Segoe UI", sans-serif`;
    const bg = new Image();
    bg.decoding = "async";
    bg.onload = () => burn();
    bg.src = "/araclar/altyazi-kontrolu/rast-ornek-kare-9x16.jpg";
    $<HTMLInputElement>("[data-bg]").addEventListener("change", (e) => {
      const f = (e.target as HTMLInputElement).files?.[0];
      if (f) bg.src = URL.createObjectURL(f);
    });
    document.fonts?.ready.then(() => burn());
    let credit = false;
    const fmt = () => (root.querySelector<HTMLInputElement>('input[name="fmt"]:checked')!.value as "v" | "h");
    const plat = () => DATA.platforms.find((p) => p.id === root.querySelector<HTMLInputElement>('input[name="plat"]:checked')!.value)!;

    function wrap(text: string, maxW: number) {
      const words = text.split(/\s+/);
      const out: string[] = [];
      let cur = "";
      for (const w of words) {
        const t = cur ? cur + " " + w : w;
        if (ctx.measureText(t).width > maxW && cur) {
          out.push(cur);
          cur = w;
        } else cur = t;
      }
      if (cur) out.push(cur);
      return out;
    }

    function burn() {
      const v = fmt() === "v";
      canvas.width = v ? 1080 : 1920;
      canvas.height = v ? 1920 : 1080;
      (canvas.parentElement as HTMLElement).style.maxWidth = v ? "420px" : "100%";
      root.querySelector<HTMLElement>("[data-platwrap]")!.hidden = !v;
      const W = canvas.width, H = canvas.height;
      rows.querySelectorAll<HTMLElement>(".ak-row").forEach((e) => e.classList.toggle("is-sel", e.dataset.i === cueSel.value));
      const g = ctx.createLinearGradient(0, 0, W, H);
      g.addColorStop(0, "#c98a54");
      g.addColorStop(0.55, "#7b5a8f");
      g.addColorStop(1, "#2c3a5c");
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
      if (bg.complete && bg.naturalWidth) {
        const s = Math.max(W / bg.naturalWidth, H / bg.naturalHeight);
        const dw = bg.naturalWidth * s, dh = bg.naturalHeight * s;
        ctx.drawImage(bg, (W - dw) / 2, (H - dh) / 2, dw, dh);
      }
      const p = plat();
      if (v) {
        ctx.fillStyle = "rgba(12,12,16,.45)";
        ctx.fillRect(0, 0, W, p.top);
        ctx.fillRect(0, H - p.bottom, W, p.bottom);
        if (p.rail) ctx.fillRect(p.rail.x, p.rail.y1, W - p.rail.x, p.rail.y2 - p.rail.y1);
        ctx.fillStyle = "rgba(255,255,255,.85)";
        ctx.font = `600 28px ${UF}`;
        ctx.fillText(L(`${p.label} arayüzü (yaklaşık)`, `${p.label} UI (approximate)`), 40, Math.min(70, p.top - 30));
      } else {
        ctx.strokeStyle = "rgba(255,255,255,.5)";
        ctx.setLineDash([16, 10]);
        ctx.lineWidth = 3;
        ctx.strokeRect(W * 0.05, H * 0.05, W * 0.9, H * 0.9);
        ctx.setLineDash([]);
        ctx.fillStyle = "rgba(255,255,255,.85)";
        ctx.font = `600 28px ${UF}`;
        ctx.fillText(L("%90 başlık güvenli alanı", "90% title safe area"), W * 0.05 + 10, H * 0.05 + 36);
      }
      const i = Number(cueSel.value || 0);
      const cue = lastCues[i];
      const text = cue ? clean(fixMoji(cue.lines.join(" "))).replace(/\s+/g, " ").trim() : L("Altyazınız burada görünür; iki satırı geçmesin.", "Your subtitle appears here; keep it to two lines.");
      const fs = Number(fsIn.value) * (v ? 1 : 0.9);
      ctx.font = `700 ${fs}px ${UF}`;
      const sideMargin = v ? Math.max(p.left, p.right) + 20 : W * 0.1;
      const lines = cue && cue.lines.length ? cue.lines.map((l) => tidy(clean(fixMoji(l)))).filter(Boolean).flatMap((l) => wrap(l, W - sideMargin * 2)) : wrap(text, W - sideMargin * 2);
      const lh = fs * 1.28;
      const padY = fs * 0.32, padX = fs * 0.45;
      const blockH = lines.length * lh + padY * 2;
      const bottomY = H - (Number(posIn.value) / 100) * H;
      const topY = bottomY - blockH;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      let maxW = 0;
      lines.forEach((l) => (maxW = Math.max(maxW, ctx.measureText(l).width)));
      ctx.fillStyle = "rgba(0,0,0,.58)";
      ctx.beginPath();
      ctx.roundRect(W / 2 - maxW / 2 - padX, topY, maxW + padX * 2, blockH, fs * 0.28);
      ctx.fill();
      ctx.save();
      ctx.shadowColor = "rgba(0,0,0,.55)";
      ctx.shadowBlur = fs * 0.18;
      ctx.shadowOffsetY = fs * 0.04;
      ctx.fillStyle = "#fff";
      lines.forEach((l, k) => ctx.fillText(l, W / 2, topY + padY + lh * (k + 0.5)));
      ctx.restore();
      ctx.textAlign = "left";
      ctx.textBaseline = "alphabetic";
      const x1 = W / 2 - maxW / 2 - padX, x2 = W / 2 + maxW / 2 + padX;
      const probs: string[] = [];
      if (v) {
        if (bottomY > H - p.bottom) probs.push(L(`alt arayüz bandına (${p.bottom} px) giriyor`, `runs into the bottom UI band (${p.bottom} px)`));
        if (topY < p.top) probs.push(L("üst arayüz bandına giriyor", "runs into the top UI band"));
        if (p.rail && x2 > p.rail.x && bottomY > p.rail.y1 && topY < p.rail.y2) probs.push(L("sağdaki buton sütununun altında kalıyor", "sits under the button column on the right"));
        if (x1 < p.left) probs.push(L("sol kenara çok yakın", "is too close to the left edge"));
      } else if (bottomY > H * 0.95 || topY < H * 0.05 || x1 < W * 0.05) probs.push(L("%90 güvenli alanın dışına taşıyor", "goes outside the 90% safe area"));
      if (lines.length > 2) probs.push(L(`${lines.length} satıra kırılıyor (yazıyı küçültün ya da altyazıyı bölün)`, `wraps to ${lines.length} lines (use a smaller font or split the subtitle)`));
      ctx.strokeStyle = probs.length ? "#ff4d4d" : "#3ddc84";
      ctx.lineWidth = 4;
      ctx.setLineDash([14, 10]);
      ctx.beginPath();
      ctx.roundRect(x1 - 10, topY - 10, x2 - x1 + 20, blockH + 20, fs * 0.34);
      ctx.stroke();
      ctx.setLineDash([]);
      bw.hidden = !probs.length;
      bok.hidden = !!probs.length;
      bw.textContent = probs.length ? `${L("Altyazı", "The subtitle")} ${probs.join(", ")}.` : "";
      bok.textContent = probs.length ? "" : L("Altyazı bu konumda arayüzün altında kalmıyor.", "At this position the subtitle stays clear of the UI.");
      if (credit) drawCredit(ctx, logo, 40, H - 74, 1, PATH);
    }
    [fsIn, posIn, cueSel].forEach((el) => el.addEventListener("input", burn));
    root.querySelectorAll<HTMLInputElement>('input[name="fmt"], input[name="plat"]').forEach((el) => el.addEventListener("change", burn));
    $<HTMLButtonElement>("[data-png]").addEventListener("click", () => {
      credit = true;
      burn();
      exportCanvasPng(canvas, `rast-altyazi-onizleme-${fmt() === "v" ? "9x16" : "16x9"}.png`, PAGE, "Rast Creative subtitle checker");
      credit = false;
      burn();
    });
    logo.onload = burn;
    burn();
  }
</script>

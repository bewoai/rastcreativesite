---
/**
 * /araclar/altyazi-kontrolu/ — SRT/VTT subtitle checker. 100% client-side.
 * Checks chars per line, reading speed (CPS), line count, durations, gaps and
 * overlaps, Turkish character problems (mojibake, Windows-1254); exports a fixed
 * SRT for the trivial fixes; burn-in preview against Reels/TikTok/Shorts UI zones.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import Extras from "../../../pages/araclar/_yaratici/Extras.astro";
import { SITE } from "../../../consts";
import { breadcrumb, faqPage } from "../../../lib/schema";
import ZONES from "../../../data/safe-zones.json";
import "../../../pages/araclar/_yaratici/tool.css";
import ToolHeader from "../../../components/araclar/ToolHeader.astro";

const PATH = "/araclar/altyazi-kontrolu/";
const PAGE_URL = new URL(PATH, SITE.url).href;
const title = "Altyazı Kontrolü: SRT/VTT Satır ve Okuma Hızı";
const description =
  "Ücretsiz SRT/VTT altyazı kontrolü: satır başına karakter, okuma hızı (KBS), satır sayısı, süre, çakışma ve Türkçe karakter hataları. Düzeltilmiş SRT indirin.";

const faqs = [
  {
    question: "Türkçe altyazıda bir satır kaç karakter olmalı?",
    answer:
      "Netflix'in Türkçe altyazı rehberi satır başına en fazla 42 karakter ve en fazla 2 satır öngörür. Dikey videoda (Reels, TikTok, Shorts) ekran dar ve yazı büyük olduğu için biz satır başına 32 karaktere yakın kalmayı öneriyoruz; bu bir platform kuralı değil, kendi pratiğimizdir.",
  },
  {
    question: "Okuma hızı (KBS / CPS) nedir, kaç olmalı?",
    answer:
      "Okuma hızı, altyazıdaki karakter sayısının (boşluklar dahil) ekranda kalma süresine bölünmesidir: saniyede karakter. Netflix Türkçe rehberi yetişkin içerik için saniyede 17 karakter önerir, gerektiğinde 20'ye kadar izin verir; çocuk içeriğinde 13 (en fazla 17).",
  },
  {
    question: "Altyazı en az ve en fazla kaç saniye ekranda kalmalı?",
    answer:
      "Netflix genel kuralına göre bir altyazı en az 5/6 saniye (yaklaşık 0,83 sn) ve en fazla 7 saniye ekranda kalmalı. Ardışık iki altyazı arasında en az 2 kare boşluk olmalı; 3–11 karelik (24 fps'te) boşluklar 2 kareye kapatılır.",
  },
  {
    question: "Altyazıda ş, ğ, ı yerine Ã, Ä± gibi karakterler çıkıyor, neden?",
    answer:
      "Dosya UTF-8 olarak kaydedilmiş ama bir program onu Windows-1252/1254 gibi eski bir kodlamayla okumuş (ya da tersi). Araç bu bozuk karakterleri tanır ve düzeltilmiş SRT'de doğru Türkçe harflere çevirir. Düzeltilmiş dosya her zaman UTF-8 olarak indirilir.",
  },
  {
    question: "Araç neleri otomatik düzeltiyor, neleri düzeltmiyor?",
    answer:
      "Otomatik: numaralandırma, gereksiz boşluklar, bozuk Türkçe karakterler, VTT'den SRT'ye dönüşüm, çakışan zamanlar, 2 kareden kısa boşluklar ve yer varsa çok kısa altyazıların uzatılması. İsterseniz tek satırda kalan uzun cümleler iki satıra dengelenir. Okuma hızı yüksek altyazıları kısaltmak ya da bölmek çeviri kararı olduğu için araç bunları yalnızca işaretler.",
  },
  {
    question: "Altyazı dosyam bir sunucuya gönderiliyor mu?",
    answer:
      "Hayır. Dosya tarayıcınızda okunur, kontrol ve düzeltme de tarayıcınızda yapılır; hiçbir sunucuya gönderilmez, kaydedilmez. Sayfada üçüncü taraf takip kodu yoktur.",
  },
];

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
    { name: "Altyazı kontrolü", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Altyazı Kontrolü (SRT/VTT)",
    alternateName: "SRT / VTT subtitle checker (CPL, CPS, timing, Turkish characters)",
    url: PAGE_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "Modern bir web tarayıcısı; JavaScript gerekli",
    isAccessibleForFree: true,
    inLanguage: "tr",
    offers: { "@type": "Offer", price: "0", priceCurrency: "TRY" },
    description,
    featureList: [
      "SRT ve WebVTT okuma (UTF-8 ve Windows-1254)",
      "Satır başına karakter ve satır sayısı kontrolü",
      "Okuma hızı (saniyede karakter) kontrolü",
      "En kısa / en uzun süre, boşluk ve çakışma kontrolü",
      "Bozuk Türkçe karakter tespiti ve onarımı",
      "Düzeltilmiş SRT indirme",
      "Dikey video güvenli alan önizlemesi",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
  },
  faqPage(faqs),
];
const plats = ZONES.platforms.filter((p) => p.id !== "instagram-story");

// ---------- English twin (/en/tools/srt-subtitle-checker/, src/lib/i18n.ts) ----------
interface Props {
  lang?: "tr" | "en";
}
const { lang = "tr" } = Astro.props;
const en = lang === "en";
const t = (tr: string, eng: string) => (en ? eng : tr);
const EN_PATH = "/en/tools/srt-subtitle-checker/";
const EN_URL = new URL(EN_PATH, SITE.url).href;
const enTitle = "SRT Subtitle Checker: Line Length, CPS & Timing";
const enDescription =
  "Free SRT and VTT subtitle checker: characters per line, reading speed (CPS), line count, duration, overlaps and broken characters. Download a fixed SRT file.";
const enFaqs = [
  {
    question: "How many characters per line should subtitles have?",
    answer:
      "Netflix's English timed text style guide allows up to 42 characters per line and no more than 2 lines. On vertical video (Reels, TikTok, Shorts) the screen is narrow and the text is large, so we recommend staying close to 32 characters per line; that's our own production practice, not a platform rule.",
  },
  {
    question: "What is subtitle reading speed (CPS) and what should it be?",
    answer:
      "Reading speed is the number of characters in a subtitle (including spaces) divided by how long it stays on screen: characters per second. Netflix allows up to 20 characters per second for adult English content and 17 for children's content. The checker warns above a softer target (17 / 13 CPS) and flags an error above the maximum.",
  },
  {
    question: "What is the minimum and maximum duration of a subtitle?",
    answer:
      "Under Netflix's general requirements a subtitle should stay on screen for at least 5/6 of a second (about 0.83 s) and at most 7 seconds. Leave at least 2 frames between consecutive subtitles; gaps of 3–11 frames (at 24 fps) are closed to 2 frames.",
  },
  {
    question: "Why do my subtitles show characters like â€™ or Ã© instead of ’ or é?",
    answer:
      "The file was saved as UTF-8 but a program read it as an older encoding such as Windows-1252 (or the other way round). The checker recognises these broken sequences and turns them back into the right characters in the fixed SRT. The fixed file is always downloaded as UTF-8.",
  },
  {
    question: "What does the checker fix automatically, and what not?",
    answer:
      "Automatically: numbering, extra spaces, broken characters, VTT to SRT conversion, overlapping times, gaps shorter than 2 frames, and extending very short subtitles when there is room. Optionally, long single lines are balanced over two lines. Shortening or splitting subtitles that read too fast is an editorial decision, so the tool only flags them.",
  },
  {
    question: "Is my subtitle file sent to a server?",
    answer:
      "No. The file is read in your browser and the checks and fixes run in your browser too; nothing is sent to or stored on a server. The tool has no third-party tracking.",
  },
];
const enJsonLd = [
  breadcrumb([
    { name: "Rast Creative", path: "/" },
    { name: "Free tools", path: "/en/tools/" },
    { name: "SRT subtitle checker", path: EN_PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "SRT / VTT Subtitle Checker",
    alternateName: ["Subtitle validator", "SRT file checker (CPL, CPS, timing)"],
    url: EN_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "A modern web browser with JavaScript",
    isAccessibleForFree: true,
    inLanguage: "en",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description: enDescription,
    featureList: [
      "Reads SRT and WebVTT (UTF-8 and Windows-1252)",
      "Characters per line and line count checks",
      "Reading speed (characters per second) check",
      "Minimum / maximum duration, gap and overlap checks",
      "Broken character (mojibake) detection and repair",
      "Fixed SRT download",
      "Burned-in subtitle preview against vertical video safe zones",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
    dateModified: "2026-10-31",
  },
  faqPage(enFaqs),
];

---

<BaseLayout title={en ? enTitle : title} description={en ? enDescription : description} jsonLd={en ? enJsonLd : jsonLd}>
  <div class="yt-page">
    <Section width="wide" space="tight">
      <ToolHeader
        href={en ? EN_PATH : "/araclar/altyazi-kontrolu/"}
        h1={en ? "SRT subtitle checker: test your SRT or VTT file before you publish" : "Altyazı kontrolü: SRT ve VTT dosyanızı yayından önce test edin"}
      >
        {en ? (
          <p>
            Long lines, subtitles that flash by too fast to read, overlapping times and broken characters like “â€™” pull
            viewers out of your video. Open your file and the checker tests every subtitle for line length, reading speed,
            duration and characters, fixes the simple errors and gives you a clean SRT. <strong>Your file never leaves your browser.</strong>
          </p>
        ) : (
          <p>
            Uzun satırlar, okunamayacak kadar hızlı geçen altyazılar, çakışan zamanlar ve “ÅŸ” gibi bozuk Türkçe
            karakterler izleyiciyi videodan koparır. Dosyanızı açın; araç her altyazıyı satır uzunluğu, okuma hızı, süre ve
            karakter açısından kontrol etsin, basit hataları düzeltip temiz bir SRT versin. <strong>Dosyanız tarayıcınızdan çıkmaz.</strong>
          </p>
        )}
        
      </ToolHeader>

      <div id="arac" class="yt-tool" data-tool>
        <div class="yt-tool yt-tool--split" style="padding:0;border:0;background:none">
          <div class="yt-stage">
            <label class="yt-drop" data-drop>
              <input type="file" class="yt-sr" data-file accept=".srt,.vtt,.txt,text/plain,text/vtt,application/x-subrip" />
              <span class="yt-drop__title">{t("SRT / VTT dosyası seçin ya da buraya sürükleyin", "Choose an SRT / VTT file or drop it here")}</span>
              <span class="yt-drop__hint">{t("Yalnızca tarayıcınızda okunur", "Read only in your browser")}</span>
            </label>
            <label class="yt-small" for="srt-in">{t("ya da altyazı metnini yapıştırın", "or paste the subtitle text")}</label>
            <textarea id="srt-in" class="yt-textarea" rows="9" data-input spellcheck="false" placeholder={en ? "1\n00:00:01,000 --> 00:00:03,200\nHello, this is a sample subtitle.\n" : "1\n00:00:01,000 --> 00:00:03,200\nMerhaba, bu bir örnek altyazı.\n"}></textarea>
            <div class="yt-actions" style="margin:0">
              <button type="button" class="ev-btn ev-btn--sun" data-check>{t("Kontrol et", "Check subtitles")}</button>
              <button type="button" class="yt-btn" data-sample>{t("Örnek dosyayı yükle", "Load a sample file")}</button>
            </div>
            <p class="yt-warn" data-enc aria-live="polite" hidden></p>
          </div>
          <div>
            <fieldset>
              <legend>{t("Kurallar", "Rules")}</legend>
              <label class="yt-field">{t("Hazır ayar", "Preset")}
                <select data-preset>
                  <option value="netflix">{t("Netflix Türkçe (yetişkin): 42 karakter · 17 KBS · 2 satır", "Netflix English (adult): 42 chars · max 20 CPS · 2 lines")}</option>
                  <option value="dikey">{t("Dikey video (Rast önerisi): 32 karakter · 17 KBS · 2 satır", "Vertical video (Rast): 32 chars · 17 CPS · 2 lines")}</option>
                  <option value="cocuk">{t("Netflix Türkçe (çocuk): 42 karakter · 13 KBS · 2 satır", "Netflix English (children): 42 chars · max 17 CPS · 2 lines")}</option>
                  <option value="ozel">{t("Özel", "Custom")}</option>
                </select>
              </label>
              <div class="yt-fields" style="margin-top:.8rem">
                <label class="yt-field">{t("Satır başına en fazla karakter", "Max characters per line")} <input type="number" min="10" max="80" value="42" data-r="cpl" /></label>
                <label class="yt-field">{t("En fazla satır", "Max lines")} <input type="number" min="1" max="4" value="2" data-r="lines" /></label>
                <label class="yt-field">{t("Hedef okuma hızı (KBS)", "Target reading speed (CPS)")} <input type="number" min="5" max="40" step="0.5" value="17" data-r="cps" /></label>
                <label class="yt-field">{t("Üst sınır (KBS)", "Maximum (CPS)")} <input type="number" min="5" max="40" step="0.5" value="20" data-r="cpsMax" /></label>
                <label class="yt-field">{t("En kısa süre (sn)", "Min duration (s)")} <input type="number" min="0.2" max="5" step="0.01" value="0.83" data-r="minDur" /></label>
                <label class="yt-field">{t("En uzun süre (sn)", "Max duration (s)")} <input type="number" min="1" max="20" step="0.5" value="7" data-r="maxDur" /></label>
                <label class="yt-field">{t("En az boşluk (kare)", "Min gap (frames)")} <input type="number" min="0" max="12" value="2" data-r="gapFrames" /></label>
                <label class="yt-field">{t("Kare hızı (fps)", "Frame rate (fps)")}
                  <select data-r="fps">
                    <option>23.976</option><option>24</option><option selected>25</option><option>29.97</option><option>30</option><option>50</option><option>60</option>
                  </select>
                </label>
              </div>
            </fieldset>
            <fieldset>
              <legend>{t("Düzeltilmiş SRT'de", "In the fixed SRT")}</legend>
              <div class="yt-checks">
                <label><input type="checkbox" data-fix="basic" checked disabled /> {t("Numaralandırma, boşluklar, VTT → SRT, UTF-8 (her zaman)", "Numbering, spaces, VTT → SRT, UTF-8 (always)")}</label>
                <label><input type="checkbox" data-fix="mojibake" checked /> {t("Bozuk Türkçe karakterleri onar (örneğin “ÅŸ” → ş, “Ä±” → ı)", "Repair broken characters (e.g. “â€™” → ’, “Ã©” → é)")}</label>
                <label><input type="checkbox" data-fix="overlap" checked /> {t("Çakışmaları ve 2 kareden kısa boşlukları düzelt", "Fix overlaps and gaps shorter than 2 frames")}</label>
                <label><input type="checkbox" data-fix="short" checked /> {t("Çok kısa altyazıları yer varsa uzat", "Extend very short subtitles when there is room")}</label>
                <label><input type="checkbox" data-fix="chain" /> {t("Küçük boşlukları (½ saniyeden kısa) 2 kareye kapat", "Close small gaps (under ½ second) to 2 frames")}</label>
                <label><input type="checkbox" data-fix="balance" /> {t("Tek satıra sığmayan cümleyi iki satıra böl", "Split lines that don't fit over two lines")}</label>
              </div>
            </fieldset>
          </div>
        </div>

        <div data-results hidden>
          <div class="ak-res" data-res>
            <div class="ak-top">
              <div class="yt-h3" style="margin:0">{t("Sonuç", "Result")}</div>
              <div class="ak-stats" data-stats></div>
            </div>
            <p data-summary class="yt-note" aria-live="polite"></p>
            <div class="yt-actions" data-resactions>
              <button type="button" class="ev-btn ev-btn--sun" data-dl>{t("Düzeltilmiş SRT'yi indir", "Download fixed SRT")}</button>
              <label class="ak-only"><input type="checkbox" data-only checked /> {t("Yalnızca sorunlu altyazıları göster", "Show only subtitles with issues")}</label>
            </div>
            <div class="ak-list" data-list>
              <div class="ak-head" aria-hidden="true"><span>{t("Durum", "Status")}</span><span>{t("Zaman", "Time")}</span><span>{t("Metin", "Text")}</span><span>{t("Ölçü", "Stats")}</span><span>{t("Bulgular", "Findings")}</span></div>
              <ol class="ak-rows" data-rows></ol>
            </div>
            <p class="ak-foot" data-foot>{t("Satıra tıklayınca aşağıdaki dikey önizlemede gösterilir. KBS = saniyede karakter (boşluklar dahil).", "Click a row to show it in the vertical preview below. CPS = characters per second (including spaces).")}</p>
          </div>
        </div>

        <div class="yt-tool yt-tool--narrowstage" style="padding:0;border:0;background:none" data-burn>
          <div class="yt-canvaswrap" style="max-width:420px;width:100%;margin-inline:auto">
            <canvas width="1080" height="1920" data-canvas role="img" aria-label={t("Seçili altyazının dikey videoda yakılmış (burn-in) önizlemesi ve platform arayüz alanları", "Burned-in preview of the selected subtitle on vertical video, with platform UI areas")}></canvas>
          </div>
          <div>
            <div class="yt-h3">{t("Yakılmış altyazı önizlemesi (isteğe bağlı)", "Burned-in subtitle preview (optional)")}</div>
            <p class="yt-note">{t("Altyazıyı videoya gömecekseniz (burn-in) konumu ve yazı boyutunu deneyin; yazı platform arayüzünün altında kalırsa uyarı görürsünüz.", "Burning captions into the video? Try the position and font size; you'll get a warning if the text ends up under the platform UI.")}</p>
            <fieldset>
              <legend>{t("Format ve arayüz", "Format and UI")}</legend>
              <div class="yt-chips">
                <label class="yt-chip"><input type="radio" name="fmt" value="v" checked /><span>{t("Dikey 9:16", "Vertical 9:16")}</span></label>
                <label class="yt-chip"><input type="radio" name="fmt" value="h" /><span>{t("Yatay 16:9", "Horizontal 16:9")}</span></label>
              </div>
              <div class="yt-chips" style="margin-top:.6rem" data-platwrap>
                {plats.map((p, i) => (
                  <label class="yt-chip"><input type="radio" name="plat" value={p.id} checked={i === 0} /><span>{p.label}</span></label>
                ))}
              </div>
            </fieldset>
            <div class="yt-fields">
              <label class="yt-field">{t("Yazı boyutu (px)", "Font size (px)")} <input type="range" min="28" max="96" value="54" data-fs /></label>
              <label class="yt-field">{t("Dikey konum (alttan %)", "Vertical position (% from bottom)")} <input type="range" min="5" max="70" value="30" data-pos /></label>
            </div>
            <label class="yt-field" style="margin-top:.8rem">{t("Önizlenen altyazı", "Subtitle to preview")}
              <select data-cue></select>
            </label>
            <label class="yt-field" style="margin-top:.8rem">{t("Arka plan karesi (isteğe bağlı, kendi videonuzdan bir kare)", "Background frame (optional, a still from your video)")}
              <input type="file" accept="image/*" data-bg />
            </label>
            <p class="yt-warn" data-burnwarn aria-live="polite" hidden></p>
            <p class="yt-ok" data-burnok aria-live="polite" hidden></p>
            <div class="yt-actions"><button type="button" class="ev-btn" data-png>{t("Önizlemeyi PNG indir", "Download preview PNG")}</button></div>
          </div>
        </div>
      </div>
      {
  en ? (
    <Fragment>
      <ol class="at-steps" aria-label="How to use">
        <li><strong>Open or paste your file.</strong> .srt or .vtt. UTF-8 and Windows-1252 encodings are detected automatically. Load the sample file to try it.</li>
        <li><strong>Pick the rules.</strong> Netflix English (42 characters, max 20 CPS) or shorter lines for vertical video. Set the frame rate to match your video.</li>
        <li><strong>Fix and download.</strong> Click a flagged subtitle to see it in the vertical preview, then download the fixed SRT as UTF-8.</li>
      </ol>
    </Fragment>
  ) : (
    <Fragment>
<ol class="at-steps" aria-label="Nasıl kullanılır">
        <li><strong>Dosyayı açın ya da yapıştırın.</strong> .srt veya .vtt. UTF-8 ve Windows-1254 (Türkçe) kodlama otomatik tanınır. Denemek için örnek dosyayı yükleyin.</li>
        <li><strong>Kuralları seçin.</strong> Netflix Türkçe (42 karakter, 17 KBS) ya da dikey video için daha kısa satırlar. Kare hızını videonuza göre girin.</li>
        <li><strong>Düzeltin, indirin.</strong> Hatalı altyazılara tıklayıp dikey önizlemede görün; düzeltilmiş SRT'yi UTF-8 olarak indirin.</li>
      </ol>
    </Fragment>
  )
}
    </Section>

    {
  en ? (
    <Fragment>
    <Section width="default" space="tight" id="kurallar">
      <SectionHeading eyebrow="Specs">Subtitle rules at a glance</SectionHeading>
      <div class="yt-tablewrap">
        <table class="yt-table">
          <caption>Source: Netflix Timed Text Style Guides (English USA and General Requirements), accessed 30 Oct 2026. The “Vertical video” column is Rast's recommendation.</caption>
          <thead><tr><th scope="col">Rule</th><th scope="col">Netflix English</th><th scope="col">Vertical video (recommended)</th></tr></thead>
          <tbody>
            <tr><th scope="row">Characters per line</th><td>max 42</td><td>≈ 32</td></tr>
            <tr><th scope="row">Lines</th><td>max 2</td><td>max 2</td></tr>
            <tr><th scope="row">Reading speed (adult)</th><td>max 20 CPS</td><td>≈ 17 CPS</td></tr>
            <tr><th scope="row">Reading speed (children)</th><td>max 17 CPS</td><td>≈ 13 CPS</td></tr>
            <tr><th scope="row">Minimum duration</th><td>5/6 second (≈0.83 s)</td><td>≈ 1 s</td></tr>
            <tr><th scope="row">Maximum duration</th><td>7 seconds</td><td>≈ 5 s</td></tr>
            <tr><th scope="row">Gap between subtitles</th><td>min 2 frames</td><td>min 2 frames</td></tr>
          </tbody>
        </table>
      </div>
      <ul class="yt-tips">
        <li><strong>Most people watch social video on mute.</strong> Place burned-in captions above the post caption, around the middle of the screen, and check the position with the <a href="/en/tools/reels-safe-zone-checker/">Reels safe zone checker</a>.</li>
        <li><strong>Break lines by meaning.</strong> Start the second line with conjunctions like “and”, “but”, “because”; don't split an article from its noun or a preposition from its object.</li>
        <li><strong>Save as UTF-8.</strong> Some old players and TVs expect legacy encodings, but for the web, YouTube and social media UTF-8 is the safe choice.</li>
        <li><strong>Sidecar or burned in?</strong> Upload the SRT as a separate file where the platform supports it (YouTube, Vimeo, LinkedIn); burn captions in for Reels and TikTok if you want full control over the look.</li>
      </ul>
    </Section>
    </Fragment>
  ) : (
    <Fragment>
<Section width="default" space="tight" id="kurallar">
      <SectionHeading eyebrow="Ölçüler">Türkçe altyazıda temel ölçüler</SectionHeading>

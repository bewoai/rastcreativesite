---
/**
 * Free safe-zone checker for 9:16 video (Reels, TikTok, Shorts, Story) + the
 * Reels comment-reply sticker band. 100% client-side: the file never leaves
 * the browser. Zone table: src/data/safe-zones.json (also feeds the static
 * template PNGs, generated by scripts/generate-safe-zone-templates.py).
 * Linkable asset for earned backlinks — keep it useful, no prices.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CcByAttribution from "../CcByAttribution.astro";
import EmbedLayout from "../../../layouts/EmbedLayout.astro";
import EmbedBox from "../EmbedBox.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import Button from "../../../components/Button.astro";
import { PRIMARY_CTA, SITE } from "../../../consts";
import { breadcrumb, faqPage } from "../../../lib/schema";
import ZONES from "../../../data/safe-zones.json";
import ToolHeader from "../../../components/araclar/ToolHeader.astro";
import MoreTools from "../../../components/araclar/MoreTools.astro";
import ToolFaq from "../../../components/araclar/ToolFaq.astro";

const PATH = "/araclar/guvenli-alan/";
const PAGE_URL = new URL(PATH, SITE.url).href;
const title = "Reels, TikTok, Shorts Güvenli Alan Kontrolü";
const description =
  "Ücretsiz Reels güvenli alan kontrolü: videonuzu tarayıcıda açın, Reels, TikTok, Shorts ve Story arayüzünün neyi kapattığını görün. Şeffaf PNG şablonlar.";

const W = ZONES.width;
const H = ZONES.height;
const pct = (v: number, of: number) => `%${((v / of) * 100).toFixed(1).replace(".", ",")}`;
const P = ZONES.platforms;
const combined = {
  label: ZONES.combined.label,
  top: Math.max(...P.map((p) => p.top)),
  bottom: Math.max(...P.map((p) => p.bottom)),
  left: Math.max(...P.map((p) => p.left)),
  right: Math.max(...P.map((p) => p.right)),
};
const rows = [...P, combined, ZONES.metaAds].map((p) => ({
  label: p.label,
  top: p.top,
  bottom: p.bottom,
  left: p.left,
  right: p.right,
  safe: `${W - p.left - p.right} × ${H - p.top - p.bottom}`,
}));
const reels = P[0];

const templates = [
  ...P.map((p) => ({ label: p.label, file: `rast-guvenli-alan-${p.id}-1080x1920.png` })),
  { label: "Reels + yorum yanıtı etiketi", file: "rast-guvenli-alan-instagram-reels-yorum-yaniti-1080x1920.png" },
  { label: "Tüm platformlar (ortak)", file: `rast-guvenli-alan-${ZONES.combined.id}-1080x1920.png` },
];
const TPL = "/araclar/guvenli-alan/";

const faqs = [
  {
    question: "Instagram Reels güvenli alanı kaç piksel?",
    answer: `1080×1920 bir videoda yaklaşık olarak üstten ${reels.top} px, alttan ${reels.bottom} px ve sağdan ${reels.right} px boş bırakın; sağdaki beğeni, yorum ve paylaş sütunu kabaca y ${reels.rail!.y1}–${reels.rail!.y2} px arasındadır. Reklam olarak yayınlanacak Reels için Meta daha geniş bir pay önerir: üstten %14, alttan %35, yanlardan %6.`,
  },
  {
    question: "TikTok güvenli alan şablonu nasıl kullanılır?",
    answer:
      "Şeffaf PNG şablonu indirin, kurgu programınızda (Premiere Pro, After Effects, CapCut, DaVinci Resolve ya da Canva) videonun en üst katmanına koyun. Metin, altyazı ve logoyu yeşil kesikli çerçevenin içinde tutun, dışa aktarmadan önce şablon katmanını kapatın.",
  },
  {
    question: "Videom bir sunucuya yükleniyor mu?",
    answer:
      "Hayır. Dosyanız yalnızca tarayıcınızda açılır ve önizlenir; hiçbir sunucuya gönderilmez, kaydedilmez. Sayfada üçüncü taraf takip kodu da yoktur.",
  },
  {
    question: "Yorum yanıtı olarak çekilen Reels'te yorum etiketi ne kadar ekranda kalıyor?",
    answer:
      "Kendi denemelerimizde yorum etiketi videonun başından sonuna kadar ekranda kaldı. Konumu taşınabildiği için araçta yaklaşık bir kutu olarak gösteriyoruz (varsayılan y 300–560 px). Kanca metnini ve yüzü bu bandın altına planlayın.",
  },
  {
    question: "Şablonları ticari işlerde kullanabilir miyim?",
    answer:
      "Evet. Şablonlar CC BY 4.0 lisanslıdır: müşteri işlerinde, eğitimlerde ve ticari projelerde kullanabilir, uyarlayabilirsiniz. Tek şart atıf: “Güvenli alan şablonu: Rast Creative Studio — rastcreative.com”.",
  },
  {
    question: "Neden kaynaklarda farklı güvenli alan ölçüleri var?",
    answer:
      "Arayüz cihaza, ekran oranına, uygulama sürümüne ve açıklama uzunluğuna göre değişir; reklamlarda ayrıca harekete geçirici buton çıkar. Bu yüzden buradaki değerler yaklaşık ve yuvarlanmıştır. Kritik işlerde videoyu yayınlamadan önce kendi telefonunuzda taslak olarak kontrol edin.",
  },
];

const citeHtml = `<a href="${PAGE_URL}">Güvenli alan kontrolü — Rast Creative</a>`;

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
    { name: "Güvenli alan kontrolü", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Reels / TikTok / Shorts Güvenli Alan Kontrolü",
    alternateName: "Instagram Reels safe zone checker",
    url: PAGE_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "Modern bir web tarayıcısı; JavaScript gerekli",
    isAccessibleForFree: true,
    inLanguage: "tr",
    offers: { "@type": "Offer", price: "0", priceCurrency: "TRY" },
    description,
    featureList: [
      "Görsel ve video önizleme (9:16)",
      "Instagram Reels, TikTok, YouTube Shorts ve Instagram Story arayüz katmanları",
      "Reels yorum yanıtı etiketi bandı",
      "PNG dışa aktarma",
      "CC BY 4.0 şeffaf PNG güvenli alan şablonları",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
    license: "https://creativecommons.org/licenses/by/4.0/deed.tr",
  },
  faqPage(faqs),
];
import { publicFileSize, fileExt } from "../../../lib/filesize";

// ---------- English twin (/en/tools/reels-safe-zone-checker/, src/lib/i18n.ts) ----------
interface Props {
  lang?: "tr" | "en";
  /** /embed/ widget (src/pages/embed/): tool only, minimal chrome, see src/layouts/EmbedLayout.astro. */
  embed?: boolean;
}
const { lang = "tr", embed = false } = Astro.props;
const Layout = embed ? EmbedLayout : BaseLayout;
const en = lang === "en";
/** Inline label in the page language (TR text stays the SEO-tuned original). */
const t = (tr: string, eng: string) => (en ? eng : tr);
const EN_PATH = "/en/tools/reels-safe-zone-checker/";
const EN_URL = new URL(EN_PATH, SITE.url).href;
const pctEn = (v: number, of: number) => `${((v / of) * 100).toFixed(1)}%`;
const tt = P[1];
const sh = P[2];
const EN_LABEL: Record<string, string> = {
  [ZONES.combined.label]: "All platforms (combined safe zone)",
  [ZONES.metaAds.label]: "Meta Reels / Story ads (official)",
};
const EN_NOTE: Record<string, string> = {
  "instagram-reels": "Top: tabs and camera bar. Bottom: username, caption and audio line. Right: like, comment, share and save column.",
  tiktok: "Top: Following / For You tabs. Bottom: username, caption and sound. Right: profile, like, comment, save, share and the sound disc.",
  "youtube-shorts": "Top: search and menu. Bottom: channel name, Subscribe, title and sound. Right: like, dislike, comment, share and remix. Values are rounded to Google's published spec for vertical video ads (288/672/48/192 px).",
  "instagram-story": "Top: progress bar and profile row. Bottom: send-message field and reactions. No right-hand column.",
};
const rowsView = en ? rows.map((r) => ({ ...r, label: EN_LABEL[r.label] ?? r.label })) : rows;
const pctView = en ? pctEn : pct;
const templatesView = en
  ? [
      ...P.map((p) => ({ label: p.label, file: `rast-guvenli-alan-${p.id}-1080x1920.png` })),
      { label: "Reels + comment reply sticker", file: "rast-guvenli-alan-instagram-reels-yorum-yaniti-1080x1920.png" },
      { label: "All platforms (combined)", file: `rast-guvenli-alan-${ZONES.combined.id}-1080x1920.png` },
    ]
  : templates;

const enTitle = "Reels, TikTok & Shorts Safe Zone Checker (Free)";
const enDescription =
  "Free Instagram Reels, TikTok and YouTube Shorts safe zone checker: preview your 9:16 video under each app's UI in the browser and download transparent PNG templates.";
const enFaqs = [
  {
    question: "What is the Instagram Reels safe zone in pixels?",
    answer: `On a 1080×1920 video, keep roughly ${reels.top} px clear at the top, ${reels.bottom} px at the bottom and ${reels.right} px on the right. The like, comment and share column sits at about y ${reels.rail!.y1}–${reels.rail!.y2} px. For Reels ads, Meta recommends a wider margin: 14% at the top, 35% at the bottom and 6% on each side.`,
  },
  {
    question: "What is the TikTok safe zone?",
    answer: `On a 1080×1920 TikTok, keep text about ${tt.top} px from the top, ${tt.bottom} px from the bottom, ${tt.left} px from the left and ${tt.right} px from the right edge. The caption block at the bottom and the action column on the right cover the most. Ads need more room at the bottom for the call-to-action button.`,
  },
  {
    question: "What is the YouTube Shorts safe zone?",
    answer: `Shorts covers more than Reels or TikTok: keep about ${sh.top} px at the top, ${sh.bottom} px at the bottom and ${sh.right} px on the right clear on a 1080×1920 video. These values are rounded from Google's universal safe zone for vertical video ads (288 / 672 / 48 / 192 px).`,
  },
  {
    question: "How do I use a TikTok or Reels safe zone template?",
    answer:
      "Download the transparent PNG and place it on the top track of your timeline in Premiere Pro, After Effects, CapCut, DaVinci Resolve or Canva. Keep titles, captions and logos inside the green dashed frame, then hide or delete the template layer before you export.",
  },
  {
    question: "Is my video uploaded to a server?",
    answer:
      "No. Your file is opened and previewed only in your browser; it is never sent to or stored on a server. The tool itself has no third-party tracking.",
  },
  {
    question: "How long does the comment reply sticker stay on screen in a Reels reply?",
    answer:
      "In our own tests, the comment sticker stayed on screen for the whole video. Because you can move it, the tool shows it as an approximate box (default y 300–560 px). Plan your hook and the speaker's face below that band.",
  },
  {
    question: "Can I use the templates for client and commercial work?",
    answer:
      "Yes. The templates are licensed CC BY 4.0: use and adapt them in client work, courses and commercial projects. The only condition is attribution: “Safe zone template: Rast Creative Studio — rastcreative.com”.",
  },
  {
    question: "Why do different sources give different safe zone sizes?",
    answer:
      "The interface changes with the device, screen ratio, app version and caption length, and ads add a call-to-action button. That's why the values here are approximate and rounded. For important posts, check a draft on your own phone before publishing.",
  },
];
const enCiteHtml = `<a href="${EN_URL}">Reels / TikTok / Shorts safe zone checker — Rast Creative</a>`;
const enJsonLd = [
  breadcrumb([
    { name: "Rast Creative", path: "/" },
    { name: "Free tools", path: "/en/tools/" },
    { name: "Safe zone checker", path: EN_PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Reels / TikTok / Shorts Safe Zone Checker",
    alternateName: ["Instagram Reels safe zone checker", "TikTok safe zone template"],
    url: EN_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "A modern web browser with JavaScript",
    isAccessibleForFree: true,
    inLanguage: "en",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description: enDescription,
    featureList: [
      "Image and video preview (9:16)",
      "Instagram Reels, TikTok, YouTube Shorts and Instagram Story UI overlays",
      "Reels comment reply sticker band",
      "PNG export",
      "Transparent PNG safe zone templates (CC BY 4.0)",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
    license: "https://creativecommons.org/licenses/by/4.0/",
    dateModified: "2026-10-31",
  },
  faqPage(enFaqs),
];
/** Strings used by the client script (canvas labels, warnings). */
const STR = en
  ? {
      safe: "Safe zone ≈",
      top: "Top ≈",
      bottom: "Bottom ≈",
      stickerTitle: "Comment reply sticker",
      stickerSub: "approximate · on screen the whole video",
      creditUrl: "rastcreative.com/en/tools",
      source: EN_URL,
      notRatio: "Your file isn't 9:16 ({w}×{h}). Platforms may crop the edges or add bars; the preview fits it without cropping. Use 1080×1920 for the most accurate result.",
      lowRes: "The ratio is right (9:16) but the resolution is low ({w}×{h}); 1080×1920 is recommended.",
      badType: "This file type isn't supported. Choose a JPG, PNG, WebP, MP4, MOV or WebM file.",
      pause: "Pause",
      play: "Play",
      codec: "The video couldn't be opened. Your browser may not support this codec (e.g. some HEVC .mov files); try an MP4 (H.264).",
      combinedNote: "Combined: the largest top, bottom and side margins of all four platforms. If one video goes everywhere, put your text here.",
      combinedLabel: "All platforms (combined safe zone)",
      // English sample frame (English hook + caption); TR keeps rast-ornek-kare-1080x1920.jpg
      sampleFrame: "/araclar/guvenli-alan/rast-sample-frame-1080x1920.jpg",
      notes: EN_NOTE,
      hook: "Your hook here",
      caption: "Is your caption readable here?",
      own: "Choose your own file",
      copied: "Copied.",
    }
  : {
      safe: "Güvenli alan ≈",
      top: "Üst ≈",
      bottom: "Alt ≈",
      stickerTitle: "Yorum yanıtı etiketi",
      stickerSub: "yaklaşık · video boyunca ekranda",
      creditUrl: "rastcreative.com/araclar/guvenli-alan",
      source: "https://rastcreative.com/araclar/guvenli-alan/",
      notRatio: "Dosyanız 9:16 değil ({w}×{h}). Platformlar kenarları kırpabilir ya da boşluk ekleyebilir; önizlemede dosya kırpılmadan sığdırıldı. En doğru sonuç için 1080×1920 kullanın.",
      lowRes: "Oran doğru (9:16) ama çözünürlük düşük ({w}×{h}); yayında 1080×1920 önerilir.",
      badType: "Bu dosya türü desteklenmiyor. JPG, PNG, WebP, MP4, MOV ya da WebM seçin.",
      pause: "Durdur",
      play: "Oynat",
      codec: "Video açılamadı. Tarayıcınız bu codec'i desteklemiyor olabilir (ör. bazı HEVC .mov dosyaları); MP4 (H.264) deneyin.",
      combinedNote: "Ortak alan: dört platformun en geniş üst, alt ve yan paylarının birleşimi. Tek bir video her yerde yayınlanacaksa metni buraya koyun.",
      combinedLabel: ZONES.combined.label,
      notes: null,
      hook: "Kanca metniniz",
      caption: "Altyazı burada mı okunuyor?",
      own: "Kendi dosyanızı seçin",
      copied: "Kopyalandı.",
    };
---

<Layout title={en ? enTitle : title} description={en ? enDescription : description} jsonLd={embed ? undefined : en ? enJsonLd : jsonLd} full={en ? EN_PATH : PATH}>
  <Section width="wide" space="tight">
{!embed && (
    <ToolHeader
      href={en ? EN_PATH : "/araclar/guvenli-alan/"}
      h1={en ? "Instagram Reels, TikTok & YouTube Shorts safe zone checker" : "Reels, TikTok ve Shorts güvenli alan kontrolü"}
      cta2={{ href: "#sablonlar", label: en ? "Templates (PNG + ZIP)" : "Şablonlar (PNG + ZIP)" }}
    >
      {en ? (
        <p>
          The safe zone is the part of a 9:16 video that the app interface doesn't cover. Your hook, captions or logo can end
          up under the username, caption and like buttons. Drop an image or video and see what each platform's UI covers
          before you post. <strong>Your file is never uploaded</strong>; everything runs in your browser.
        </p>
      ) : (
        <p>
          Dikey videoda yazdığınız kanca cümlesi, altyazı ya da logo; kullanıcı adı, açıklama ve beğeni butonlarının
          altında kalabilir. Görselinizi ya da videonuzu bırakın, her platformun arayüzünün neyi kapattığını
          yayınlamadan önce görün. <strong>Dosyanız hiçbir sunucuya yüklenmez</strong>; her şey tarayıcınızda çalışır.
        </p>
      )}
      
    </ToolHeader>
)}

    <div id="arac" class="tool" data-tool data-i18n={JSON.stringify(STR)}>
      <div class="tool__stage">
        <label class="drop" data-drop>
          <input
            type="file"
            class="sr-only"
            data-file
            accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/webm,.mov"
          />
          <span class="drop__title">{t("Dosya seçin ya da buraya sürükleyin", "Choose a file or drop it here")}</span>
          <span class="drop__hint">{t("Görsel veya video · yalnızca tarayıcınızda açılır", "Image or video · opens only in your browser")}</span>
        </label>
        <button type="button" class="sample" data-sample-frame>{t("Dosyanız yok mu? ", "No file handy? ")}<strong>{t("Örnek kareyle dene", "Try a sample frame")}</strong></button>
        <div class="frame">
          <canvas
            width={W}
            height={H}
            data-canvas
            tabindex="0"
            role="img"
            aria-label={t("9:16 önizleme ve seçili platformun arayüz alanları", "9:16 preview with the selected platform's interface areas")}></canvas>
        </div>
        <p class="warn" data-warn aria-live="polite" hidden></p>
        <div class="player" data-player hidden>
          <button type="button" class="pbtn" data-play aria-label={t("Oynat", "Play")}>{t("Oynat", "Play")}</button>
          <input type="range" min="0" max="1" step="0.01" value="0" data-seek aria-label={t("Videoda konum", "Position in video")} />
          <span class="ptime" data-time>0:00</span>
        </div>
        <noscript><p class="warn">{t("Önizleme için JavaScript gerekli. Aşağıdaki şeffaf PNG şablonları JavaScript olmadan da indirebilirsiniz.", "The preview needs JavaScript. You can still download the transparent PNG templates below without it.")}</p></noscript>
      </div>

      <div class="tool__panel">
        <fieldset>
          <legend>Platform</legend>
          <div class="chips">
            {
              P.map((p, i) => (
                <label class="chip">
                  <input type="radio" name="platform" value={p.id} checked={i === 0} />
                  <span>{p.label}</span>
                </label>
              ))
            }
            <label class="chip">
              <input type="radio" name="platform" value={ZONES.combined.id} />
              <span>{t("Hepsi (ortak alan)", "All (combined)")}</span>
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend>{t("Katmanlar", "Layers")}</legend>
          <div class="checks">
            <label><input type="checkbox" data-opt="zones" checked /> {t("Arayüz alanları", "UI areas")}</label>
            <label><input type="checkbox" data-opt="safe" checked /> {t("Güvenli alan çerçevesi", "Safe zone frame")}</label>
            <label><input type="checkbox" data-opt="mock" checked /> {t("Arayüz siluetleri (kullanıcı adı, açıklama, butonlar)", "UI mock-up (username, caption, buttons)")}</label>
            <label><input type="checkbox" data-opt="sticker" /> {t("Reels yorum yanıtı etiketi ", "Reels comment reply sticker ")}<em>{t("(yaklaşık)", "(approximate)")}</em></label>
          </div>
          <div class="slider" data-sticker-ctl hidden>
            <label for="sticker-y">{t("Etiketin dikey konumu", "Sticker vertical position")}</label>
            <input id="sticker-y" type="range" min="120" max="1300" step="10" value={ZONES.sticker.y1} data-sticker-y />
            <p class="small">{t("Önizlemede etiketi sürükleyebilir ya da bu kaydırıcıyı kullanabilirsiniz.", "Drag the sticker in the preview or use this slider.")}</p>
          </div>
        </fieldset>
        <p class="note" data-note aria-live="polite"></p>
        <div class="actions">
          <button type="button" class="ev-btn ev-btn--sun" data-export>{t("PNG olarak indir", "Download PNG")}</button>
          <button type="button" class="ev-btn" data-clear hidden>{t("Dosyayı kaldır", "Remove file")}</button>
        </div>
        <p class="small">
          {t("İndirilen PNG o anki kareyi ve açık katmanları içerir; alt arayüz bandında küçük bir Rast Creative imzası yer alır.", "The PNG contains the current frame and the visible layers, with a small Rast Creative credit in the bottom UI band.")}
        </p>
      </div>
    </div>
    {
  embed ? null : en ? (
    <Fragment>
    <ol class="at-steps" aria-label="How to use">
      <li><strong>Choose your file.</strong> A JPG, PNG or WebP image, or an MP4, MOV or WebM video. A 1080×1920 (9:16) file gives the most accurate result.</li>
      <li><strong>Pick the platform.</strong> Dark areas are covered by the app, the green frame is the safe zone. Play and scrub the video; the overlays stay on top.</li>
      <li><strong>Fix and export.</strong> Move your text inside the frame, download the frame as a PNG or drop the template into your editor.</li>
    </ol>
    </Fragment>
  ) : (
    <Fragment>
<ol class="at-steps" aria-label="Nasıl kullanılır">
      <li><strong>Dosyanızı seçin.</strong> JPG, PNG, WebP görsel ya da MP4, MOV, WebM video. En doğru sonuç 1080×1920 (9:16) dosyayla alınır.</li>
      <li><strong>Platformu seçin.</strong> Koyu alanlar arayüzün kapladığı yerler, yeşil çerçeve güvenli alan. Videoyu oynatıp kaydırın; katmanlar üstte kalır.</li>
      <li><strong>Düzeltin, indirin.</strong> Metni çerçevenin içine taşıyın; kareyi PNG olarak indirin ya da şablonu kurgu programınıza koyun.</li>
    </ol>
    </Fragment>
  )
}
  </Section>

  {!embed && (
  <Fragment>
  <EmbedBox href={en ? EN_PATH : PATH} />


  {
  en ? (
    <Fragment>
  <Section width="wide" space="tight" id="sablonlar">
    <SectionHeading eyebrow="Download · CC BY 4.0">
      Free transparent PNG safe zone templates (1080×1920)
      <Fragment slot="intro">
        <p>
          Put a template on the top track of your timeline in Premiere Pro, After Effects, CapCut, DaVinci Resolve or Canva,
          keep text inside the green frame and hide the layer before you export. The templates are licensed
          <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC BY 4.0</a>:
          free for commercial work too, the only condition is credit (“Rast Creative Studio — rastcreative.com”).
        </p>
      </Fragment>
    </SectionHeading>
    <p class="yt-small dl-hint">Tap a file to download it. All templates are PNGs that open directly in Canva, CapCut and Photoshop.</p>

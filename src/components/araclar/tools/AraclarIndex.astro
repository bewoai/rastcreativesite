---
/**
 * /araclar/ — visual gallery of Rast's free tools, templates, documents and packs.
 * Data: src/data/araclar.ts. Card previews: public/araclar/kartlar/ (scripts/araclar-kartlar/).
 * The type filter is CSS-only (radio + :has); without :has support every card stays visible.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/Section.astro";
import Button from "../../../components/Button.astro";
import ToolCard from "../../../components/araclar/ToolCard.astro";
import { breadcrumb } from "../../../lib/schema";
import { SITE, PRIMARY_CTA } from "../../../consts";
import { ARACLAR, ARACLAR_EN, TUR_FILTER } from "../../../data/araclar";

const description =
  "Ücretsiz video araçları: güvenli alan kontrolü, bitrate hesaplayıcı, altyazı kontrolü, şablonlar, SFX ve LUT paketleri. Kayıt gerektirmez.";

const counts = Object.fromEntries(TUR_FILTER.map((f) => [f.id, ARACLAR.filter((t) => t.type === f.id).length]));

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Rast Creative ücretsiz araçlar",
    itemListElement: ARACLAR.map((t, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: t.name,
      url: new URL(t.href, SITE.url).href,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Rast Creative ücretsiz video araçları tanıtımı",
    description: "Güvenli alan kontrolü, bitrate hesaplayıcı, altyazı kontrolü, şablonlar, belgeler, SFX ve LUT paketleri: Rast Creative'in ücretsiz araçları 38 saniyede.",
    thumbnailUrl: new URL("/araclar/tanitim/rast-araclar-tanitim-poster.webp", SITE.url).href,
    contentUrl: new URL("/araclar/tanitim/rast-araclar-tanitim.mp4", SITE.url).href,
    uploadDate: "2026-10-31",
    duration: "PT38S",
    publisher: { "@type": "Organization", name: "Rast Creative Studio", url: SITE.url },
  },
];

// ---------- English twin (/en/tools/, src/lib/i18n.ts) ----------
interface Props {
  lang?: "tr" | "en";
}
const { lang = "tr" } = Astro.props;
const en = lang === "en";
const LIST = en ? ARACLAR_EN : ARACLAR;
const enDescription =
  "Free browser tools for video creators: Reels/TikTok/Shorts safe zone checker, video bitrate calculator, aspect ratio crop preview, SRT checker, SFX and LUT packs.";
const enJsonLd = [
  breadcrumb([
    { name: "Rast Creative", path: "/" },
    { name: "Free tools", path: "/en/tools/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Free video creator tools by Rast Creative Studio",
    itemListElement: ARACLAR_EN.map((t, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: t.name,
      url: new URL(t.href, SITE.url).href,
    })),
  },
];
const enFilters = TUR_FILTER.filter((f) => ARACLAR_EN.some((t) => t.type === f.id)).map((f) => ({
  ...f,
  label: f.id === "arac" ? "Tools" : f.id === "paket" ? "Packs" : f.id === "sablon" ? "Templates" : f.id === "belge" ? "Documents" : "Guides",
}));
const filters = en ? enFilters : TUR_FILTER;
const countsView = Object.fromEntries(filters.map((f) => [f.id, LIST.filter((t) => t.type === f.id).length]));
// EN hero visual (the TR promo video has a Turkish voice-over): three English card previews as a collage.
const COLLAGE_ORDER = ["/en/tools/srt-subtitle-checker/", "/en/tools/free-lut-pack/", "/en/tools/reels-safe-zone-checker/"];
const collage = COLLAGE_ORDER.map((h) => ARACLAR_EN.find((t) => t.href === h)).filter((t): t is (typeof ARACLAR_EN)[number] => !!t);

---

<BaseLayout title={en ? "Free Video Tools for Creators" : "Ücretsiz Video ve İçerik Araçları"} description={en ? enDescription : description} jsonLd={en ? enJsonLd : jsonLd}>
  <Section width="wide" space="tight" class="ah">
    <div class="ah__grid">
      {en ? (
      <div class="ah__text">
        <p class="ah__eyebrow"><span aria-hidden="true"></span>{LIST.length} free tools · No sign-up</p>
        <h1>Free tools for <em>video creators</em></h1>
        <p class="ah__sub">
          Check Reels, TikTok and Shorts safe zones, calculate bitrate and file size, preview crops and fix subtitles. Everything
          runs in your browser; your files never leave your device.
        </p>
        <p class="ah__sub"><a href="/araclar/" hreflang="tr" lang="tr">Türkçe: tüm ücretsiz araçlar →</a></p>
      </div>
      ) : (
      <div class="ah__text">
        <p class="ah__eyebrow"><span aria-hidden="true"></span>{ARACLAR.length} ücretsiz araç · Kayıt yok</p>
        <h1>Video ve sosyal medya için <em>ücretsiz araçlar</em></h1>
        <p class="ah__sub">Tarayıcıda çalışır, dosyanız cihazınızdan çıkmaz.</p>
        <p class="ah__sub"><a href="/en/tools/" hreflang="en" lang="en">English: free creator tools →</a></p>
      </div>
      )}
      {en && (
      <div class="ah__collage">
        {collage.map((t, i) => {
          const img = t.card ?? `/araclar/kartlar/${t.slug}`;
          return (
            <a class:list={["ah__shot", `ah__shot--${i + 1}`]} href={t.href}>
              <img src={`${img}.webp`} srcset={`${img}-480.webp 480w, ${img}.webp 960w`} sizes={i === 2 ? "(min-width: 1200px) 400px, 34vw" : "(min-width: 1200px) 320px, 27vw"} width="960" height="720" alt={`${t.name}: preview`} loading="eager" decoding="async" />
              <span>{t.title}</span>
            </a>
          );
        })}
      </div>
      )}
      {!en && (
      <figure class="ah__video">
        <video
          controls
          playsinline
          preload="none"
          width="1280"
          height="720"
          poster="/araclar/tanitim/rast-araclar-tanitim-poster.webp"
          aria-label="Rast Creative ücretsiz araçlar tanıtım videosu (38 sn, seslendirmeli)"
        >
          <source src="/araclar/tanitim/rast-araclar-tanitim.mp4" type="video/mp4" />
        </video>
        <figcaption>38 saniyede tüm araçlar</figcaption>
      </figure>
      )}
    </div>

    <div class="gal">
      <fieldset class="gal__filter">
        <legend class="ev-sr">{en ? "Filter by type" : "Türe göre filtrele"}</legend>
        <label><input type="radio" name="tur" value="hepsi" checked /><span>{en ? "All" : "Tümü"} <small>{LIST.length}</small></span></label>
        {
          filters.map((f) => (
            <label>
              <input type="radio" name="tur" value={f.id} />
              <span>
                {f.label} <small>{countsView[f.id]}</small>
              </span>
            </label>
          ))
        }
      </fieldset>

      <ul class="gal__grid">
        {
          LIST.map((t, i) => (
            <li data-type={t.type}>
              <ToolCard item={t} eager={i < 3} />
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section width="wide" space="tight">
{
  en ? (
    <Fragment>
    <div class="ah-mcp">
      <h2>Use these tools in AI assistants (MCP)</h2>
      <p>
        The safe zone, text position, bitrate, subtitle and export-settings checks are also available as a free remote MCP server,
        Rast Creator Tools. Add the endpoint below to an assistant or client that supports remote MCP servers (Streamable HTTP, no
        sign-in). It stores nothing and each answer links back to the matching tool page.
      </p>
      <pre><code>https://rast-creator-tools-mcp.studio-c25.workers.dev/v1/mcp</code></pre>
      <p class="ah-mcp__legal">
        <a href="/en/tools/creator-tools-mcp-privacy/">Privacy policy</a> · <a href="/en/tools/creator-tools-mcp-terms/">Terms of service</a>
      </p>
    </div>
    <div class="ah-cta">
      <div>
        <h2>Rather have the video made for you?</h2>
        <p>
          Rast Creative Studio is a video production and social media studio based in Serdivan, Sakarya, Türkiye. These are the checks we use there every day. If you
          need a brand film, product video or a steady stream of vertical content, tell us about your project, in English or
          Turkish.
        </p>
      </div>
      <Button href="mailto:studio@rastcreative.com">Email the studio</Button>
    </div>
    </Fragment>
  ) : (
    <Fragment>
    <div class="ah-cta">
      <div>
        <h2>Araçlarla uğraşmak yerine videoyu biz çekelim</h2>
        <p>
          Bu araçlar kendi işimizde her gün kullandığımız kontroller. Çekimden teslime kadar tamamını isterseniz
          <a href="/video-cekimi/">video çekimi</a> ve <a href="/sosyal-medya-icerigi/">sosyal medya içeriği</a> sayfalarına bakın.
        </p>
      </div>
      <Button href={PRIMARY_CTA.href}>Görüşelim</Button>
    </div>
    </Fragment>
  )
}
  </Section>
</BaseLayout>

<style>
  /* ───── Hero ───── */
  .ah__grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .ah__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 3rem;
    }
  }
  .ah__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font: 700 0.78rem/1 var(--font-utility);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ah__eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6a1a;
    box-shadow: 0 0 10px #ff6a1a;
  }
  .ah__text h1 {
    margin: 0;
    max-width: 17ch;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.3rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .ah__text h1 em {
    font-style: italic;
    color: var(--sun-text, #94420f);
  }
  .ah__sub {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
    color: var(--ink-soft);
  }

  /* Promo video */
  .ah__video {
    margin: 0;
  }
  .ah__video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    background: #f3e9df;
    box-shadow:
      0 40px 70px -34px rgba(60, 36, 16, 0.55),
      0 0 0 1px rgba(60, 36, 16, 0.08);
  }
  .ah__video figcaption {
    margin-top: 0.7rem;
    font: 700 0.72rem/1 var(--font-utility);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* EN hero collage (desktop only; phones go straight to the gallery) */
  .ah__collage {
    display: none;
  }
  @media (min-width: 900px) {
    .ah__collage {
      position: relative;
      display: block;
      aspect-ratio: 16 / 11.5;
    }
  }
  .ah__shot {
    position: absolute;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    background: #15120f;
    box-shadow:
      0 34px 60px -30px rgba(60, 36, 16, 0.6),
      0 0 0 1px rgba(60, 36, 16, 0.1);
    transition: transform var(--dur, 280ms) var(--ease-out, ease);
  }
  .ah__shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .ah__shot span {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    padding: 0.36rem 0.7rem;
    border-radius: 999px;
    background: rgba(17, 15, 13, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #f4efe8;
    font: 700 0.72rem/1 var(--font-utility);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ah__shot--1 {
    left: 0;
    top: 0;
    width: 52%;
    transform: rotate(-3deg);
  }
  .ah__shot--2 {
    right: 0;
    top: 0;
    width: 52%;
    transform: rotate(3deg);
  }
  /* back cards: labels on top, away from the front card */
  .ah__shot--1 span,
  .ah__shot--2 span {
    top: 0.7rem;
    bottom: auto;
  }
  .ah__shot--2 span {
    left: auto;
    right: 0.7rem;
  }
  .ah__shot--3 {
    left: 50%;
    bottom: 0;
    width: 56%;
    translate: -50% 0;
    z-index: 1;
  }
  .ah__shot:hover,
  .ah__shot:focus-visible {
    z-index: 2;
    transform: translateY(-4px) rotate(0deg);
  }
  .ah__shot:focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ah__shot {
      transition: none;
    }
  }

  /* ───── Gallery ───── */
  .gal {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .gal__filter {
    display: flex;
    gap: 0.3rem;
    margin: 0 0 1.4rem;
    padding: 0.3rem;
    border: 1px solid var(--edge, rgba(255, 255, 255, 0.62));
    border-radius: 999px;
    background: var(--glass, rgba(250, 246, 240, 0.5));
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .gal__filter::-webkit-scrollbar {
    display: none;
  }
  /* Phones: tabs wrap onto two lines instead of a hidden sideways scroll
     (usability test: nobody found the tabs past the screen edge). */
  @media (max-width: 720px) {
    .gal__filter {
      flex-wrap: wrap;
      width: auto;
      overflow: visible;
      border-radius: 1.4rem;
    }
  }
  .gal__filter label {
    position: relative;
    flex: none;
    cursor: pointer;
  }
  .gal__filter input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .gal__filter span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--ink-soft);
    transition: background var(--dur-fast, 160ms) ease, color var(--dur-fast, 160ms) ease;
  }
  .gal__filter small {
    font: 700 0.72rem/1 var(--font-utility);
    opacity: 0.7;
  }
  .gal__filter label:hover span {
    color: var(--ink);
  }
  .gal__filter input:checked + span {
    background: var(--ink);
    color: var(--on-ink, #faf9f6);
  }
  .gal__filter input:focus-visible + span {
    outline: 2px solid var(--amber);
    outline-offset: 2px;
  }
  .gal__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .gal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .gal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .gal:has(input[value="arac"]:checked) li:not([data-type="arac"]),
  .gal:has(input[value="sablon"]:checked) li:not([data-type="sablon"]),
  .gal:has(input[value="belge"]:checked) li:not([data-type="belge"]),
  .gal:has(input[value="paket"]:checked) li:not([data-type="paket"]),
  .gal:has(input[value="rehber"]:checked) li:not([data-type="rehber"]) {
    display: none;
  }
  .gal:has(.gal__filter input:checked:not([value="hepsi"])) .gal__grid > li {
    animation: gal-in 360ms var(--ease-out, ease) both;
  }
  @keyframes gal-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gal .gal__grid > li {
      animation: none;
    }
  }

  /* ───── CTA ───── */
  .ah-cta {
    display: grid;
    gap: 1.2rem;
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 1.4rem;
    color: var(--on-ink, #faf9f6);
    background:
      radial-gradient(70% 120% at 100% 0%, rgba(226, 83, 3, 0.45), transparent 60%),
      linear-gradient(180deg, #1d1915, #110f0d);
  }
  @media (min-width: 820px) {
    .ah-cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
  .ah-cta h2 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    color: inherit;
  }
  .ah-cta p {
    margin: 0;
    max-width: 60ch;
    color: rgba(250, 249, 246, 0.78);
    line-height: 1.55;
  }
  .ah-cta p a {
    color: #ffb27d;
  }
  .ah-mcp {
    margin: 0 0 2rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--line, rgba(0, 0, 0, 0.12));
    border-radius: 1.2rem;
  }
  .ah-mcp h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
  }
  .ah-mcp p {
    margin: 0 0 0.9rem;
    max-width: 70ch;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .ah-mcp pre {
    margin: 0 0 0.9rem;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    border-radius: 0.7rem;
    background: #1d1915;
    color: #faf9f6;
    font-size: 0.9rem;
  }
  .ah-mcp__legal {
    font-size: 0.95rem;
  }
  .ah-mcp a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-underline-offset: 3px;
  }
</style>

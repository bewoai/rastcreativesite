---
/**
 * Cross-promo card(s) for Rast's free Chrome extensions (Safe Zone Overlay, PixSwap).
 * Dark evren-style card, one per extension; used on the LUT pack and safe-zone pages.
 * Clicks fire cta_click (location + link_location "extension_card") via BaseLayout.
 */
type Ext = "safezone" | "pixswap";
interface Props {
  lang?: "tr" | "en";
  items?: Ext[];
  /** Small heading above the cards (optional). */
  heading?: string;
}
const { lang = "tr", items = ["safezone"], heading } = Astro.props;
const en = lang === "en";

const EXT: Record<Ext, { url: string; icon: string; name: { tr: string; en: string }; text: { tr: string; en: string } }> = {
  safezone: {
    url: "https://chromewebstore.google.com/detail/ainnamnpnmfijhgnknepicoljijpcogp",
    icon: "/araclar/eklentiler/safe-zone-overlay-112.webp",
    name: { en: "Safe Zone Overlay for Reels, TikTok & Shorts", tr: "Reels, TikTok ve Shorts için Güvenli Alan Overlay'i" },
    text: {
      en: "See the Reels, TikTok and Shorts safe zones on top of any video or design in your browser while you edit. Private, no sign-up.",
      tr: "Reels, TikTok ve Shorts güvenli alanını tarayıcıdaki her video ya da tasarımın üstünde görün. Gizli, üyeliksiz.",
    },
  },
  pixswap: {
    url: "https://chromewebstore.google.com/detail/hpmncakodlangcilikdnglbmkpbeaegc",
    icon: "/araclar/eklentiler/pixswap-112.webp",
    name: { en: "PixSwap – Save Image as PNG, JPG & WebP", tr: "PixSwap – Resmi PNG, JPG, WebP Olarak Kaydet" },
    text: {
      en: "Right-click any image to save it as PNG, JPG or WebP at full size, converted on your device. Handy for references and thumbnails.",
      tr: "Herhangi bir resme sağ tıklayın, tam boyutta PNG, JPG ya da WebP kaydedin; dönüşüm cihazınızda yapılır.",
    },
  },
};
const L = en ? "en" : "tr";
---

<aside class="xc" data-link-location="extension_card" aria-label={en ? "Free Chrome extensions by Rast" : "Rast'ın ücretsiz Chrome eklentileri"}>
  {heading && <p class="xc__head">{heading}</p>}
  <div class:list={["xc__grid", { "xc__grid--2": items.length > 1 }]}>
    {
      items.map((k) => {
        const e = EXT[k];
        return (
          <a class="xc__card" href={e.url} target="_blank" rel="noopener" data-cta-location="extension_card">
            <img src={e.icon} width="56" height="56" alt="" loading="lazy" decoding="async" />
            <span class="xc__body">
              <span class="xc__badge">{en ? "Chrome extension · Free" : "Chrome eklentisi · Ücretsiz"}</span>
              <span class="xc__name">{e.name[L]}</span>
              <span class="xc__text">{e.text[L]}</span>
              <span class="xc__btn">
                {en ? "Add to Chrome" : "Chrome'a ekle"}
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                  <path d="M6 3h7v7M13 3 4 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="sr-only">{en ? " (opens Chrome Web Store in a new tab)" : " (Chrome Web Store yeni sekmede açılır)"}</span>
              </span>
            </span>
          </a>
        );
      })
    }
  </div>
</aside>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .xc {
    margin-top: 1.4rem;
  }
  .xc__head {
    margin: 0 0 0.7rem;
    font: 700 0.74rem/1 var(--font-utility);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .xc__grid {
    display: grid;
    gap: 0.9rem;
  }
  .xc__grid:not(.xc__grid--2) {
    max-width: 46rem;
  }
  @media (min-width: 820px) {
    .xc__grid--2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .xc__card {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.2rem;
    border-radius: 1.1rem;
    border: 1px solid rgba(250, 246, 240, 0.13);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(226, 83, 3, 0.16), transparent 55%),
      #0d0b09;
    color: #faf6f0;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .xc__card:hover,
  .xc__card:focus-visible {
    border-color: rgba(255, 106, 26, 0.7);
    transform: translateY(-1px);
  }
  .xc__card img {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(250, 246, 240, 0.06);
  }
  .xc__body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .xc__badge {
    font: 700 0.66rem/1 var(--font-utility);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff8a47;
  }
  .xc__name {
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.25;
    color: #fff;
  }
  .xc__text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(250, 246, 240, 0.72);
  }
  .xc__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    margin-top: 0.35rem;
    padding: 0.5rem 0.85rem;
    min-height: 36px;
    border-radius: 999px;
    background: #ff6a1a;
    color: #120a04;
    font: 700 0.82rem/1 var(--font-utility);
  }
</style>

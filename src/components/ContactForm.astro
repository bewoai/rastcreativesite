---
import Button from "./Button.astro";
import { WEB3FORMS_ACCESS_KEY, SITE } from "../consts";
---

<form id="teklif-formu" class="cform" action="https://api.web3forms.com/submit" method="POST" data-cform>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="Yeni ön görüşme talebi — rastcreative.com" />
  <input type="hidden" name="from_name" value={SITE.name} />
  {/* honeypot — bots fill this; humans never see it */}
  <input type="checkbox" name="botcheck" class="cform__hp" tabindex="-1" autocomplete="off" />

  <div class="cform__row">
    <div class="field">
      <label for="cf-name">Ad Soyad <span class="req" aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" minlength="2" required />
    </div>
    <div class="field">
      <label for="cf-company">Firma</label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" />
    </div>
  </div>

  <div class="cform__row">
    <div class="field">
      <label for="cf-phone">Telefon <span class="req" aria-hidden="true">*</span></label>
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        minlength="10"
        required
        aria-describedby="cf-phone-hint"
      />
      <span id="cf-phone-hint" class="hint">Size en hızlı telefonla dönüş yaparız.</span>
    </div>
    <div class="field">
      <label for="cf-email">E-posta <span class="req" aria-hidden="true">*</span></label>
      <input
        id="cf-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
        aria-describedby="cf-email-hint"
      />
      <span id="cf-email-hint" class="hint">Teklif ve detayları e-posta ile paylaşırız.</span>
    </div>
  </div>

  <div class="field">
    <label for="cf-project">Proje türü <span class="req" aria-hidden="true">*</span></label>
    <select id="cf-project" name="project_type" required>
      <option value="" disabled selected>Seçin…</option>
      <option value="Kurumsal / Tanıtım Filmi">Kurumsal / Tanıtım Filmi</option>
      <option value="Reklam Filmi">Reklam Filmi</option>
      <option value="Drone Çekimi">Drone Çekimi</option>
      <option value="Sosyal Medya / Reels">Sosyal Medya / Reels</option>
      <option value="Ürün & Mekan Çekimi">Ürün & Mekan Çekimi</option>
      <option value="Marka Hikayesi">Marka Hikayesi</option>
      <option value="Medikal">Medikal</option>
      <option value="Düğün & Organizasyon">Düğün & Organizasyon</option>
      <option value="Diğer">Diğer</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Mesajınız <span class="req" aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="message" rows="5" minlength="10" required></textarea>
  </div>

  <p class="consent-note">
    Formu göndererek <a href="/kvkk" target="_blank" rel="noopener">KVKK Aydınlatma
    Metni</a>'ni okuduğunuzu ve kişisel verilerinizin iletişim amacıyla işlenmesine
    izin verdiğinizi kabul etmiş sayılırsınız.
  </p>

  <div class="cform__status" data-status role="status" aria-live="polite"></div>

  <div class="cform__actions">
    <Button type="submit" size="lg" class="cform__submit">Gönder</Button>
  </div>
</form>

<style>
  .cform {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .cform__hp {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .cform__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  label {
    font-family: var(--font-utility);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink);
  }
  .req {
    color: var(--amber-text);
  }
  .hint {
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  input[type="text"],
  input[type="tel"],
  input[type="email"],
  select,
  textarea {
    font: inherit;
    font-size: 1rem;
    min-height: var(--tap-min);
    padding: 0.75rem 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  textarea {
    min-height: 8rem;
    resize: vertical;
    line-height: var(--leading-body);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--amber);
    box-shadow: var(--focus-ring);
  }
  input:user-invalid,
  select:user-invalid,
  textarea:user-invalid {
    border-color: #b42318;
  }
  .consent-note {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .consent-note a {
    color: var(--amber-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cform__status {
    font-size: 0.95rem;
  }
  .cform__status.is-pending {
    color: var(--ink-soft);
  }
  .cform__status.is-ok {
    color: #1a7f37;
    font-weight: 600;
  }
  .cform__status.is-err {
    color: #b42318;
    font-weight: 600;
  }
  .cform__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: stretch;
  }
  @media (min-width: 560px) {
    .cform__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  type RcTrack = (
    eventName: string,
    eventParams?: Record<string, unknown>,
    callback?: () => void,
  ) => void;

  const trackEvent = (
    eventName: string,
    eventParams?: Record<string, unknown>,
    callback?: () => void,
  ) => {
    const rcTrack = (window as Window & { rcTrack?: RcTrack }).rcTrack;
    if (typeof rcTrack === "function") {
      rcTrack(eventName, eventParams, callback);
      return;
    }
    callback?.();
  };

  const form = document.querySelector<HTMLFormElement>("[data-cform]");
  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]");
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const setStatus = (text: string, state: "pending" | "ok" | "err") => {
      if (status) {
        status.textContent = text;
        status.className = `cform__status is-${state}`;
      }
    };

    const requiredTextFields = ["#cf-name", "#cf-phone", "#cf-email", "#cf-project", "#cf-message"];
    const validateForm = () => {
      for (const selector of requiredTextFields) {
        const field = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(selector);
        if (!field) continue;
        field.setCustomValidity(field.value.trim() ? "" : "Bu alanı doldurun.");
      }

      if (!form.checkValidity()) {
        setStatus("Göndermek için yıldızlı alanların tamamını doldurun.", "err");
        form.reportValidity();
        return false;
      }
      return true;
    };

    form.addEventListener("input", (event) => {
      const field = event.target;
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLSelectElement ||
        field instanceof HTMLTextAreaElement
      ) {
        if (field.value.trim()) field.setCustomValidity("");
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validateForm()) return;
      if (submit) submit.disabled = true;
      setStatus("Gönderiliyor…", "pending");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          form.reset();
          setStatus("Teşekkürler! Mesajınız ulaştı, en kısa sürede dönüş yapacağız.", "ok");
          trackEvent(
            "lead_form_submit_success",
            {
              event_category: "lead",
              event_label: "contact_form",
              form_id: "contact_form",
            },
            () => {
              window.location.href = "/tesekkurler";
            },
          );
        } else {
          setStatus(json.message ?? "Gönderilemedi. Lütfen tekrar deneyin.", "err");
        }
      } catch {
        setStatus("Bağlantı hatası. Lütfen tekrar deneyin.", "err");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

---
/**
 * /araclar/en-boy-orani/ — aspect ratio & crop previewer. 100% client-side.
 * Shows how a 16:9 (or any) video/image looks cropped to 9:16, 4:5, 1:1, 3:4,
 * draggable crop, FFmpeg crop line, PNG downloads (cropped still, crop frame).
 * Static overlays: scripts/generate-creator-templates.py.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Extras from "./_yaratici/Extras.astro";
import { SITE } from "../../consts";
import { breadcrumb, faqPage } from "../../lib/schema";
import "./_yaratici/tool.css";
import ToolHeader from "../../components/araclar/ToolHeader.astro";

const PATH = "/araclar/en-boy-orani/";
const PAGE_URL = new URL(PATH, SITE.url).href;
const title = "En-Boy Oranı ve Kırpma: 16:9 → 9:16, 4:5, 1:1";
const description =
  "Ücretsiz en-boy oranı aracı: yatay videonuzun 9:16, 4:5, 1:1 ve 3:4 kırpmada nasıl görüneceğini görün, kadrajı sürükleyin, kırpma çerçevesini PNG indirin.";

const RATIOS = [
  { id: "9x16", label: "9:16", w: 9, h: 16, use: "Reels, TikTok, Shorts, Story" },
  { id: "4x5", label: "4:5", w: 4, h: 5, use: "Instagram/Facebook akış gönderisi" },
  { id: "3x4", label: "3:4", w: 3, h: 4, use: "Instagram profil ızgarası, 3:4 gönderi" },
  { id: "1x1", label: "1:1", w: 1, h: 1, use: "Kare gönderi, LinkedIn, reklam" },
  { id: "16x9", label: "16:9", w: 16, h: 9, use: "YouTube, web, TV" },
  { id: "4x3", label: "4:3", w: 4, h: 3, use: "Eski ekranlar, bazı sunumlar" },
];

// 1920x1080 source → centre crop sizes (exact arithmetic, shown in the table)
const fit = (rw: number, rh: number, W = 1920, H = 1080) => {
  const cw = Math.round((H * rw) / rh);
  return cw <= W ? { w: cw, h: H } : { w: W, h: Math.round((W * rh) / rw) };
};
const TABLE = RATIOS.filter((r) => r.id !== "16x9").map((r) => {
  const c = fit(r.w, r.h);
  const c4k = fit(r.w, r.h, 3840, 2160);
  const keep = Math.round(((c.w * c.h) / (1920 * 1080)) * 100);
  return { ...r, c, c4k, keep };
});

const TPL = PATH;
const templates = [
  { file: "rast-kirpma-cerceveleri-16x9-1920x1080.png", label: "Tüm çerçeveler (16:9 üstünde)" },
  { file: "rast-kirpma-16x9-to-9x16-1920x1080.png", label: "16:9 → 9:16 maske" },
  { file: "rast-kirpma-16x9-to-4x5-1920x1080.png", label: "16:9 → 4:5 maske" },
  { file: "rast-kirpma-16x9-to-3x4-1920x1080.png", label: "16:9 → 3:4 maske" },
  { file: "rast-kirpma-16x9-to-1x1-1920x1080.png", label: "16:9 → 1:1 maske" },
];

const faqs = [
  {
    question: "16:9 bir videoyu 9:16'ya kırpınca ne kadarı kalır?",
    answer:
      "1920×1080 bir karede 9:16 kırpma 608×1080 piksellik dikey bir şerit bırakır; görüntünün yaklaşık üçte biri (%32) kalır, kalan kısım kenarlardan atılır. 4:5'te 864×1080 (%45), 1:1'de 1080×1080 (%56) kalır.",
  },
  {
    question: "Full HD çekimden dikey video yaparsam kalite düşer mi?",
    answer:
      "Evet, belirgin biçimde. 1080p yatay kayıttan alınan 9:16 şerit 608×1080 pikseldir; 1080×1920'ye büyütülünce yaklaşık 1,8 kat ölçeklenir ve yumuşar. Aynı içerik hem yatay hem dikey yayınlanacaksa 4K (3840×2160) çekin: 9:16 şerit 1215×2160 olur ve 1080×1920'ye küçültülerek temiz kalır.",
  },
  {
    question: "Videom bir sunucuya yükleniyor mu?",
    answer:
      "Hayır. Dosya yalnızca tarayıcınızda açılır, kırpma önizlemesi ve indirilen PNG'ler de tarayıcınızda oluşturulur. Hiçbir sunucuya gönderilmez, sayfada üçüncü taraf takip kodu yoktur.",
  },
  {
    question: "Aracın verdiği FFmpeg satırını nasıl kullanırım?",
    answer:
      "Terminalde videonun bulunduğu klasöre geçip satırı çalıştırın; girdi.mp4 yerine kendi dosya adınızı yazın. crop filtresi seçtiğiniz kadrajı keser, scale filtresi hedef çözünürlüğe (ör. 1080×1920) getirir, ses olduğu gibi kopyalanır. Kurgu programında aynı sonucu sekans ayarını 1080×1920 yapıp klibi konumlandırarak da alabilirsiniz.",
  },
  {
    question: "Kırpma çerçevesi PNG'sini nerede kullanırım?",
    answer:
      "Şeffaf PNG'yi Premiere Pro, DaVinci Resolve, Final Cut ya da CapCut'ta 16:9 zaman çizelgenizin en üst katmanına koyun. Koyu alan dikey kırpmada kaybolacak kısımdır; çekimde ya da kurguda önemli şeyleri parlak alanın içinde tutun. Dışa aktarmadan önce katmanı kapatın.",
  },
  {
    question: "Hareketli konu varsa tek bir kırpma yeterli mi?",
    answer:
      "Çoğu zaman hayır. Konu kadrajda yürüyorsa kurgu programında kırpma konumunu anahtar karelerle (keyframe) taşıyın ya da Premiere Pro'daki Auto Reframe, DaVinci Resolve'daki Smart Reframe gibi otomatik takip özelliklerini kullanın. Bu araç tek kare ya da sabit kadraj için hızlı kontrol sağlar.",
  },
];

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
    { name: "En-boy oranı ve kırpma", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "En-Boy Oranı ve Kırpma Önizleme",
    alternateName: "Aspect ratio crop previewer (16:9 to 9:16, 4:5, 1:1, 3:4)",
    url: PAGE_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "Modern bir web tarayıcısı; JavaScript gerekli",
    isAccessibleForFree: true,
    inLanguage: "tr",
    offers: { "@type": "Offer", price: "0", priceCurrency: "TRY" },
    description,
    featureList: [
      "Görsel ve video önizleme",
      "9:16, 4:5, 3:4, 1:1, 16:9, 4:3 ve özel oran",
      "Sürüklenebilir kırpma kadrajı ve yakınlaştırma",
      "Kırpılmış kare ve şeffaf kırpma çerçevesi PNG indirme",
      "FFmpeg crop komutu",
      "CC BY 4.0 kırpma maskeleri",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
    license: "https://creativecommons.org/licenses/by/4.0/deed.tr",
  },
  faqPage(faqs),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="yt-page">
    <Section width="wide" space="tight">
      <ToolHeader
        href="/araclar/en-boy-orani/"
        h1="En-boy oranı ve kırpma önizleme"
      >

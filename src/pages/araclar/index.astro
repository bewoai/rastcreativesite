---
/**
 * /araclar/ — visual gallery of Rast's free tools, templates, documents and packs.
 * Data: src/data/araclar.ts. Card previews: public/araclar/kartlar/ (scripts/araclar-kartlar/).
 * The type filter is CSS-only (radio + :has); without :has support every card stays visible.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import ToolCard from "../../components/araclar/ToolCard.astro";
import { breadcrumb } from "../../lib/schema";
import { SITE, PRIMARY_CTA } from "../../consts";
import { ARACLAR, TUR_FILTER } from "../../data/araclar";

const description =
  "Rast Creative Studio'nun ücretsiz araçları: güvenli alan kontrolü, bitrate hesaplayıcı, altyazı kontrolü, export rehberi, storyboard ve brief şablonları, SFX ve LUT paketleri. Kayıt gerektirmez.";

const counts = Object.fromEntries(TUR_FILTER.map((f) => [f.id, ARACLAR.filter((t) => t.type === f.id).length]));

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Rast Creative ücretsiz araçlar",
    itemListElement: ARACLAR.map((t, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: t.name,
      url: new URL(t.href, SITE.url).href,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Rast Creative ücretsiz video araçları tanıtımı",
    description: "Güvenli alan kontrolü, bitrate hesaplayıcı, altyazı kontrolü, şablonlar, belgeler, SFX ve LUT paketleri: Rast Creative'in ücretsiz araçları 38 saniyede.",
    thumbnailUrl: new URL("/araclar/tanitim/rast-araclar-tanitim-poster.webp", SITE.url).href,
    contentUrl: new URL("/araclar/tanitim/rast-araclar-tanitim.mp4", SITE.url).href,
    uploadDate: "2026-10-31",
    duration: "PT38S",
    publisher: { "@type": "Organization", name: "Rast Creative Studio", url: SITE.url },
  },
];
---

<BaseLayout title="Ücretsiz Video ve İçerik Araçları" description={description} jsonLd={jsonLd}>
  <Section width="wide" space="tight" class="ah">
    <div class="ah__grid">
      <div class="ah__text">
        <p class="ah__eyebrow"><span aria-hidden="true"></span>{ARACLAR.length} ücretsiz araç · Kayıt yok</p>
        <h1>Video ve sosyal medya için <em>ücretsiz araçlar</em></h1>
        <p class="ah__sub">Tarayıcıda çalışır, dosyanız bilgisayarınızdan çıkmaz.</p>
      </div>
      <figure class="ah__video">
        <video
          controls
          playsinline
          preload="none"
          width="1280"
          height="720"
          poster="/araclar/tanitim/rast-araclar-tanitim-poster.webp"
          aria-label="Rast Creative ücretsiz araçlar tanıtım videosu (38 sn, seslendirmeli)"
        >
          <source src="/araclar/tanitim/rast-araclar-tanitim.mp4" type="video/mp4" />
        </video>
        <figcaption>38 saniyede tüm araçlar</figcaption>
      </figure>
    </div>

    <div class="gal">
      <fieldset class="gal__filter">
        <legend class="ev-sr">Türe göre filtrele</legend>
        <label><input type="radio" name="tur" value="hepsi" checked /><span>Tümü <small>{ARACLAR.length}</small></span></label>
        {
          TUR_FILTER.map((f) => (
            <label>
              <input type="radio" name="tur" value={f.id} />
              <span>
                {f.label} <small>{counts[f.id]}</small>
              </span>
            </label>
          ))
        }
      </fieldset>

      <ul class="gal__grid">
        {
          ARACLAR.map((t, i) => (
            <li data-type={t.type}>
              <ToolCard item={t} eager={i < 3} />
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section width="wide" space="tight">
    <div class="ah-cta">
      <div>
        <h2>Araçlarla uğraşmak yerine videoyu biz çekelim</h2>
        <p>
          Bu araçlar kendi işimizde her gün kullandığımız kontroller. Çekimden teslime kadar tamamını isterseniz
          <a href="/video-cekimi/">video çekimi</a> ve <a href="/sosyal-medya-icerigi/">sosyal medya içeriği</a> sayfalarına bakın.
        </p>
      </div>
      <Button href={PRIMARY_CTA.href}>Görüşelim</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ───── Hero ───── */
  .ah__grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .ah__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 3rem;
    }
  }
  .ah__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font: 700 0.78rem/1 var(--font-utility);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ah__eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6a1a;
    box-shadow: 0 0 10px #ff6a1a;
  }
  .ah__text h1 {
    margin: 0;
    max-width: 17ch;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.3rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .ah__text h1 em {
    font-style: italic;
    color: var(--sun-text, #94420f);
  }
  .ah__sub {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
    color: var(--ink-soft);
  }

  /* Promo video */
  .ah__video {
    margin: 0;
  }
  .ah__video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    background: #f3e9df;
    box-shadow:
      0 40px 70px -34px rgba(60, 36, 16, 0.55),
      0 0 0 1px rgba(60, 36, 16, 0.08);
  }
  .ah__video figcaption {
    margin-top: 0.7rem;
    font: 700 0.72rem/1 var(--font-utility);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* ───── Gallery ───── */
  .gal {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .gal__filter {
    display: flex;
    gap: 0.3rem;
    margin: 0 0 1.4rem;
    padding: 0.3rem;
    border: 1px solid var(--edge, rgba(255, 255, 255, 0.62));
    border-radius: 999px;
    background: var(--glass, rgba(250, 246, 240, 0.5));
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .gal__filter::-webkit-scrollbar {
    display: none;
  }
  .gal__filter label {
    position: relative;
    flex: none;
    cursor: pointer;
  }
  .gal__filter input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .gal__filter span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--ink-soft);
    transition: background var(--dur-fast, 160ms) ease, color var(--dur-fast, 160ms) ease;
  }
  .gal__filter small {
    font: 700 0.72rem/1 var(--font-utility);
    opacity: 0.7;
  }
  .gal__filter label:hover span {
    color: var(--ink);
  }
  .gal__filter input:checked + span {
    background: var(--ink);
    color: var(--on-ink, #faf9f6);
  }
  .gal__filter input:focus-visible + span {
    outline: 2px solid var(--amber);
    outline-offset: 2px;
  }
  .gal__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .gal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .gal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .gal:has(input[value="arac"]:checked) li:not([data-type="arac"]),
  .gal:has(input[value="sablon"]:checked) li:not([data-type="sablon"]),
  .gal:has(input[value="belge"]:checked) li:not([data-type="belge"]),
  .gal:has(input[value="paket"]:checked) li:not([data-type="paket"]),
  .gal:has(input[value="rehber"]:checked) li:not([data-type="rehber"]) {
    display: none;
  }
  .gal:has(.gal__filter input:checked:not([value="hepsi"])) .gal__grid > li {
    animation: gal-in 360ms var(--ease-out, ease) both;
  }
  @keyframes gal-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gal .gal__grid > li {
      animation: none;
    }
  }

  /* ───── CTA ───── */
  .ah-cta {
    display: grid;
    gap: 1.2rem;
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 1.4rem;
    color: var(--on-ink, #faf9f6);
    background:
      radial-gradient(70% 120% at 100% 0%, rgba(226, 83, 3, 0.45), transparent 60%),
      linear-gradient(180deg, #1d1915, #110f0d);
  }
  @media (min-width: 820px) {
    .ah-cta {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
  .ah-cta h2 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    color: inherit;
  }
  .ah-cta p {
    margin: 0;
    max-width: 60ch;
    color: rgba(250, 249, 246, 0.78);
    line-height: 1.55;
  }
  .ah-cta p a {
    color: #ffb27d;
  }
</style>

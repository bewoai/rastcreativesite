---
/**
 * Free safe-zone checker for 9:16 video (Reels, TikTok, Shorts, Story) + the
 * Reels comment-reply sticker band. 100% client-side: the file never leaves
 * the browser. Zone table: src/data/safe-zones.json (also feeds the static
 * template PNGs, generated by scripts/generate-safe-zone-templates.py).
 * Linkable asset for earned backlinks — keep it useful, no prices.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Button from "../../components/Button.astro";
import { PRIMARY_CTA, SITE } from "../../consts";
import { breadcrumb, faqPage } from "../../lib/schema";
import ZONES from "../../data/safe-zones.json";
import ToolHeader from "../../components/araclar/ToolHeader.astro";
import MoreTools from "../../components/araclar/MoreTools.astro";
import ToolFaq from "../../components/araclar/ToolFaq.astro";

const PATH = "/araclar/guvenli-alan/";
const PAGE_URL = new URL(PATH, SITE.url).href;
const title = "Reels, TikTok, Shorts Güvenli Alan Kontrolü";
const description =
  "Ücretsiz Reels güvenli alan kontrolü: videonuzu tarayıcıda açın, Reels, TikTok, Shorts ve Story arayüzünün neyi kapattığını görün. Şeffaf PNG şablonlar.";

const W = ZONES.width;
const H = ZONES.height;
const pct = (v: number, of: number) => `%${((v / of) * 100).toFixed(1).replace(".", ",")}`;
const P = ZONES.platforms;
const combined = {
  label: ZONES.combined.label,
  top: Math.max(...P.map((p) => p.top)),
  bottom: Math.max(...P.map((p) => p.bottom)),
  left: Math.max(...P.map((p) => p.left)),
  right: Math.max(...P.map((p) => p.right)),
};
const rows = [...P, combined, ZONES.metaAds].map((p) => ({
  label: p.label,
  top: p.top,
  bottom: p.bottom,
  left: p.left,
  right: p.right,
  safe: `${W - p.left - p.right} × ${H - p.top - p.bottom}`,
}));
const reels = P[0];

const templates = [
  ...P.map((p) => ({ label: p.label, file: `rast-guvenli-alan-${p.id}-1080x1920.png` })),
  { label: "Reels + yorum yanıtı etiketi", file: "rast-guvenli-alan-instagram-reels-yorum-yaniti-1080x1920.png" },
  { label: "Tüm platformlar (ortak)", file: `rast-guvenli-alan-${ZONES.combined.id}-1080x1920.png` },
];
const TPL = "/araclar/guvenli-alan/";

const faqs = [
  {
    question: "Instagram Reels güvenli alanı kaç piksel?",
    answer: `1080×1920 bir videoda yaklaşık olarak üstten ${reels.top} px, alttan ${reels.bottom} px ve sağdan ${reels.right} px boş bırakın; sağdaki beğeni, yorum ve paylaş sütunu kabaca y ${reels.rail!.y1}–${reels.rail!.y2} px arasındadır. Reklam olarak yayınlanacak Reels için Meta daha geniş bir pay önerir: üstten %14, alttan %35, yanlardan %6.`,
  },
  {
    question: "TikTok güvenli alan şablonu nasıl kullanılır?",
    answer:
      "Şeffaf PNG şablonu indirin, kurgu programınızda (Premiere Pro, After Effects, CapCut, DaVinci Resolve ya da Canva) videonun en üst katmanına koyun. Metin, altyazı ve logoyu yeşil kesikli çerçevenin içinde tutun, dışa aktarmadan önce şablon katmanını kapatın.",
  },
  {
    question: "Videom bir sunucuya yükleniyor mu?",
    answer:
      "Hayır. Dosyanız yalnızca tarayıcınızda açılır ve önizlenir; hiçbir sunucuya gönderilmez, kaydedilmez. Sayfada üçüncü taraf takip kodu da yoktur.",
  },
  {
    question: "Yorum yanıtı olarak çekilen Reels'te yorum etiketi ne kadar ekranda kalıyor?",
    answer:
      "Kendi denemelerimizde yorum etiketi videonun başından sonuna kadar ekranda kaldı. Konumu taşınabildiği için araçta yaklaşık bir kutu olarak gösteriyoruz (varsayılan y 300–560 px). Kanca metnini ve yüzü bu bandın altına planlayın.",
  },
  {
    question: "Şablonları ticari işlerde kullanabilir miyim?",
    answer:
      "Evet. Şablonlar CC BY 4.0 lisanslıdır: müşteri işlerinde, eğitimlerde ve ticari projelerde kullanabilir, uyarlayabilirsiniz. Tek şart atıf: “Güvenli alan şablonu: Rast Creative Studio — rastcreative.com”.",
  },
  {
    question: "Neden kaynaklarda farklı güvenli alan ölçüleri var?",
    answer:
      "Arayüz cihaza, ekran oranına, uygulama sürümüne ve açıklama uzunluğuna göre değişir; reklamlarda ayrıca harekete geçirici buton çıkar. Bu yüzden buradaki değerler yaklaşık ve yuvarlanmıştır. Kritik işlerde videoyu yayınlamadan önce kendi telefonunuzda taslak olarak kontrol edin.",
  },
];

const citeHtml = `<a href="${PAGE_URL}">Güvenli alan kontrolü — Rast Creative</a>`;

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araçlar", path: "/araclar/" },
    { name: "Güvenli alan kontrolü", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Reels / TikTok / Shorts Güvenli Alan Kontrolü",
    alternateName: "Instagram Reels safe zone checker",
    url: PAGE_URL,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    browserRequirements: "Modern bir web tarayıcısı; JavaScript gerekli",
    isAccessibleForFree: true,
    inLanguage: "tr",
    offers: { "@type": "Offer", price: "0", priceCurrency: "TRY" },
    description,
    featureList: [
      "Görsel ve video önizleme (9:16)",
      "Instagram Reels, TikTok, YouTube Shorts ve Instagram Story arayüz katmanları",
      "Reels yorum yanıtı etiketi bandı",
      "PNG dışa aktarma",
      "CC BY 4.0 şeffaf PNG güvenli alan şablonları",
    ],
    provider: { "@id": `${SITE.url}#business` },
    creator: { "@id": `${SITE.url}#business` },
    license: "https://creativecommons.org/licenses/by/4.0/deed.tr",
  },
  faqPage(faqs),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Section width="wide" space="tight">
    <ToolHeader
      href="/araclar/guvenli-alan/"
      h1="Reels, TikTok ve Shorts güvenli alan kontrolü"
      cta2={{ href: "#sablonlar", label: "Şablonlar (PNG + ZIP)" }}
    >
        <p>
          Dikey videoda yazdığınız kanca cümlesi, altyazı ya da logo; kullanıcı adı, açıklama ve beğeni butonlarının
          altında kalabilir. Görselinizi ya da videonuzu bırakın, her platformun arayüzünün neyi kapattığını
          yayınlamadan önce görün. <strong>Dosyanız hiçbir sunucuya yüklenmez</strong>; her şey tarayıcınızda çalışır.
        </p>
      
    </ToolHeader>

    <div id="arac" class="tool" data-tool>
      <div class="tool__stage">
        <label class="drop" data-drop>
          <input
            type="file"
            class="sr-only"
            data-file
            accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/webm,.mov"
          />
          <span class="drop__title">Dosya seçin ya da buraya sürükleyin</span>
          <span class="drop__hint">Görsel veya video · yalnızca tarayıcınızda açılır</span>
        </label>
        <div class="frame">
          <canvas
            width={W}
            height={H}
            data-canvas
            tabindex="0"
            role="img"
            aria-label="9:16 önizleme ve seçili platformun arayüz alanları"></canvas>
        </div>
        <p class="warn" data-warn aria-live="polite" hidden></p>
        <div class="player" data-player hidden>
          <button type="button" class="pbtn" data-play aria-label="Oynat">Oynat</button>
          <input type="range" min="0" max="1" step="0.01" value="0" data-seek aria-label="Videoda konum" />
          <span class="ptime" data-time>0:00</span>
        </div>
        <noscript><p class="warn">Önizleme için JavaScript gerekli. Aşağıdaki şeffaf PNG şablonları JavaScript olmadan da indirebilirsiniz.</p></noscript>
      </div>

      <div class="tool__panel">
        <fieldset>
          <legend>Platform</legend>
          <div class="chips">
            {
              P.map((p, i) => (
                <label class="chip">
                  <input type="radio" name="platform" value={p.id} checked={i === 0} />
                  <span>{p.label}</span>
                </label>
              ))
            }
            <label class="chip">
              <input type="radio" name="platform" value={ZONES.combined.id} />
              <span>Hepsi (ortak alan)</span>
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Katmanlar</legend>
          <div class="checks">
            <label><input type="checkbox" data-opt="zones" checked /> Arayüz alanları</label>
            <label><input type="checkbox" data-opt="safe" checked /> Güvenli alan çerçevesi</label>
            <label><input type="checkbox" data-opt="mock" checked /> Arayüz siluetleri (kullanıcı adı, açıklama, butonlar)</label>
            <label><input type="checkbox" data-opt="sticker" /> Reels yorum yanıtı etiketi <em>(yaklaşık)</em></label>
          </div>
          <div class="slider" data-sticker-ctl hidden>
            <label for="sticker-y">Etiketin dikey konumu</label>
            <input id="sticker-y" type="range" min="120" max="1300" step="10" value={ZONES.sticker.y1} data-sticker-y />
            <p class="small">Önizlemede etiketi sürükleyebilir ya da bu kaydırıcıyı kullanabilirsiniz.</p>
          </div>
        </fieldset>
        <p class="note" data-note aria-live="polite"></p>
        <div class="actions">
          <button type="button" class="ev-btn ev-btn--sun" data-export>PNG olarak indir</button>
          <button type="button" class="ev-btn" data-clear hidden>Dosyayı kaldır</button>
        </div>
        <p class="small">
          İndirilen PNG o anki kareyi ve açık katmanları içerir; alt arayüz bandında küçük bir Rast Creative imzası yer alır.
        </p>
      </div>
    </div>
    <ol class="at-steps" aria-label="Nasıl kullanılır">
      <li><strong>Dosyanızı seçin.</strong> JPG, PNG, WebP görsel ya da MP4, MOV, WebM video. En doğru sonuç 1080×1920 (9:16) dosyayla alınır.</li>
      <li><strong>Platformu seçin.</strong> Koyu alanlar arayüzün kapladığı yerler, yeşil çerçeve güvenli alan. Videoyu oynatıp kaydırın; katmanlar üstte kalır.</li>
      <li><strong>Düzeltin, indirin.</strong> Metni çerçevenin içine taşıyın; kareyi PNG olarak indirin ya da şablonu kurgu programınıza koyun.</li>
    </ol>
  </Section>

  <Section width="wide" space="tight" id="sablonlar">
    <SectionHeading eyebrow="İndir · CC BY 4.0">
      Şeffaf PNG güvenli alan şablonları (1080×1920)
      <Fragment slot="intro">
        <p>
          Premiere Pro, After Effects, CapCut, DaVinci Resolve ya da Canva'da videonuzun en üst katmanına koyun, metni
          yeşil çerçevenin içinde tutun, dışa aktarmadan önce katmanı kapatın. Şablonlar
          <a href="https://creativecommons.org/licenses/by/4.0/deed.tr" rel="license noopener" target="_blank">CC BY 4.0</a>
          lisanslıdır: ticari işlerde de kullanabilirsiniz, tek şart atıf (“Rast Creative Studio — rastcreative.com”).
        </p>
      </Fragment>
    </SectionHeading>
    <ul class="tpls">
      {
        templates.map((t) => (
          <li>
            <a href={TPL + t.file} download>
              <img src={TPL + t.file} alt={`${t.label} güvenli alan şablonu önizlemesi`} width="108" height="192" loading="lazy" decoding="async" />
              <span>{t.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p>
      <a class="ev-btn ev-btn--sun" href={TPL + "rast-guvenli-alan-sablonlari.zip"} download>Tüm şablonlar (ZIP)</a>
    </p>
  </Section>

  <Section width="default" space="tight" id="olculer">
    <SectionHeading eyebrow="Ölçüler">Platform bazında güvenli alan ölçüleri</SectionHeading>
    <div class="tablewrap">
      <table class="zt">
        <caption>1080×1920 karede yaklaşık arayüz payları</caption>
        <thead>
          <tr>
            <th scope="col">Platform</th>
            <th scope="col">Üst</th>
            <th scope="col">Alt</th>
            <th scope="col">Sol</th>
            <th scope="col">Sağ</th>
            <th scope="col">Güvenli alan (px)</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.top} px <small>({pct(r.top, H)})</small></td>
                <td>{r.bottom} px <small>({pct(r.bottom, H)})</small></td>
                <td>{r.left} px <small>({pct(r.left, W)})</small></td>
                <td>{r.right} px <small>({pct(r.right, W)})</small></td>
                <td>{r.safe}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="small">
      Yüzdeler dikeyde 1920, yatayda 1080 px'e göredir. Sağ değer, buton sütununun genişliğidir; sütun ekranın tamamında değil, yaklaşık orta-alt bölgede durur (Reels'te
      kabaca y {reels.rail!.y1}–{reels.rail!.y2} px). Reels yorum yanıtı etiketi ayrıca yaklaşık y {ZONES.sticker.y1}–{ZONES.sticker.y2} px
      bandını kaplar. Tüm değerler 10 px'e yuvarlanmıştır ve cihaza, uygulama sürümüne, açıklama uzunluğuna göre değişir.
    </p>
  </Section>

  <Section width="default" space="tight" id="ipuclari">
    <SectionHeading eyebrow="Pratik">Metin, altyazı ve logo nereye konur?</SectionHeading>
    <ul class="tips">
      <li><strong>Kanca metni:</strong> ekranın üst üçte birinin hemen altına, yaklaşık y 300–700 px arasına. En üstteki ~220–290 px sekmelerin ve arama çubuğunun altında kalır.</li>
      <li><strong>Altyazı:</strong> varsayılan “en alt” konum açıklama metninin altında kalır. Altyazıyı ekranın ortasına ya da alttan ~700 px yukarıya (y ≈ 1100–1250) alın; tek platform için ortak alanda kalmak en güvenlisi.</li>
      <li><strong>Logo:</strong> köşeler yerine güvenli alanın üst kenarına yakın, küçük ve sade. Sağ alt köşe neredeyse her platformda butonların ya da ses diskinin altında kalır.</li>
      <li><strong>Yüz ve ürün:</strong> kadrajın ortasında, sağ kenardan biraz içeride. Arka plan kenarlara kadar dolu olabilir; yalnızca okunması gereken şeyler güvenli alana girmeli.</li>
      <li><strong>Yorum yanıtı Reels'i:</strong> yorum etiketi video boyunca ekranda kalır ve üst-orta bölgeyi kapatabilir. Kancayı ve yüzü etiketin altına planlayın; etiketi yayından önce boş bir alana taşıyın.</li>
      <li><strong>Reklam olacaksa:</strong> organik ölçüler yetmez; Meta reklamlarında alttan %35 (≈670 px) boş bırakın, harekete geçirici buton oraya çıkar.</li>
    </ul>
  </Section>

  <Section width="default" space="tight" id="sss">
    <SectionHeading eyebrow="SSS">Sık sorulan sorular</SectionHeading>
    <ToolFaq faqs={faqs} />
  </Section>

  <Section width="default" space="tight" id="kaynak-goster">
    <details class="at-fold">
      <summary><h2>Bu aracı sitende kullan / kaynak göster</h2></summary>
      <div class="at-fold__body cite">
      <p>
        Bir yazıda, eğitimde ya da kaynak listesinde bu araca yer vermek isterseniz aşağıdaki bağlantıyı kopyalayabilirsiniz.
        Şablonları kullanırken atıf satırı: <em>“Güvenli alan şablonu: Rast Creative Studio — rastcreative.com”</em>.
      </p>
      <label for="cite-code" class="small">HTML bağlantısı</label>
      <textarea id="cite-code" readonly rows="2" data-cite>{citeHtml}</textarea>
      <button type="button" class="ev-btn" data-copy>Kopyala</button>
      <span class="small" data-copied aria-live="polite"></span>
    </div>
    </details>
  </Section>

  <Section width="default" space="tight" id="kaynaklar">
    <details class="at-fold">
      <summary><h2>Kaynaklar ve notlar</h2></summary>
      <div class="at-fold__body">
    <p>
      Platformlar organik videolar için piksel ölçüsü yayımlamıyor; yalnızca reklamlar için oran ya da şablon veriyor.
      Tablodaki değerler aşağıdaki kaynaklar ve kendi ekran görüntüsü ölçümlerimizle birleştirilip yuvarlandı. Son kontrol:
      30 Ekim 2026.
    </p>
    <ul class="sources">
      <li>
        Meta Ads Guide, Instagram Reels video reklam özellikleri: üstten %14, alttan %35, yanlardan %6 boş bırakma önerisi
        (erişim 30.10.2026). <a href="https://www.facebook.com/business/ads-guide/update/video/instagram-reels" rel="noopener" target="_blank">facebook.com/business/ads-guide</a>
      </li>
      <li>
        Google Ads Yardım, “About video ad specs”, YouTube için evrensel güvenli alanlar; dikey 1080×1920 görselde üst 288,
        alt 672, sol 48, sağ 192 px (erişim 30.10.2026). Bu değerler reklamlar içindir; Shorts satırında bunları yuvarlayarak kullandık.
        <a href="https://support.google.com/google-ads/answer/13547298" rel="noopener" target="_blank">support.google.com</a>
      </li>
      <li>
        TikTok Ads Manager, “TikTok Auction In-Feed Ads”: güvenli alanın açıklama uzunluğuna ve eklentilere göre değiştiği notu ve
        indirilebilir güvenli alan dosyaları (erişim 30.10.2026).
        <a href="https://ads.tiktok.com/help/article/tiktok-auction-in-feed-ads" rel="noopener" target="_blank">ads.tiktok.com</a>
      </li>
      <li>
        Topluluk ölçümleri (karşılaştırma için): Revid, TikTok için üst 220 / alt 480 / sol 60 / sağ 140 px; Hey Sara Schultz,
        Instagram Reels için üst 220 / alt 450 px ve Story için üst-alt 250 px (2025–2026, erişim 30.10.2026).
        <a href="https://www.revid.ai/tiktok-safe-zone" rel="noopener" target="_blank">revid.ai</a> ·
        <a href="https://www.heysaraschultz.com/blog/instagram-sizing-guide" rel="noopener" target="_blank">heysaraschultz.com</a>
      </li>
      <li>
        Rast Creative ölçümleri (Ekim 2026): 1080×1920 Instagram Reels ekran görüntülerinde üst arayüz ≈220 px, alt ≈420 px,
        sağ buton sütunu x ≈930 px'ten sonra, y ≈900–1500 px arası. Yorum yanıtı etiketi kendi Reels'lerimizde video boyunca
        ekranda kaldı; konumu taşınabildiği için yaklaşık gösteriliyor.
      </li>
    </ul>
    <p class="small">
      Platform adları sahiplerinin ticari markalarıdır; bu araç hiçbir platformla bağlantılı değildir ve logolarını kullanmaz.
      Arayüz siluetleri temsilidir.
    </p>
      </div>
    </details>
  </Section>

  <Section width="default" space="tight">
    <details class="at-fold" lang="en">
      <summary><h2>In English: free safe zone checker and templates</h2></summary>
      <div class="at-fold__body en">
      <p>
        Check where Instagram Reels, TikTok, YouTube Shorts and Instagram Story UI covers a 1080×1920 video. Drop an image or
        video (it never leaves your browser), toggle platform overlays, scrub the video and export a PNG. Transparent safe zone
        templates for Premiere Pro, After Effects, CapCut and Canva are free under CC BY 4.0 — credit “Rast Creative Studio —
        rastcreative.com”. Values are approximate and vary by device and app version.
      </p>
    </div>
    </details>
  </Section>

  <MoreTools current="/araclar/guvenli-alan/" />

  <Section width="default" space="tight">
    <div class="cta">
      <h2>Dikey videoyu baştan güvenli alana göre planlıyoruz</h2>
      <p>
        Rast Creative Studio, Reels, TikTok ve Shorts için videoları kurguda değil çekimde 9:16 düşünerek üretir: kanca,
        altyazı ve logo yerleşimi baştan planlanır. Düzenli içerik için <a href="/sosyal-medya-icerigi/">sosyal medya içeriği</a>,
        tek seferlik işler için <a href="/video-cekimi/">video çekimi</a> sayfalarına bakabilirsiniz.
      </p>
      <Button href={PRIMARY_CTA.href}>Görüşelim</Button>
    </div>
  </Section>
</BaseLayout>

<script>
  import DATA from "../../data/safe-zones.json";

  type Rail = { x: number; y1: number; y2: number } | null;
  type Plat = { id: string; label: string; top: number; bottom: number; left: number; right: number; rail: Rail; ui: string };

  const W = DATA.width;
  const H = DATA.height;
  const PLATS: Plat[] = DATA.platforms as Plat[];
  const rails = PLATS.map((p) => p.rail).filter(Boolean) as { x: number; y1: number; y2: number }[];
  const COMBINED: Plat = {
    id: DATA.combined.id,
    label: DATA.combined.label,
    top: Math.max(...PLATS.map((p) => p.top)),
    bottom: Math.max(...PLATS.map((p) => p.bottom)),
    left: Math.max(...PLATS.map((p) => p.left)),
    right: Math.max(...PLATS.map((p) => p.right)),
    rail: { x: Math.min(...rails.map((r) => r.x)), y1: Math.min(...rails.map((r) => r.y1)), y2: Math.max(...rails.map((r) => r.y2)) },
    ui: "none",
  };
  const ALL = [...PLATS, COMBINED];

  const root = document.querySelector<HTMLElement>("[data-tool]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const ctx = canvas.getContext("2d")!;
    const fileIn = root.querySelector<HTMLInputElement>("[data-file]")!;
    const drop = root.querySelector<HTMLElement>("[data-drop]")!;
    const warn = root.querySelector<HTMLElement>("[data-warn]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const player = root.querySelector<HTMLElement>("[data-player]")!;
    const playBtn = root.querySelector<HTMLButtonElement>("[data-play]")!;
    const seek = root.querySelector<HTMLInputElement>("[data-seek]")!;
    const timeEl = root.querySelector<HTMLElement>("[data-time]")!;
    const stickerCtl = root.querySelector<HTMLElement>("[data-sticker-ctl]")!;
    const stickerY = root.querySelector<HTMLInputElement>("[data-sticker-y]")!;
    const exportBtn = root.querySelector<HTMLButtonElement>("[data-export]")!;
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear]")!;

    const S = DATA.sticker;
    const st = {
      plat: PLATS[0] as Plat,
      opts: { zones: true, safe: true, mock: true, sticker: false } as Record<string, boolean>,
      sticker: { x1: S.x1, x2: S.x2, y1: S.y1, h: S.y2 - S.y1 },
      media: null as HTMLImageElement | HTMLVideoElement | null,
      url: "",
      credit: false,
    };
    const logo = new Image();
    logo.src = "/araclar/guvenli-alan/rast-logo-beyaz.png";

    // ---------- drawing ----------
    function draw() {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = "#0e0e10";
      ctx.fillRect(0, 0, W, H);
      const m = st.media;
      if (m) {
        const mw = m instanceof HTMLVideoElement ? m.videoWidth : m.naturalWidth;
        const mh = m instanceof HTMLVideoElement ? m.videoHeight : m.naturalHeight;
        if (mw && mh) {
          const s = Math.min(W / mw, H / mh);
          const dw = mw * s;
          const dh = mh * s;
          ctx.drawImage(m, (W - dw) / 2, (H - dh) / 2, dw, dh);
        }
      } else placeholder();
      const p = st.plat;
      if (st.opts.zones) zones(p);
      if (st.opts.mock) mock(p);
      if (st.opts.sticker) sticker();
      if (st.opts.safe) safeRect(p);
      if (st.credit) credit(p);
    }

    function placeholder() {
      const g = ctx.createLinearGradient(0, 0, W, H);
      g.addColorStop(0, "#c98a54");
      g.addColorStop(0.55, "#7b5a8f");
      g.addColorStop(1, "#2c3a5c");
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = "rgba(255,255,255,.95)";
      ctx.font = "700 76px system-ui, sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("Kanca metniniz", W / 2, 420);
      ctx.font = "600 46px system-ui, sans-serif";
      ctx.fillText("Altyazı burada mı okunuyor?", W / 2, 1560);
      ctx.font = "500 36px system-ui, sans-serif";
      ctx.fillStyle = "rgba(255,255,255,.75)";
      ctx.fillText("Kendi dosyanızı seçin", W / 2, 960);
      ctx.textAlign = "left";
    }

    function zones(p: Plat) {
      ctx.fillStyle = "rgba(12,12,16,.30)";
      ctx.fillRect(0, p.top, p.left, H - p.top - p.bottom);
      ctx.fillRect(W - p.right, p.top, p.right, H - p.top - p.bottom);
      ctx.fillStyle = "rgba(12,12,16,.58)";
      ctx.fillRect(0, 0, W, p.top);
      ctx.fillRect(0, H - p.bottom, W, p.bottom);
      ctx.strokeStyle = "rgba(255,77,77,.9)";
      ctx.lineWidth = 3;
      line(0, p.top, W, p.top);
      line(0, H - p.bottom, W, H - p.bottom);
      if (p.rail) {
        const y1 = Math.max(p.rail.y1, p.top);
        const y2 = Math.min(p.rail.y2, H - p.bottom);
        ctx.fillStyle = "rgba(12,12,16,.58)";
        ctx.fillRect(p.rail.x, y1, W - p.rail.x, y2 - y1);
        line(p.rail.x, y1, p.rail.x, y2);
      }
      ctx.fillStyle = "rgba(255,255,255,.92)";
      ctx.font = "700 32px system-ui, sans-serif";
      ctx.fillText(p.label, 40, Math.min(p.top - 30, 70));
      ctx.font = "500 26px system-ui, sans-serif";
      ctx.fillText(`Üst ≈ ${p.top} px`, 40, Math.min(p.top - 30, 70) + 36);
      ctx.fillText(`Alt ≈ ${p.bottom} px`, 40, H - p.bottom + 44);
    }

    function line(x1: number, y1: number, x2: number, y2: number) {
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    }

    function safeRect(p: Plat) {
      ctx.save();
      ctx.setLineDash([26, 14]);
      ctx.lineWidth = 5;
      ctx.strokeStyle = "#3ddc84";
      ctx.strokeRect(p.left, p.top, W - p.left - p.right, H - p.top - p.bottom);
      ctx.restore();
      const label = `Güvenli alan ≈ ${W - p.left - p.right}×${H - p.top - p.bottom}`;
      ctx.font = "700 26px system-ui, sans-serif";
      const tw = ctx.measureText(label).width;
      ctx.fillStyle = "rgba(12,12,16,.72)";
      rr(p.left + 8, p.top + 10, tw + 24, 40, 20);
      ctx.fill();
      ctx.fillStyle = "#3ddc84";
      ctx.fillText(label, p.left + 20, p.top + 39);
    }

    function rr(x: number, y: number, w: number, h: number, r: number) {
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, r);
    }

    // Generic icons (no platform marks)
    function icon(kind: string, cx: number, cy: number, s: number) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.lineWidth = 5;
      ctx.strokeStyle = "rgba(255,255,255,.9)";
      ctx.fillStyle = "rgba(255,255,255,.9)";
      ctx.beginPath();
      if (kind === "heart") {
        ctx.moveTo(0, s * 0.35);
        ctx.bezierCurveTo(-s, -s * 0.25, -s * 0.45, -s * 0.9, 0, -s * 0.38);
        ctx.bezierCurveTo(s * 0.45, -s * 0.9, s, -s * 0.25, 0, s * 0.35);
        ctx.stroke();
      } else if (kind === "bubble") {
        ctx.arc(0, -s * 0.05, s * 0.5, 0.35 * Math.PI, 2.25 * Math.PI);
        ctx.lineTo(s * 0.45, s * 0.5);
        ctx.closePath();
        ctx.stroke();
      } else if (kind === "send") {
        ctx.moveTo(-s * 0.5, -s * 0.1);
        ctx.lineTo(s * 0.5, -s * 0.45);
        ctx.lineTo(s * 0.15, s * 0.5);
        ctx.lineTo(-s * 0.05, s * 0.05);
        ctx.closePath();
        ctx.stroke();
      } else if (kind === "save") {
        ctx.moveTo(-s * 0.35, -s * 0.5);
        ctx.lineTo(s * 0.35, -s * 0.5);
        ctx.lineTo(s * 0.35, s * 0.5);
        ctx.lineTo(0, s * 0.22);
        ctx.lineTo(-s * 0.35, s * 0.5);
        ctx.closePath();
        ctx.stroke();
      } else if (kind === "dots") {
        for (const dy of [-0.35, 0, 0.35]) {
          ctx.moveTo(s * 0.08, dy * s);
          ctx.arc(0, dy * s, s * 0.08, 0, Math.PI * 2);
        }
        ctx.fill();
      } else if (kind === "avatar") {
        ctx.arc(0, 0, s * 0.5, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(255,255,255,.35)";
        ctx.fill();
        ctx.stroke();
      } else if (kind === "disc") {
        ctx.arc(0, 0, s * 0.45, 0, Math.PI * 2);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(0, 0, s * 0.12, 0, Math.PI * 2);
        ctx.fill();
      } else if (kind === "search") {
        ctx.arc(-s * 0.08, -s * 0.08, s * 0.3, 0, Math.PI * 2);
        ctx.moveTo(s * 0.14, s * 0.14);
        ctx.lineTo(s * 0.45, s * 0.45);
        ctx.stroke();
      } else if (kind === "camera") {
        ctx.roundRect(-s * 0.45, -s * 0.3, s * 0.9, s * 0.65, 8);
        ctx.moveTo(s * 0.17, s * 0.03);
        ctx.arc(0, s * 0.03, s * 0.17, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.restore();
    }

    function bar(x: number, y: number, w: number, h: number, a = 0.8) {
      ctx.fillStyle = `rgba(255,255,255,${a})`;
      rr(x, y, w, h, h / 2);
      ctx.fill();
    }

    function railIcons(p: Plat, kinds: string[]) {
      if (!p.rail) return;
      const cx = (p.rail.x + W) / 2;
      const y1 = Math.max(p.rail.y1, p.top) + 60;
      const y2 = Math.min(p.rail.y2, H - p.bottom + 200) - 60;
      kinds.forEach((k, i) => {
        const cy = y1 + ((y2 - y1) * i) / Math.max(1, kinds.length - 1);
        icon(k, cx, cy, 64);
      });
    }

    function mock(p: Plat) {
      const b = H - p.bottom;
      if (p.ui === "reels") {
        bar(60, 110, 150, 36);
        icon("camera", W - 80, 128, 60);
        railIcons(p, ["heart", "bubble", "send", "save", "dots"]);
        icon("avatar", 92, b + 110, 60);
        bar(140, b + 92, 230, 34);
        bar(390, b + 90, 120, 38, 0.45);
        bar(60, b + 165, 720, 26, 0.65);
        bar(60, b + 210, 520, 26, 0.65);
        bar(60, b + 260, 360, 26, 0.5);
        bar(0, H - 110, W, 2, 0.3);
      } else if (p.ui === "tiktok") {
        bar(W / 2 - 230, 120, 180, 34, 0.55);
        bar(W / 2 + 40, 120, 190, 34);
        icon("search", W - 80, 136, 60);
        railIcons(p, ["avatar", "heart", "bubble", "save", "send", "disc"]);
        bar(60, b + 70, 260, 36);
        bar(60, b + 140, 760, 26, 0.65);
        bar(60, b + 185, 560, 26, 0.65);
        bar(60, b + 240, 420, 26, 0.5);
        bar(0, H - 130, W, 2, 0.3);
      } else if (p.ui === "shorts") {
        icon("search", W - 220, 150, 60);
        icon("dots", W - 90, 150, 60);
        railIcons(p, ["heart", "heart", "bubble", "send", "disc"]);
        icon("avatar", 92, b + 90, 60);
        bar(140, b + 72, 240, 34);
        bar(400, b + 66, 170, 46, 0.9);
        bar(60, b + 155, 700, 30, 0.7);
        bar(60, b + 205, 460, 30, 0.7);
        bar(60, b + 270, 380, 26, 0.5);
        bar(0, H - 150, W, 2, 0.3);
      } else if (p.ui === "story") {
        for (let i = 0; i < 3; i++) bar(30 + i * 345, 40, 330, 8, i === 0 ? 0.95 : 0.45);
        icon("avatar", 90, 130, 64);
        bar(140, 114, 220, 32);
        icon("dots", W - 70, 130, 56);
        ctx.strokeStyle = "rgba(255,255,255,.85)";
        ctx.lineWidth = 4;
        rr(40, H - 160, 800, 100, 50);
        ctx.stroke();
        bar(90, H - 124, 260, 28, 0.6);
        icon("heart", 900, H - 110, 60);
        icon("send", 1010, H - 110, 60);
      }
    }

    function sticker() {
      const s = st.sticker;
      ctx.fillStyle = "rgba(255,255,255,.88)";
      rr(s.x1, s.y1, s.x2 - s.x1, s.h, 32);
      ctx.fill();
      ctx.strokeStyle = "#ffb800";
      ctx.lineWidth = 5;
      ctx.stroke();
      icon("avatar", s.x1 + 70, s.y1 + 70, 64);
      ctx.fillStyle = "rgba(20,20,20,.85)";
      ctx.font = "700 30px system-ui, sans-serif";
      ctx.fillText("Yorum yanıtı etiketi", s.x1 + 120, s.y1 + 62);
      ctx.font = "500 26px system-ui, sans-serif";
      ctx.fillText("yaklaşık · video boyunca ekranda", s.x1 + 120, s.y1 + 100);
      ctx.fillStyle = "rgba(20,20,20,.35)";
      rr(s.x1 + 40, s.y1 + 140, s.x2 - s.x1 - 160, 26, 13);
      ctx.fill();
      rr(s.x1 + 40, s.y1 + 184, s.x2 - s.x1 - 300, 26, 13);
      ctx.fill();
    }

    function credit(p: Plat) {
      const lh = 40;
      const y = H - 40 - lh;
      ctx.save();
      ctx.globalAlpha = 0.6;
      let tx = 40;
      if (logo.complete && logo.naturalWidth) {
        const lw = (logo.naturalWidth / logo.naturalHeight) * lh;
        ctx.drawImage(logo, 40, y, lw, lh);
        tx = 40 + lw + 18;
      }
      ctx.fillStyle = "#fff";
      ctx.font = "700 22px system-ui, sans-serif";
      ctx.fillText("Rast Creative Studio · @rastcreative", tx, y + 18);
      ctx.font = "500 20px system-ui, sans-serif";
      ctx.fillText("rastcreative.com/araclar/guvenli-alan", tx, y + 42);
      ctx.restore();
      void p;
    }

    // ---------- media ----------
    let raf = 0;
    function loop() {
      draw();
      const v = st.media;
      if (v instanceof HTMLVideoElement) {
        seek.value = String(v.currentTime);
        timeEl.textContent = fmt(v.currentTime) + " / " + fmt(v.duration || 0);
        if (!v.paused && !v.ended) raf = requestAnimationFrame(loop);
      }
    }
    const fmt = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, "0")}`;

    function ratioWarn(w: number, h: number) {
      const r = w / h;
      if (Math.abs(r - 9 / 16) > 0.01) {
        warn.textContent = `Dosyanız 9:16 değil (${w}×${h}). Platformlar kenarları kırpabilir ya da boşluk ekleyebilir; önizlemede dosya kırpılmadan sığdırıldı. En doğru sonuç için 1080×1920 kullanın.`;
        warn.hidden = false;
      } else if (w < 1080) {
        warn.textContent = `Oran doğru (9:16) ama çözünürlük düşük (${w}×${h}); yayında 1080×1920 önerilir.`;
        warn.hidden = false;
      } else warn.hidden = true;
    }

    function clearMedia() {
      cancelAnimationFrame(raf);
      if (st.media instanceof HTMLVideoElement) st.media.pause();
      if (st.url) URL.revokeObjectURL(st.url);
      st.media = null;
      st.url = "";
      player.hidden = true;
      warn.hidden = true;
      clearBtn.hidden = true;
      draw();
    }

    function load(file: File) {
      const isVideo = file.type.startsWith("video/") || /\.(mp4|mov|webm)$/i.test(file.name);
      const isImage = /^image\/(jpeg|png|webp)$/.test(file.type) || /\.(jpe?g|png|webp)$/i.test(file.name);
      if (!isVideo && !isImage) {
        warn.textContent = "Bu dosya türü desteklenmiyor. JPG, PNG, WebP, MP4, MOV ya da WebM seçin.";
        warn.hidden = false;
        return;
      }
      clearMedia();
      st.url = URL.createObjectURL(file);
      if (isVideo) {
        const v = document.createElement("video");
        v.muted = true;
        v.playsInline = true;
        v.preload = "auto";
        v.src = st.url;
        v.addEventListener("loadeddata", () => {
          st.media = v;
          ratioWarn(v.videoWidth, v.videoHeight);
          seek.max = String(v.duration || 0);
          player.hidden = false;
          clearBtn.hidden = false;
          loop();
        });
        v.addEventListener("seeked", () => loop());
        v.addEventListener("play", () => {
          playBtn.textContent = "Durdur";
          playBtn.setAttribute("aria-label", "Durdur");
          loop();
        });
        v.addEventListener("pause", () => {
          playBtn.textContent = "Oynat";
          playBtn.setAttribute("aria-label", "Oynat");
        });
        v.addEventListener("error", () => {
          warn.textContent = "Video açılamadı. Tarayıcınız bu codec'i desteklemiyor olabilir (ör. bazı HEVC .mov dosyaları); MP4 (H.264) deneyin.";
          warn.hidden = false;
        });
      } else {
        const img = new Image();
        img.onload = () => {
          st.media = img;
          ratioWarn(img.naturalWidth, img.naturalHeight);
          clearBtn.hidden = false;
          draw();
        };
        img.src = st.url;
      }
    }

    fileIn.addEventListener("change", () => fileIn.files?.[0] && load(fileIn.files[0]));
    ["dragenter", "dragover"].forEach((e) =>
      drop.addEventListener(e, (ev) => {
        ev.preventDefault();
        drop.classList.add("is-over");
      }),
    );
    ["dragleave", "drop"].forEach((e) => drop.addEventListener(e, () => drop.classList.remove("is-over")));
    drop.addEventListener("drop", (ev) => {
      ev.preventDefault();
      const f = (ev as DragEvent).dataTransfer?.files?.[0];
      if (f) load(f);
    });
    clearBtn.addEventListener("click", () => {
      fileIn.value = "";
      clearMedia();
    });

    playBtn.addEventListener("click", () => {
      const v = st.media;
      if (v instanceof HTMLVideoElement) (v.paused ? v.play() : v.pause());
    });
    seek.addEventListener("input", () => {
      const v = st.media;
      if (v instanceof HTMLVideoElement) v.currentTime = Number(seek.value);
    });

    // ---------- controls ----------
    root.querySelectorAll<HTMLInputElement>('input[name="platform"]').forEach((r) =>
      r.addEventListener("change", () => {
        st.plat = ALL.find((p) => p.id === r.value) ?? PLATS[0];
        updateNote();
        draw();
      }),
    );
    root.querySelectorAll<HTMLInputElement>("[data-opt]").forEach((c) =>
      c.addEventListener("change", () => {
        st.opts[c.dataset.opt!] = c.checked;
        stickerCtl.hidden = !st.opts.sticker;
        draw();
      }),
    );
    stickerY.addEventListener("input", () => {
      st.sticker.y1 = Number(stickerY.value);
      draw();
    });

    function updateNote() {
      const p = st.plat;
      const plat = DATA.platforms.find((x) => x.id === p.id);
      note.textContent = plat
        ? plat.note
        : "Ortak alan: dört platformun en geniş üst, alt ve yan paylarının birleşimi. Tek bir video her yerde yayınlanacaksa metni buraya koyun.";
    }
    updateNote();

    // drag the sticker on the canvas (pointer) + arrow keys when canvas focused
    const toLogical = (ev: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return { x: ((ev.clientX - r.left) / r.width) * W, y: ((ev.clientY - r.top) / r.height) * H };
    };
    let drag: { dx: number; dy: number } | null = null;
    canvas.addEventListener("pointerdown", (ev) => {
      if (!st.opts.sticker) return;
      const { x, y } = toLogical(ev);
      const s = st.sticker;
      if (x >= s.x1 && x <= s.x2 && y >= s.y1 && y <= s.y1 + s.h) {
        drag = { dx: x - s.x1, dy: y - s.y1 };
        canvas.setPointerCapture(ev.pointerId);
        ev.preventDefault();
      }
    });
    canvas.addEventListener("pointermove", (ev) => {
      if (!drag) return;
      const { x, y } = toLogical(ev);
      const s = st.sticker;
      const w = s.x2 - s.x1;
      s.x1 = Math.round(Math.min(Math.max(0, x - drag.dx), W - w));
      s.x2 = s.x1 + w;
      s.y1 = Math.round(Math.min(Math.max(0, y - drag.dy), H - s.h));
      stickerY.value = String(s.y1);
      draw();
    });
    const endDrag = () => (drag = null);
    canvas.addEventListener("pointerup", endDrag);
    canvas.addEventListener("pointercancel", endDrag);
    canvas.addEventListener("keydown", (ev) => {
      if (!st.opts.sticker) return;
      const step = ev.shiftKey ? 50 : 10;
      const s = st.sticker;
      const w = s.x2 - s.x1;
      if (ev.key === "ArrowUp") s.y1 = Math.max(0, s.y1 - step);
      else if (ev.key === "ArrowDown") s.y1 = Math.min(H - s.h, s.y1 + step);
      else if (ev.key === "ArrowLeft") s.x1 = Math.max(0, s.x1 - step);
      else if (ev.key === "ArrowRight") s.x1 = Math.min(W - w, s.x1 + step);
      else return;
      s.x2 = s.x1 + w;
      stickerY.value = String(s.y1);
      ev.preventDefault();
      draw();
    });

    // ---------- export (PNG + tEXt metadata) ----------
    const CRC = (() => {
      const t = new Uint32Array(256);
      for (let n = 0; n < 256; n++) {
        let c = n;
        for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
        t[n] = c >>> 0;
      }
      return t;
    })();
    function crc32(bytes: Uint8Array) {
      let c = 0xffffffff;
      for (const b of bytes) c = CRC[(c ^ b) & 0xff] ^ (c >>> 8);
      return (c ^ 0xffffffff) >>> 0;
    }
    function textChunk(key: string, val: string) {
      const data = new TextEncoder().encode(`${key}\0${val}`); // ASCII-only values
      const out = new Uint8Array(12 + data.length);
      const dv = new DataView(out.buffer);
      dv.setUint32(0, data.length);
      out.set([0x74, 0x45, 0x58, 0x74], 4); // "tEXt"
      out.set(data, 8);
      dv.setUint32(8 + data.length, crc32(out.subarray(4, 8 + data.length)));
      return out;
    }
    function withMeta(png: Uint8Array) {
      const chunks = [
        textChunk("Author", "Rast Creative Studio"),
        textChunk("Source", "https://rastcreative.com/araclar/guvenli-alan/"),
        textChunk("License", "CC BY 4.0 (overlay); your own footage stays yours"),
        textChunk("Software", "Rast Creative safe zone checker"),
      ];
      const at = 33; // after signature (8) + IHDR (25)
      const size = chunks.reduce((n, c) => n + c.length, 0);
      const out = new Uint8Array(png.length + size);
      out.set(png.subarray(0, at), 0);
      let o = at;
      for (const c of chunks) {
        out.set(c, o);
        o += c.length;
      }
      out.set(png.subarray(at), o);
      return out;
    }

    exportBtn.addEventListener("click", () => {
      st.credit = true;
      draw();
      canvas.toBlob(async (blob) => {
        st.credit = false;
        draw();
        if (!blob) return;
        const bytes = withMeta(new Uint8Array(await blob.arrayBuffer()));
        const url = URL.createObjectURL(new Blob([bytes], { type: "image/png" }));
        const a = document.createElement("a");
        a.href = url;
        a.download = `rast-guvenli-alan-kontrol-${st.plat.id}.png`;
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 4000);
      }, "image/png");
    });

    logo.onload = () => draw();
    draw();
  }

  // copy citation
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]");
  copyBtn?.addEventListener("click", async () => {
    const ta = document.querySelector<HTMLTextAreaElement>("[data-cite]")!;
    const out = document.querySelector<HTMLElement>("[data-copied]")!;
    try {
      await navigator.clipboard.writeText(ta.value);
    } catch {
      ta.select();
      document.execCommand("copy");
    }
    out.textContent = "Kopyalandı.";
  });
</script>


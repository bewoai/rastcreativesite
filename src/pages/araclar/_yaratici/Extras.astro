---
/**
 * Shared lower half of the creator tool pages: FAQ (same text as the FAQPage
 * JSON-LD), "Kaynak göster" copy box, sources (slot), "Diğer ücretsiz araçlar" strip, soft CTA.
 */
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import Button from "../../../components/Button.astro";
import { PRIMARY_CTA } from "../../../consts";
import ToolFaq from "../../../components/araclar/ToolFaq.astro";
import MoreTools from "../../../components/araclar/MoreTools.astro";
import CcByAttribution from "../../../components/araclar/CcByAttribution.astro";

interface Props {
  faqs: { question: string; answer: string }[];
  pageUrl: string;
  linkText: string;
  attribution: string;
  current: string;
  ctaTitle: string;
  checked?: string;
  /** English twin pages (/en/tools/) pass lang="en". */
  lang?: "tr" | "en";
  /** Download pages: credit prefix for the copy-paste CC BY 4.0 attribution HTML (e.g. "Şablon"). */
  ccby?: string;
}
const { faqs, pageUrl, linkText, attribution, current, ctaTitle, lang = "tr", ccby } = Astro.props;
const en = lang === "en";
const checked = Astro.props.checked ?? (en ? "30 October 2026" : "30 Ekim 2026");
const citeHtml = `<a href="${pageUrl}">${linkText} — Rast Creative Studio</a>`;

---

<Section width="default" space="tight" id="sss">
  {en ? <SectionHeading eyebrow="FAQ">Frequently asked questions</SectionHeading> : <SectionHeading eyebrow="SSS">Sık sorulan sorular</SectionHeading>}
  <ToolFaq faqs={faqs} />
</Section>

<Section width="default" space="tight" id="kaynak-goster">
  <details class="at-fold">
    <summary><h2>{en ? "Cite this tool / link to it" : "Bu aracı sitende kullan / kaynak göster"}</h2></summary>
    <div class="at-fold__body yt-box">
    {
      en ? (
        <p>
          Writing a tutorial, a course or a resource list? Copy the link below. When you use the downloaded templates, the
          credit line is: <em>“{attribution}”</em>.
        </p>
      ) : (
    <p>
      Bir yazıda, eğitimde ya da kaynak listesinde bu sayfaya yer vermek isterseniz aşağıdaki bağlantıyı kopyalayabilirsiniz.
      İndirilen şablonları kullanırken atıf satırı: <em>“{attribution}”</em>.
    </p>
      )
    }
    <label for="yt-cite" class="yt-small">{en ? "HTML link" : "HTML bağlantısı"}</label>
    <textarea id="yt-cite" readonly rows="2" data-cite>{citeHtml}</textarea>
    <button type="button" class="ev-btn" data-copy-cite data-done={en ? "Copied." : "Kopyalandı."}>{en ? "Copy" : "Kopyala"}</button>
    <span class="yt-small" data-copied aria-live="polite"></span>
    {ccby && <CcByAttribution href={pageUrl} label={ccby} lang={lang} />}
  </div>
  </details>
</Section>

<Section width="default" space="tight" id="kaynaklar">
  <details class="at-fold">
  <summary><h2>{en ? "Sources and notes" : "Kaynaklar ve notlar"}</h2></summary>
  <div class="at-fold__body">
  <div class="yt-prose"><slot name="sources" /></div>
  {
    en ? (
      <p class="yt-small">
        Last checked: {checked}. Platform names are trademarks of their owners; this tool is not affiliated with any platform
        and doesn't use their logos. UI drawings are illustrative; values can vary by device and app version.
      </p>
    ) : (
  <p class="yt-small">
    Son kontrol: {checked}. Platform adları sahiplerinin ticari markalarıdır; bu araç hiçbir platformla bağlantılı değildir ve
    logolarını kullanmaz. Arayüz çizimleri temsilidir, değerler cihaza ve uygulama sürümüne göre değişebilir.
  </p>
    )
  }
  </div>
  </details>
</Section>

<MoreTools current={current} />

<Section width="default" space="tight">
  <div class="yt-box">
    <h2>{ctaTitle}</h2>
    <p><slot name="cta" /></p>
    {en ? <Button href="mailto:studio@rastcreative.com">Email the studio</Button> : <Button href={PRIMARY_CTA.href}>Görüşelim</Button>}
  </div>
</Section>

<script>
  const citeBtn = document.querySelector<HTMLButtonElement>("[data-copy-cite]");
  citeBtn?.addEventListener("click", async () => {
    const ta = document.querySelector<HTMLTextAreaElement>("[data-cite]")!;
    const out = document.querySelector<HTMLElement>("[data-copied]")!;
    try {
      await navigator.clipboard.writeText(ta.value);
    } catch {
      ta.select();
      document.execCommand("copy");
    }
    out.textContent = citeBtn.dataset.done ?? "Kopyalandı.";
  });
</script>

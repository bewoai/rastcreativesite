---
/**
 * Case study: Aytaş Home Outlet — Instagram, 4 months under Rast Creative.
 * Source: the client report (Meta Business Suite, Jan–Apr vs May–Aug 2026).
 * Only the results are published; internal gaps and audience breakdowns
 * from the report stay with the client.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InstagramCard from "../../../components/evren/InstagramCard.astro";
import { MANAGED_ACCOUNTS } from "../../../data/managed-accounts";
import { breadcrumb } from "../../../lib/schema";
import { EV_CTA } from "../../../lib/evren";

const account = MANAGED_ACCOUNTS.find((a) => a.client === "Aytaş Home")!;
const reels = (await getCollection("projects"))
  .filter((p) => p.data.client === "Aytaş Home" && !p.data.draft && !p.data.hidden)
  .sort((a, b) => b.data.order - a.data.order);

const headline = [
  { value: "+%134", label: "Günlük organik görüntüleme" },
  { value: "+%311", label: "İçerik etkileşimi" },
  { value: "+%176", label: "Profil ziyareti" },
  { value: "+%194", label: "Bağlantı tıklaması" },
  { value: "+%97", label: "Günlük net takipçi" },
  { value: "+%171", label: "Günlük yeni mesajlaşan kişi" },
];

// Before (Jan–Apr) → after (May–Aug). `b`/`a` are for bar lengths only.
const compare = [
  { k: "Görüntüleme", before: "3.010.962", after: "4.485.717", b: 3.01, a: 4.49, d: "+%49" },
  { k: "Erişim", before: "~1,4 Mn", after: "~1,5 Mn", b: 1.4, a: 1.5, d: "~+%7", quiet: true },
  { k: "İçerik etkileşimi", before: "18,6 bin", after: "76,5 bin", b: 18.6, a: 76.5, d: "+%311" },
  { k: "Bağlantı tıklaması", before: "22 bin", after: "64,7 bin", b: 22, a: 64.7, d: "+%194" },
  { k: "Profil ziyareti", before: "40,5 bin", after: "111,8 bin", b: 40.5, a: 111.8, d: "+%176" },
  { k: "Yeni takip", before: "~4,1 bin", after: "~7,8 bin", b: 4.1, a: 7.8, d: "~+%95" },
];

const dms = [
  { k: "Yeni mesajlaşan kişi", before: "257", after: "730" },
  { k: "Yeni organik mesajlaşan", before: "148", after: "460" },
  { k: "Mesaj yanıt oranı", before: "%18,9", after: "%59,6" },
];

const top = [
  { t: "Büyük Aytaş Home Yaz Festivali", v: "396,5 bin" },
  { t: "Sakarya'nın En Büyük Mobilya Festivali", v: "253,8 bin" },
  { t: "Aytaş Home Outlet Geleneksel Mobilya", v: "187,6 bin" },
  { t: "Merhaba, Aytaş Home Outlet Mobilya", v: "144,8 bin" },
  { t: "“Mobilyacılar burada mı?”", v: "138,8 bin" },
];
const dna = ["Yerellik", "Gerçek mağaza", "İnsan", "Net hook", "Fırsat", "Hareketlilik"];

const did = [
  { t: "İçerik planı", d: "Kampanya takvimine bağlı aylık plan; her hafta yayında olan dikey seriler." },
  { t: "Düzenli çekim günleri", d: "Mağazada, gerçek ürün ve gerçek insanlarla: sunucu, trend formatları, ürün detayları." },
  { t: "Kurgu ve paylaşım", d: "İlk saniyede durduran açılışlar, altyazı, müzik; Reels ve hikâye için ayrı kurgular." },
  { t: "Reklam yönetimi", d: "Organik içeriği taşıyan reklamlar; festival ve kampanya dönemlerinde yoğunlaşan bütçe." },
];

const crumbs = breadcrumb([
  { name: "Ana Sayfa", path: "/" },
  { name: "Projeler", path: "/projeler/" },
  { name: "Aytaş Home", path: "/projeler/marka/aytas-home/" },
  { name: "Instagram vaka çalışması", path: "/projeler/vaka/aytas-home/" },
]);
const max = (row: (typeof compare)[number]) => Math.max(row.a, row.b);
---

<BaseLayout
  title="Aytaş Home Instagram Vaka Çalışması"
  description="Aytaş Home Outlet'in Instagram hesabını Mayıs 2026'da devraldık. 4 ayda günlük organik görüntüleme +%134, içerik etkileşimi +%311, profil ziyareti +%176."
  image="/covers/aytas-home-duzce-festivali.webp"
  ogType="article"
  jsonLd={crumbs}
>
  <div class="case">
    <a href="/projeler/marka/aytas-home/" class="case__back">← Aytaş Home işleri</a>

    <header class="case__head">
      <p class="ev-label"><span class="ev-label__sun"></span>Vaka çalışması · Sosyal medya</p>
      <h1 class="case__title">Aytaş Home Outlet: daha görünür, daha çok <em>aksiyon.</em></h1>
      <p class="case__lede">
        Mayıs 2026'da Aytaş Home Outlet'in Instagram hesabını devraldık. Önceki dört ayı
        (1 Ocak – 30 Nisan) bizim ilk dört ayımızla (1 Mayıs – 31 Ağustos) Meta Business Suite
        verileriyle karşılaştırdık.
      </p>
      <blockquote class="case__quote">“Hesap yalnızca daha çok görünmedi; daha fazla insanı harekete geçirdi.”</blockquote>
    </header>

    <section class="case__sec" aria-labelledby="c-sum">
      <h2 id="c-sum" class="ev-h2 case__h2">30 saniyede <em>sonuç.</em></h2>
      <ul class="case__kpis">
        {headline.map((h) => (
          <li class="ev-glass">
            <span class="case__kpi">{h.value}</span>
            <span class="case__kpil">{h.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="case__sec" aria-labelledby="c-cmp">
      <h2 id="c-cmp" class="ev-h2 case__h2">Önce / <em>sonra.</em></h2>
      <p class="case__legend"><span class="is-b"></span>Ocak – Nisan (önceki yönetim) <span class="is-a"></span>Mayıs – Ağustos (Rast Creative)</p>
      <div class="case__bars ev-glass">
        {compare.map((r) => (
          <div class:list={["bar", { "bar--quiet": r.quiet }]}>
            <p class="bar__k">{r.k}</p>
            <div class="bar__lines">
              <span class="bar__line is-b" style={`--w:${(r.b / max(r)) * 100}%`}><em>{r.before}</em></span>
              <span class="bar__line is-a" style={`--w:${(r.a / max(r)) * 100}%`}><em>{r.after}</em></span>
            </div>
            <p class="bar__d">{r.d}</p>
          </div>
        ))}
      </div>
      <p class="case__note">
        <b>Erişim neredeyse aynı kaldı, aksiyonlar katlandı.</b> Ulaşılan kitle başına etkileşim
        yoğunluğu %1,33'ten %5,10'a çıktı: yaklaşık <b>3,8 kat</b>.
      </p>
    </section>

    <section class="case__sec case__split" aria-labelledby="c-src">
      <div>
        <h2 id="c-src" class="ev-h2 case__h2">Daha çok paylaşım mı, <em>daha iyi içerik mi?</em></h2>
        <p class="case__p">
          Paylaşım sıklığı yaklaşık <b>%33</b> arttı; günlük organik görüntüleme ise <b>%134</b>
          (5.821 → 13.645 / gün). Performans artışı içerik hacminin çok üzerinde.
        </p>
        <p class="case__p">
          Organik içerik toplam görüntülemenin daha büyük bir kısmını taşımaya başladı:
          <b>%23,2 → %38,6.</b> Reklamlı görüntülemeler de arttı; değişen, organiğin ağırlığı.
        </p>
      </div>
      <div class="case__dm ev-glass">
        <p class="ev-label">Mesaj ve müşteri niyeti</p>
        <dl>
          {dms.map((m) => (
            <div>
              <dt>{m.k}</dt>
              <dd><s>{m.before}</s> → <b>{m.after}</b></dd>
            </div>
          ))}
        </dl>
        <p class="case__p">İçerikler yalnızca izlenmedi; markaya doğrudan yazan kişi sayısı da güçlü biçimde arttı.</p>
      </div>
    </section>

    <section class="case__sec" aria-labelledby="c-top">
      <h2 id="c-top" class="ev-h2 case__h2">En çok izlenen <em>içerikler.</em></h2>
      <ol class="case__top">
        {top.map((c, i) => (
          <li>
            <span class="case__n">{String(i + 1).padStart(2, "0")}</span>
            <span class="case__t">{c.t}</span>
            <span class="case__v">{c.v}</span>
          </li>
        ))}
      </ol>
      <p class="case__dna"><span>İçerik DNA'sı</span>{dna.map((d) => <b>{d}</b>)}</p>
    </section>

    <section class="case__sec" aria-labelledby="c-did">
      <h2 id="c-did" class="ev-h2 case__h2">Ne <em>yaptık?</em></h2>
      <ul class="case__did">
        {did.map((d, i) => (
          <li class="ev-glass">
            <span class="case__n">{["I", "II", "III", "IV"][i]}</span>
            <b>{d.t}</b>
            <span>{d.d}</span>
          </li>
        ))}
      </ul>
      <div class="case__ig">
        <InstagramCard account={account} projects={reels} showCase={false} />
      </div>
    </section>

    <section class="case__cta ev-glass">
      <div>
        <h2 class="case__ctat">Hesabınız da böyle <em>çalışsın.</em></h2>
        <p class="case__p">Çekimden paylaşıma ve reklama kadar hesabınızı tek ekip olarak yönetelim.</p>
      </div>
      <a class="ev-btn ev-btn--sun" href="/iletisim/" data-cta-location="case_aytas">{EV_CTA} <span aria-hidden="true">→</span></a>
    </section>

    <p class="case__src">
      Kaynak: Meta Business Suite / Instagram İstatistikleri. Dönemler: 1 Ocak – 30 Nisan 2026
      (önceki yönetim) ve 1 Mayıs – 31 Ağustos 2026 (Rast Creative). Meta bazı erişim değerlerini
      yuvarladığı için oranlar yaklaşık değerdir.
    </p>
  </div>
</BaseLayout>

<style>
  .case {
    width: min(100%, 76rem);
    margin: 0 auto;
    padding: clamp(6.5rem, 10vw, 8rem) var(--pad) clamp(3rem, 6vw, 5rem);
  }
  .case__back {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.92rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .case__back:hover {
    color: var(--sun-text);
  }
  .case__head {
    max-width: 52rem;
    margin-top: 1rem;
  }
  .case__title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.5rem, 5vw + 0.6rem, 4.8rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .case__title em,
  .case__h2 em,
  .case__ctat em {
    font-weight: 460;
    color: var(--sun-text);
  }
  .case__lede {
    max-width: 40rem;
    margin: 1.3rem 0 0;
    font-size: 1.12rem;
    color: var(--ink-2);
  }
  .case__quote {
    margin: 1.6rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--sun);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--sun-text);
  }
  .case__sec {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .case__h2 {
    font-size: clamp(2rem, 3vw + 0.6rem, 3.2rem);
  }
  .case__kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .case__kpis li {
    display: grid;
    gap: 0.2rem;
    padding: 1.2rem 1.3rem;
  }
  .case__kpis li::before,
  .case__bars::before,
  .case__dm::before,
  .case__did li::before,
  .case__cta::before {
    display: none;
  }
  .case__kpi {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2.2rem, 3vw + 0.8rem, 3.2rem);
    line-height: 1;
    color: var(--sun-text);
  }
  .case__kpil {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .case__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin: 1rem 0 0.8rem;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .case__legend span {
    display: inline-block;
    width: 1.4rem;
    height: 0.4rem;
    border-radius: 2px;
  }
  .is-b {
    background: #b9ab9a;
  }
  .is-a {
    background: var(--sun);
  }
  .case__bars {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1rem, 3vw, 1.8rem);
  }
  .bar {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) 4.5rem;
    align-items: center;
    gap: 1rem;
  }
  .bar__k {
    margin: 0;
    font-weight: 600;
  }
  /* Room on the right for the value label that trails each bar. */
  .bar__lines {
    display: grid;
    gap: 0.35rem;
    padding-right: 5.5rem;
  }
  .bar__line {
    position: relative;
    display: block;
    width: var(--w);
    height: 0.55rem;
    border-radius: 3px;
  }
  .bar__line em {
    position: absolute;
    left: calc(100% + 0.5rem);
    top: 50%;
    translate: 0 -50%;
    font-style: normal;
    font-size: 0.8rem;
    white-space: nowrap;
    color: var(--ink-2);
  }
  .bar__line.is-a em {
    font-weight: 700;
    color: var(--ink);
  }
  .bar__d {
    margin: 0;
    text-align: right;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.4rem;
  }
  .bar--quiet .bar__d {
    color: var(--mute);
  }
  .case__note {
    max-width: 44rem;
    margin: 1.2rem 0 0;
    color: var(--ink-2);
  }
  .case__note b,
  .case__p b {
    color: var(--ink);
  }
  .case__split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .case__p {
    margin: 1rem 0 0;
    color: var(--ink-2);
  }
  .case__dm {
    padding: 1.4rem;
  }
  .case__dm dl {
    display: grid;
    gap: 0.8rem;
    margin: 0.2rem 0 0;
  }
  .case__dm dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(114, 103, 92, 0.2);
  }
  .case__dm dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.3rem;
    white-space: nowrap;
  }
  .case__dm s {
    color: var(--mute);
    text-decoration: none;
  }
  .case__dm dd b {
    color: var(--sun-text);
  }
  .case__top {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(114, 103, 92, 0.22);
  }
  .case__top li {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(114, 103, 92, 0.22);
  }
  .case__n {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    color: var(--sun-text);
  }
  .case__t {
    font-weight: 600;
  }
  .case__v {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.25rem;
  }
  .case__dna {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
  }
  .case__dna span {
    margin-right: 0.4rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .case__dna b {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    box-shadow: inset 0 0 0 1px var(--edge);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .case__did {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.8rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .case__did li {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    padding: 1.2rem;
  }
  .case__did b {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
  }
  .case__did li > span:last-child {
    font-size: 0.94rem;
    color: var(--ink-2);
  }
  .case__ig {
    max-width: 44rem;
    margin-top: 1.6rem;
  }
  .case__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }
  .case__ctat {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.7rem, 2vw + 0.8rem, 2.4rem);
  }
  .case__src {
    max-width: 50rem;
    margin: 1.6rem 0 0;
    font-size: 0.82rem;
    color: var(--mute);
  }
  @media (max-width: 860px) {
    .case__kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .case__split {
      grid-template-columns: 1fr;
    }
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.4rem 1rem;
    }
    .bar__lines {
      grid-column: 1 / -1;
      grid-row: 2;
      padding-right: 5.5rem;
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import { CONTACT, waCtaHref } from "../consts";
import { WA_PATH } from "../lib/evren";
import { localBusiness, organization, webSite, breadcrumb } from "../lib/schema";

const whatsappHref = waCtaHref("/iletisim/");

// Opens the Google Business Profile: map, route and reviews in one place.
const mapsUrl = CONTACT.googleShare;

// Contact is the strongest local-SEO page: full LocalBusiness + breadcrumb.
const pageJsonLd = [
  organization,
  webSite,
  localBusiness,
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "İletişim", path: "/iletisim/" },
  ]),
];
---

<BaseLayout
  title="İletişim"
  description="Sakarya'da video prodüksiyon için projenizi anlatın; telefon ve e-posta üzerinden birlikte planlayalım. Serdivan, Sakarya."
  jsonLd={pageJsonLd}
  headerCta="#teklif-formu"
>
  <Section>
    <SectionHeading eyebrow="Sahne 01 · İletişim" as="h1">
      Bize projenizden bahsedin
      <Fragment slot="intro">
        <p>
          Projenizi anlatın; size uygun formatı, kapsamı ve takvimi birlikte
          belirleyelim. Telefonla hızlı dönüş yaparız. İlk görüşme ücretsiz
          ve&nbsp;bağlayıcı&nbsp;değil.
        </p>
      </Fragment>
    </SectionHeading>

    {/* Quick routes first: testers had to scroll ~1400px past the form to
        find the phone number. */}
    <div class="quick">
      {
        whatsappHref && (
          <a class="quick__btn quick__btn--wa" href={whatsappHref} target="_blank" rel="noopener" data-cta-location="iletisim_quick_wa">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d={WA_PATH} /></svg>
            WhatsApp'tan yaz
          </a>
        )
      }
      {
        CONTACT.phone && (
          <a class="quick__btn quick__btn--tel" href={`tel:${CONTACT.phoneIntl}`} data-cta-location="iletisim_quick_tel">
            <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z" /></svg>
            Ara: {CONTACT.phone}
          </a>
        )
      }
    </div>
    <p class="quick__or">ya da formu doldurun, biz sizi arayalım:</p>

    <div class="contact">
      <div class="contact__form">
        <ContactForm />
      </div>

      <aside class="contact__aside">
        <Eyebrow tone="soft">Kanallar</Eyebrow>

        <dl class="channels">
          <div class="channels__row">
            <dt>Telefon</dt>
            <dd>
              {
                CONTACT.phone ? (
                  <a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
                ) : (
                  <span class="pending">Yakında</span>
                )
              }
            </dd>
          </div>
          {
            whatsappHref && (
              <div class="channels__row">
                <dt>WhatsApp</dt>
                <dd>
                  <a href={whatsappHref} target="_blank" rel="noopener" data-cta-location="iletisim_wa">WhatsApp'tan yazın</a>
                </dd>
              </div>
            )
          }
          <div class="channels__row">
            <dt>E-posta</dt>
            <dd>
              {
                CONTACT.email ? (
                  <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
                ) : (
                  <span class="pending">Yakında</span>
                )
              }
            </dd>
          </div>
          <div class="channels__row">
            <dt>Konum</dt>
            <dd>{CONTACT.city}</dd>
          </div>
        </dl>

        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="map">
          <span class="map__pin"><Icon name="home" size={20} /></span>
          <span class="map__text">
            <strong>Google'da aç</strong>
            <span>{CONTACT.city} · harita, yorumlar</span>
          </span>
          <Icon name="arrow-up-right" size={18} class="map__ext" />
        </a>
      </aside>
    </div>
  </Section>
</BaseLayout>

<style>
  .quick {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    max-width: 40rem;
  }
  .quick__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-pill);
    font-weight: 650;
    font-size: 1.05rem;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .quick__btn--wa {
    background: #1fa855;
    color: #fff;
  }
  .quick__btn--wa:hover {
    background: #19934a;
  }
  .quick__btn--tel {
    background: var(--ink);
    color: var(--paper);
  }
  .quick__btn--tel:hover {
    background: color-mix(in srgb, var(--ink) 85%, var(--amber));
  }
  .quick__btn:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 3px;
  }
  .quick__or {
    margin: 1.25rem 0 0;
    color: var(--ink-soft);
  }
  @media (min-width: 560px) {
    .quick {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    /* The heading block has no bottom margin; without this the first field
       sat flush under the intro. */
    margin-top: 1rem;
  }
  .contact__aside {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-content: start;
  }
  .channels {
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }
  .channels__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .channels__row dt {
    color: var(--ink-soft);
    font-family: var(--font-utility);
    font-size: 0.85rem;
  }
  .channels__row dd {
    margin: 0;
    font-weight: 600;
  }
  .channels__row a:hover {
    color: var(--amber-text);
  }
  .channels__row a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .pending {
    color: var(--ink-soft);
    font-style: italic;
  }
  .map {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .map:hover {
    border-color: var(--ink);
  }
  .map__pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border-radius: 50%;
    color: var(--amber-text);
    background: color-mix(in srgb, var(--amber) 12%, transparent);
  }
  .map__text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .map__text span {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .map__ext {
    margin-left: auto;
    color: var(--ink-soft);
  }
  @media (min-width: 880px) {
    .contact {
      grid-template-columns: 1.6fr 1fr;
      gap: 4rem;
    }
  }
</style>

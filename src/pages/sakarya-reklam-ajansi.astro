        <Icon name="contact" size={18} /> {CONTACT.phone}
      </a>
    </div>
  </Section>

  {
    projects.length > 0 && (
      <Section width="narrow" space="tight">
        <SectionHeading eyebrow="Gerçek işler">
          Sakarya ve çevresinden işler
          <Fragment slot="intro">
            <p>2026 tarihli mağaza, klinik, etkinlik işleri ve kendi markamızın Reels'i; Canex 2024 tarihli, kurucu ortaklarımızın stüdyoyu kurmadan önceki işi.</p>
          </Fragment>
        </SectionHeading>
        <div class="projects-grid">
          {projects.map((p) => (
            <ProjectCard
              href={p.data.externalUrl ?? `/projeler/${p.id}/`}
              title={p.data.title}
              category={p.data.category}
              poster={p.data.poster}
              posterAlt={p.data.posterAlt}
              client={p.data.client}
              year={p.data.year}

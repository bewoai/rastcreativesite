            <td>480p ve altı HDR desteklenmiyor</td>
          </tr>
          <tr>
            <th scope="row">Vimeo</th>
            <td>H.264 High · ProRes 422 HQ · H.265</td>
            <td>{r(VIMEO["1080"])} Mbps</td>
            <td>{r(VIMEO["2160"])} Mbps</td>

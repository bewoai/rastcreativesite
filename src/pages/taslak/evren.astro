  }
  @keyframes ev-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.94;
    }
    50% {
      transform: scale(1.035);
      opacity: 1;
    }
  }

  /* ───── Header ───── */
  .ev-head {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.5rem;

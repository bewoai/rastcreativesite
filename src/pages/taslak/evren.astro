      display: none;
    }
  }

  /* ───── Orbit ───── */
  .ev-orbit__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .ev-orbit__stage {
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .ev-orbit__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ev-orbit__ring circle {
    fill: none;
    stroke: #bdb9b2;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ev-orbit__ring-in {
    stroke-dasharray: 2 6;
    opacity: 0.8;
  }
  .ev-orb--orbit {
    --s: 28%;
    top: 50%;
    left: 50%;
    translate: calc(-50% + var(--ox, 0%)) calc(-50% + var(--oy, 0%));
    transition: translate 700ms var(--ease-out);
  }
  /* The sun leans toward the selected stop. */
  .ev-orbit__grid[data-at="fikir"] .ev-orb--orbit { --ox: 0%; --oy: -22%; }
  .ev-orbit__grid[data-at="set"] .ev-orb--orbit { --ox: 22%; --oy: 0%; }
  .ev-orbit__grid[data-at="kurgu"] .ev-orb--orbit { --ox: 0%; --oy: 22%; }
  .ev-orbit__grid[data-at="teslim"] .ev-orb--orbit { --ox: -22%; --oy: 0%; }

  .ev-orbit__stops {
    position: absolute;
    inset: 0;
  }
  .ev-stop {
    --r: 37.5%; /* matches the r=150 ring in a 400 viewBox */
    position: absolute;
    top: calc(50% + sin(var(--a)) * var(--r));
    left: calc(50% + cos(var(--a)) * var(--r));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transform: translate(-50%, -50%);
  }
  .ev-stop__face {
    display: grid;
    place-items: center;
    width: clamp(4rem, 9vw, 5.6rem);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: color-mix(in srgb, var(--card) 82%, transparent);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 0 0 1px var(--line),
      0 18px 30px -18px rgba(40, 36, 30, 0.45);
    backdrop-filter: blur(10px);
    transition:
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .ev-stop__face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ev-stop__ic {
    width: 52%;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ev-stop__label {
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--card) 80%, transparent);
    font-family: var(--font-utility);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .ev-stop__n {
    color: var(--dim);
  }
  .ev-stop:hover .ev-stop__face {
    transform: translateY(-2px);
  }
  .ev-stop[aria-pressed="true"] .ev-stop__face {
    box-shadow:
      0 0 0 2px var(--amber),
      0 0 0 7px rgba(226, 83, 3, 0.12),
      0 18px 30px -18px rgba(40, 36, 30, 0.45);
  }
  .ev-stop[aria-pressed="true"] .ev-stop__label {
    background: var(--ink);
    color: #f6f5f2;
  }
  .ev-stop[aria-pressed="true"] .ev-stop__n {
    color: #f2a36e;
  }

  .ev-panel {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background: var(--card);
    border-radius: var(--r-lg);
    box-shadow: 0 30px 60px -40px rgba(40, 36, 30, 0.4);
  }
  .ev-panel + .ev-panel {
    margin-top: 1rem;
  }
  .js .ev-panel:not(.is-open) {
    display: none;
  }
  .js .ev-panel + .ev-panel {
    margin-top: 0;
  }
  .ev-panel.is-open {
    animation: ev-panel-in 420ms var(--ease-out);
  }
  @keyframes ev-panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .ev-panel__n {
    margin: 0;
    font-family: var(--font-utility);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .ev-panel__title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.6rem, 1.5vw + 1rem, 2.2rem);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .ev-panel__when {
    margin-top: 0.3rem;
    font-size: 1.55rem;
  }
  .ev-panel__text {
    margin: 0.9rem 0 0;
    color: var(--soft);
  }
  .ev-panel__note {
    margin-top: 0.8rem;
    font-size: 1.35rem;
    color: var(--soft);
    transform: rotate(-1.5deg);
    transform-origin: left;
  }
  .ev-panel__next {
    margin-top: 1.2rem;
  }
  @media (max-width: 860px) {
    .ev-orbit__grid {
      grid-template-columns: 1fr;
    }
    .ev-orbit__stage {
      width: min(100%, 22rem);
    }
  }

  /* ───── Services ───── */
  .ev-svc__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18.5rem), 1fr));
    gap: clamp(1.2rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ev-svc__card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.4rem clamp(1.3rem, 2.4vw, 1.9rem) 1.4rem;
    background: var(--card);
    border-radius: var(--r-lg);
    box-shadow: 0 30px 60px -45px rgba(40, 36, 30, 0.45);
  }
  .ev-svc__tape {
    position: absolute;
    top: -0.85rem;
    left: 1.4rem;
    padding: 0.15rem 0.85rem;
    background: rgba(236, 226, 196, 0.95);
    color: #2b2620;
    font-size: 1.3rem;
    transform: rotate(-2.5deg);
    clip-path: polygon(2% 0, 98% 4%, 100% 96%, 0 100%);
  }
  .ev-svc__title {
    margin: 0;
    font-size: clamp(1.45rem, 1vw + 1.1rem, 1.8rem);
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .ev-svc__sum {
    margin: 0.6rem 0 1rem;
    color: var(--soft);
    font-size: 1.02rem;
  }
  .ev-svc__feat {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .ev-svc__feat li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
    font-size: 1rem;
  }
  .ev-svc__card .ev-link {
    margin-top: auto;
    align-self: flex-start;
  }

  /* ───── Brands ───── */
  .ev-brands {
    padding-top: 0;
    text-align: center;
  }
  .ev-brands__title {
    font-size: 0.78rem;
  }

  /* ───── Call sheet ───── */
  .ev-call {
    padding-top: 0;
  }
  .ev-call__frame {
    position: relative;
    overflow: hidden;
    padding: clamp(2.2rem, 6vw, 5rem) clamp(1.2rem, 5vw, 4.5rem) clamp(12rem, 22vw, 17rem);
    background: linear-gradient(180deg, var(--card) 0%, #f3efe9 55%, #f6e6d8 100%);
    border-radius: calc(var(--r-lg) + 0.4rem);
    box-shadow: 0 50px 90px -60px rgba(40, 36, 30, 0.5);
    isolation: isolate;
  }
  .ev-call__dawn {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .ev-call__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }
  .ev-orb--dawn {
    --s: clamp(16rem, 34vw, 28rem);
    left: 50%;
    bottom: 0;
    translate: -50% 55%;
    transition:
      translate 1.2s var(--ease-out),
      filter 1.2s var(--ease-out);
  }
  .ev-call.is-sent .ev-orb--dawn {
    translate: -50% 30%;
    filter: brightness(1.15) saturate(1.1);
  }
  .ev-call__lede {
    margin: 1rem 0 0;
    color: var(--soft);
  }
  .ev-form {
    margin-top: clamp(1.8rem, 4vw, 2.8rem);
  }
  .ev-form__line {
    max-width: 56rem;
    margin: 0;
    font-size: clamp(1.35rem, 1.6vw + 0.9rem, 2.3rem);
    line-height: 1.75;
    letter-spacing: -0.025em;
    font-weight: 450;
  }
  .ev-fill {
    display: inline-block;
  }
  .ev-fill input,
  .ev-fill select {
    width: 10ch;
    min-height: var(--tap-min);
    padding: 0 0.25rem;
    border: 0;
    border-bottom: 1.5px solid #b6b2ab;
    border-radius: 0;
    background: transparent;
    color: var(--amber-text);
    font: inherit;
    font-family: var(--hand);
    font-weight: 600;
    font-size: 1.12em;
    line-height: 1.2;
  }
  .ev-fill--select select {
    width: auto;
    max-width: 100%;
    padding-right: 1.3rem;
    appearance: none;
    cursor: pointer;
    background:
      linear-gradient(45deg, transparent 50%, var(--amber-text) 50%) right 0.4rem center / 0.4rem 0.4rem no-repeat,
      linear-gradient(-45deg, transparent 50%, var(--amber-text) 50%) right 0.15rem center / 0.4rem 0.4rem no-repeat;
  }
  .ev-fill select option {
    font-family: var(--font-body);
    color: var(--ink);
  }
  .ev-fill input::placeholder {
    color: #aaa59d;
  }
  .ev-fill input:focus,
  .ev-fill select:focus {
    outline: none;
    border-bottom-color: var(--amber);
  }
  .ev-fill input:focus-visible,
  .ev-fill select:focus-visible {
    outline: none;
    box-shadow: 0 2px 0 var(--amber);
  }
  .ev-fill input:user-invalid {
    border-bottom-color: #c0341d;
  }
  .ev-form__note {
    display: block;
    margin-top: 1.8rem;
    font-family: var(--font-utility);
    font-size: 0.9rem;
    color: var(--soft);
  }
  .ev-form__note em {
    font-style: normal;
    opacity: 0.8;
  }
  .ev-form__area {
    display: block;
    width: min(100%, 38rem);
    min-height: 4.5rem;
    margin-top: 0.4rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.6);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    resize: vertical;
  }
  .ev-form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.1rem;
    margin-top: 1.6rem;
  }
  .ev-form__status {
    min-height: 1.5em;
    margin: 1rem 0 0;
    font-size: 1rem;
  }
  .ev-form__status.is-err {
    color: #b42318;
  }
  .ev-form__sent {
    display: none;
    font-size: 1.8rem;
    transform: rotate(-2deg);
  }
  .ev-call.is-sent .ev-form__sent {
    display: block;
  }
  .ev-form__kvkk {
    margin: 0.4rem 0 0;
    max-width: 40rem;
    font-size: 0.85rem;
    color: var(--soft);
  }
  .ev-form__kvkk a {
    color: var(--amber-text);
  }

  /* ───── Footer ───── */
  .ev-foot {
    width: min(100%, var(--max));
    margin: 0 auto;
    padding: 2rem var(--pad) 2.4rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-utility);
    font-size: 0.95rem;
  }
  .ev-foot__top {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 1.6rem;
  }
  .ev-foot__brand p {
    margin: 0.6rem 0 0;
    color: var(--soft);
  }
  .ev-foot__col {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .ev-foot__col a,
  .ev-foot__col span {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    color: var(--ink);
    text-decoration: none;
  }
  .ev-foot__col span {
    color: var(--soft);
  }
  .ev-foot__col a:hover {
    color: var(--amber-text);
  }
  .ev-foot__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 2rem;
    font-size: 0.82rem;
    color: var(--soft);
  }
  .ev-foot__bottom a {
    color: inherit;
  }
  @media (max-width: 760px) {
    .ev-foot__top {
      grid-template-columns: 1fr 1fr;
    }
    .ev-foot__brand {
      grid-column: 1 / -1;
    }
  }

  /* ───── Reduced motion: every scene lands in its resting state ───── */
  @media (prefers-reduced-motion: reduce) {
    .ev *,
    .ev *::before,
    .ev *::after {
      animation: none !important;
      transition: none !important;
    }
    .ev-case.is-active .ev-case__mon > img {
      transform: scale(1.02);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-ev]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const track = (name: string, params: Record<string, unknown>, cb?: () => void) => {
    const fn = (window as any).rcTrack;
    if (typeof fn === "function") fn(name, params, cb);
    else cb?.();
  };

  if (root) {
    /* ── Ambient videos + HUD timecode run only while on screen ── */
    const tc = root.querySelector<HTMLElement>("[data-tc]");
    const t0 = performance.now();
    let raf = 0;
    const pad = (n: number) => String(Math.floor(n)).padStart(2, "0");
    const tick = (now: number) => {
      const s = (now - t0) / 1000;
      if (tc) tc.textContent = `${pad(s / 3600)}:${pad((s / 60) % 60)}:${pad(s % 60)}:${pad((s % 1) * 25)}`;
      raf = requestAnimationFrame(tick);
    };
    const hero = root.querySelector<HTMLElement>(".ev-hero");
    if (hero && !reduce) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) raf ||= requestAnimationFrame(tick);
        else {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }).observe(hero);
    }
    if (!reduce) {
      const io = new IntersectionObserver((entries) =>
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }),
      );
      root.querySelectorAll<HTMLVideoElement>("[data-ambient]").forEach((v) => io.observe(v));
    }

    /* ── Case carousel ── */
    const trackEl = root.querySelector<HTMLElement>("[data-cases-track]");
    const cards = [...root.querySelectorAll<HTMLElement>("[data-case]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-case-dot]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-cases-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-cases-next]");
    let active = 0;

    const stopEmbeds = (except?: HTMLElement) =>
      cards.forEach((c) => {
        if (c === except) return;
        const box = c.querySelector<HTMLElement>("[data-case-embed]");
        if (box && !box.hidden) {
          box.hidden = true;
          box.replaceChildren();
        }
      });

    const setActive = (i: number) => {
      active = i;
      cards.forEach((c, k) => c.classList.toggle("is-active", k === i));
      dots.forEach((d, k) => (k === i ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === cards.length - 1;
      stopEmbeds(cards[i]);
    };
    const goTo = (i: number) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
      if (!card || !trackEl) return;
      trackEl.scrollTo({
        left: card.offsetLeft - (trackEl.clientWidth - card.clientWidth) / 2,
        behavior: reduce ? "auto" : "smooth",
      });
    };
    if (trackEl) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) setActive(cards.indexOf(e.target as HTMLElement));
          }),
        { root: trackEl, threshold: 0.6 },
      );
      cards.forEach((c) => io.observe(c));
      trackEl.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          goTo(active + 1);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          goTo(active - 1);
        }
      });
    }
    prev?.addEventListener("click", () => goTo(active - 1));
    next?.addEventListener("click", () => goTo(active + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
    // Clicking a peeking neighbour brings it to the centre.
    cards.forEach((c, i) =>
      c.addEventListener("click", (e) => {
        if (i !== active && !(e.target as Element).closest("a, button")) goTo(i);
      }),
    );
    setActive(0);

    root.querySelectorAll<HTMLButtonElement>("[data-case-play]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const card = btn.closest<HTMLElement>("[data-case]");
        const box = card?.querySelector<HTMLElement>("[data-case-embed]");
        const id = card?.dataset.yt;
        if (!card || !box || !id) return;
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = card.querySelector(".ev-case__title")?.textContent ?? "Video";
        iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        box.replaceChildren(iframe);
        box.hidden = false;
        iframe.focus();
        track("video_play", { event_category: "portfolio", video_id: id, location: "evren_case" });
      }),
    );

    /* ── Orbit stops ── */
    const orbit = root.querySelector<HTMLElement>("[data-orbit]");
    const stopBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-stop]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const openStop = (key: string, focusPanel = false) => {
      orbit?.setAttribute("data-at", key);
      stopBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.stop === key)));
      panels.forEach((p) => {
        const on = p.dataset.panel === key;
        p.classList.toggle("is-open", on);
        if (on && focusPanel) {
          p.setAttribute("tabindex", "-1");
          p.focus({ preventScroll: true });
        }
      });
    };
    stopBtns.forEach((b) => b.addEventListener("click", () => openStop(b.dataset.stop!)));
    root.querySelectorAll<HTMLButtonElement>("[data-stop-next]").forEach((b) =>
      b.addEventListener("click", () => openStop(b.dataset.stopNext!, true)),
    );
    openStop("fikir");

    /* ── Call sheet: inputs grow with their text; submit like /iletisim/ ── */
    const call = root.querySelector<HTMLElement>("[data-call]");
    const form = root.querySelector<HTMLFormElement>("[data-ev-form]");
    const status = root.querySelector<HTMLElement>("[data-ev-status]");
    form?.querySelectorAll<HTMLInputElement>(".ev-fill input").forEach((input) => {
      input.addEventListener("input", () => {
        input.style.width = `${Math.max(10, input.value.length + 1)}ch`;
      });
    });
    const say = (text: string, err = false) => {
      if (!status) return;
      status.textContent = text;
      status.className = `ev-form__status${err ? " is-err" : ""}`;
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        say("Adınızı ve telefon numaranızı yazmanız yeterli.", true);
        form.reportValidity();
        return;
      }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      say("Gönderiliyor…");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          form.reset();
          say("Teşekkürler, föyünüz bize ulaştı.");
          call?.classList.add("is-sent");
          track(
            "lead_form_submit_success",
            { event_category: "lead", event_label: "evren_call_sheet", form_id: "evren_call_sheet" },
            () => window.setTimeout(() => (window.location.href = "/tesekkurler/"), reduce ? 0 : 1400),
          );
        } else {
          say(json.message ?? "Gönderilemedi. Lütfen tekrar deneyin.", true);
        }
      } catch {
        say("Bağlantı hatası. Lütfen tekrar deneyin ya da WhatsApp'tan yazın.", true);
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

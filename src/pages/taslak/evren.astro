    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .ev-case__title {
    margin: 0.7rem 0 0;
    font-size: clamp(1.4rem, 1.4vw + 0.9rem, 2.1rem);

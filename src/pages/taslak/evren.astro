    mask-image: linear-gradient(180deg, transparent, #000 38%, #000 62%, transparent);
  }
  /* Kling cloud loop on black: `screen` drops the black and lets the cloud
     light up the fog. The container stays a non-stacking box on purpose —
     a stacking context would isolate the blend and show the black. */
  .ev-cloud.has-video {
    height: clamp(11rem, 26vw, 22rem);
    margin: calc(clamp(11rem, 26vw, 22rem) / -2) 0;

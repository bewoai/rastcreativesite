---
/**
 * /taslak/evren/ — "Evren" homepage prototype (v2 of the Işık Masası draft).
 *
 * A misty, near-monochrome world around one character: the Rast sun, a glowing
 * sphere. It appears in three scenes — the hero, the centre of the process
 * orbit, and the dawn behind the call-sheet form. Everything else is quiet.
 *
 * Kept from v1 (user feedback): the monitor (now inside the case cards), the
 * handwritten notes, the one-sentence call sheet. Dropped: the NLE timeline
 * (not usable) → replaced by four orbit stops.
 *
 * Media slots: drop files into public/evren/ and they are picked up at build
 * (see ASSETS below); until then the sphere is drawn in CSS.
 * Prompts for those files: docs/sections/evren-gorsel-uretim.md
 */
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Logo from "../../components/Logo.astro";
import LogoWall from "../../components/LogoWall.astro";
import Icon from "../../components/Icon.astro";
import {
  CONTACT,
  NAV,
  SOCIAL,
  SITE,
  WEB3FORMS_ACCESS_KEY,
  WHATSAPP_CTA_HREF,
} from "../../consts";
import { ytThumbToWebp } from "../../lib/ytimg";
import { groupByBrand } from "../../lib/brands";

/* ---- Media slots (public/evren/*) ---------------------------------- */
const slot = (file: string) =>
  fs.existsSync(path.join(process.cwd(), "public", "evren", file)) ? `/evren/${file}` : null;
const ASSETS = {
  heroWebm: slot("hero.webm"),
  heroMp4: slot("hero.mp4"),
  heroPoster: slot("hero.webp"),
  heroMobileWebm: slot("hero-dikey.webm"),
  heroMobileMp4: slot("hero-dikey.mp4"),
  heroMobilePoster: slot("hero-dikey.webp"),
  dawnWebm: slot("safak.webm"),
  dawnMp4: slot("safak.mp4"),
  dawnPoster: slot("safak.webp"),
  stops: {
    fikir: slot("durak-fikir.webp"),
    set: slot("durak-set.webp"),
    kurgu: slot("durak-kurgu.webp"),
    teslim: slot("durak-teslim.webp"),
  } as Record<string, string | null>,
};
const heroHasVideo = Boolean(ASSETS.heroWebm || ASSETS.heroMp4);
const dawnHasVideo = Boolean(ASSETS.dawnWebm || ASSETS.dawnMp4);

/* ---- Content -------------------------------------------------------- */
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft && !p.data.hidden)
  .sort(byOrder);
const brandCount = groupByBrand(projects).length;
const cases = projects.filter((p) => p.data.featured);

const services = (await getCollection("services")).sort(byOrder);
const serviceNotes = ["sete çıkıyoruz", "strateji masası", "kurgu odası"];

// Four orbit stops. Durations mirror the verified "genellikle 2–4 hafta".
const stops = [
  {
    key: "fikir",
    label: "Fikir",
    when: "1. hafta",
    title: "Ön görüşme & plan",
    text: "İhtiyacınızı dinliyoruz; hangi formatların (web, reklam, Reels) gerekeceğine baştan karar veriyoruz. Çekim günü buna göre planlanır.",
    note: "burada ücret yok, sadece sohbet",
    angle: -90,
  },
  {
    key: "set",
    label: "Set",
    when: "1–2. hafta",
    title: "Çekim günü",
    text: "Yerinde, tek ekip. Ana film, dikey kesitler ve drone planı aynı sette çekilir; tek günden birden çok içerik çıkar.",
    note: "tek gün, çok içerik",
    angle: 0,
  },
  {
    key: "kurgu",
    label: "Kurgu",
    when: "2–4. hafta",
    title: "Kurgu, renk, ses",
    text: "Kurgu, renk düzenleme ve ses tasarımı aynı masada. Revizyonları doğrudan projeyi çeken ekiple konuşursunuz.",
    note: "muhatabınız değişmez",
    angle: 90,
  },
  {
    key: "teslim",
    label: "Teslim",
    when: "genellikle 2–4 hafta içinde",
    title: "Teslim",
    text: "16:9 ana film, 9:16 dikey versiyonlar ve reklam kesitleri: her mecraya hazır dosyalar.",
    note: "yayına hazır ✓",
    angle: 180,
  },
];

const projectTypes = [
  "tanıtım filmi",
  "reklam filmi",
  "sosyal medya videosu",
  "drone çekimi",
  "ürün çekimi",
  "başka bir şey",
];

const whatsappHref = WHATSAPP_CTA_HREF ?? "/iletisim/";
const year = new Date().getFullYear();
---

<BaseLayout
  title="Taslak — Evren"
  description="Rast Creative Studio ana sayfa tasarım taslağı (evren)."
  noindex
  bare
>
  <div class="ev" data-ev>
    {/* Film grain over the whole world — one fixed layer, no per-section cost. */}
    <div class="ev-grain" aria-hidden="true"></div>

    {/* ───────── Header ───────── */}
    <header class="ev-head">
      <Logo class="ev-head__logo" />
      <nav class="ev-head__nav" aria-label="Sayfa içi">
        <a href="#isler">İşler</a>
        <a href="#surec">Nasıl çalışırız</a>
        <a href="#hizmetler">Hizmetler</a>
        <a href="/hakkimizda/">Biz</a>
      </nav>
      <div class="ev-head__act">
        <a class="ev-round" href={whatsappHref} aria-label="WhatsApp'tan yazın" data-cta-location="evren_header_wa">
          <Icon name="whatsapp" size={19} />
        </a>
        <a class="ev-pill ev-pill--sm" href="#on-gorusme" data-cta-location="evren_header">
          Ücretsiz ön görüşme
        </a>
      </div>
    </header>

    {/* ───────── 01 · Hero: the Rast sun in fog ───────── */}
    <section class="ev-hero" aria-labelledby="ev-hero-title">
      <div class="ev-hero__media" aria-hidden="true">
        {
          heroHasVideo ? (
            <video
              class="ev-hero__video"
              data-ambient
              muted
              loop
              playsinline
              preload="metadata"
              poster={ASSETS.heroPoster ?? undefined}
            >
              {ASSETS.heroMobileWebm && (
                <source src={ASSETS.heroMobileWebm} type="video/webm" media="(max-width: 700px)" />
              )}
              {ASSETS.heroMobileMp4 && (
                <source src={ASSETS.heroMobileMp4} type="video/mp4" media="(max-width: 700px)" />
              )}
              {ASSETS.heroWebm && <source src={ASSETS.heroWebm} type="video/webm" />}
              {ASSETS.heroMp4 && <source src={ASSETS.heroMp4} type="video/mp4" />}
            </video>
          ) : (
            <span class="ev-orb ev-orb--hero">
              <span class="ev-orb__rings" />
            </span>
          )
        }
      </div>

      {/* HUD: ambient labels in the corners. Never information you need. */}
      <div class="ev-hud" aria-hidden="true">
        <span class="ev-hud__tl">RAST / 001</span>
        <span class="ev-hud__side">40°46′N · 30°24′E · SERDİVAN</span>
        <span class="ev-hud__bl">Film / Fotoğraf / İçerik / AI</span>
        <span class="ev-hud__bc">↓ kaydır</span>
        <span class="ev-hud__br">TC <span data-tc>00:00:00:00</span></span>
      </div>

      <div class="ev-hero__say">
        <p class="ev-chip"><span class="ev-chip__dot"></span>Video prodüksiyon stüdyosu · Sakarya</p>
        <h1 id="ev-hero-title" class="ev-hero__title">
          <span class="ev-hero__dim">İyi iş</span>
          <span>kendini izletir.</span>
        </h1>
        <p class="ev-hero__lede">
          Reklam filmi, tanıtım filmi ve sosyal medya videolarını fikirden teslime
          tek ekip olarak üretiyoruz.
        </p>
        <div class="ev-hero__cta">
          <a class="ev-pill" href="#on-gorusme" data-cta-location="evren_hero">
            Ücretsiz ön görüşme <span aria-hidden="true">→</span>
          </a>
          <a class="ev-pill ev-pill--ghost" href="#isler" data-cta-location="evren_hero_works">
            İşleri izle
          </a>
        </div>
        <p class="ev-hero__proof">
          <strong>{brandCount}+</strong> marka · <strong>100+</strong> içerik · Sakarya, Kocaeli, Düzce
        </p>
      </div>
      <p class="ev-hand ev-hero__note" aria-hidden="true">iyi ışık, iyi iş ↗</p>
    </section>

    {/* ───────── 02 · Works: case carousel with a monitor in every card ─────────
        Native horizontal scroll with snap: swipe, trackpad and keyboard all
        work without JS; the buttons and dots are a convenience on top. */}
    <section id="isler" class="ev-sec ev-works" aria-labelledby="ev-works-title">
      <header class="ev-sec__head ev-sec__head--center">
        <p class="ev-chip"><span class="ev-chip__n">02</span><span class="ev-chip__dot"></span>Seçili işler</p>
        <h2 id="ev-works-title" class="ev-h2">Kameranın önünden geçenler</h2>
        <p class="ev-hand ev-works__aside" aria-hidden="true">hepsi gerçek müşteri işi ✓</p>
      </header>

      <div class="ev-cases" data-cases>
        <button type="button" class="ev-cases__arrow ev-cases__arrow--prev" data-cases-prev aria-label="Önceki iş">
          <span aria-hidden="true">←</span>
        </button>
        <ol class="ev-cases__track" data-cases-track tabindex="0" aria-label="İşler, yana kaydırılabilir">
          {
            cases.map((p, i) => (
              <li
                class:list={["ev-case", { "is-active": i === 0 }]}
                data-case
                data-yt={p.data.youtubeId ?? ""}
                aria-label={`${i + 1} / ${cases.length}: ${p.data.title}`}
              >
                <div class="ev-case__mon">
                  <img
                    src={ytThumbToWebp(p.data.poster, "large")}
                    alt={p.data.posterAlt ?? p.data.title}
                    width="1280"
                    height="720"
                    loading={i < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <span class="ev-case__bar" aria-hidden="true">
                    <span class="ev-case__pgm">PGM</span>
                    <span>{p.data.vertical ? "9:16" : "16:9"}</span>
                    <span class="ev-case__tc">{p.data.duration ?? "--:--"}</span>
                  </span>
                  <span class="ev-case__safe" aria-hidden="true" />
                  <div class="ev-case__embed" data-case-embed hidden />
                  <span class="ev-hand ev-case__note" aria-hidden="true">
                    {p.data.client ?? p.data.category}
                  </span>
                </div>
                <div class="ev-case__info">
                  <p class="ev-case__client">
                    <span class="ev-chip__dot" />
                    {p.data.client ?? "Rast Creative"}
                  </p>
                  <h3 class="ev-case__title">{p.data.title}</h3>
                  {p.data.summary && <p class="ev-case__sum">{p.data.summary}</p>}
                  <div class="ev-case__act">
                    {p.data.youtubeId && (
                      <button type="button" class="ev-pill ev-pill--sm" data-case-play>
                        ▶ Burada izle
                      </button>
                    )}
                    <a class="ev-link" href={`/projeler/${p.id}/`}>
                      Proje sayfası <span aria-hidden="true">→</span>
                    </a>
                  </div>
                  <dl class="ev-case__facts">
                    <div>
                      <dt>Süre</dt>
                      <dd>{p.data.duration ?? "—"}</dd>
                    </div>
                    <div>
                      <dt>Yıl</dt>
                      <dd>{p.data.year ?? "—"}</dd>
                    </div>
                    <div>
                      <dt>Format</dt>
                      <dd>{p.data.vertical ? "9:16" : "16:9"}</dd>
                    </div>
                  </dl>
                </div>
              </li>
            ))
          }
        </ol>
        <button type="button" class="ev-cases__arrow ev-cases__arrow--next" data-cases-next aria-label="Sonraki iş">
          <span aria-hidden="true">→</span>
        </button>
        <div class="ev-cases__dots" role="group" aria-label="İş seç">
          {
            cases.map((p, i) => (
              <button
                type="button"
                class="ev-dot"
                data-case-dot={i}
                aria-label={`${i + 1}. iş: ${p.data.title}`}
                aria-current={i === 0 ? "true" : undefined}
              />
            ))
          }
        </div>
      </div>

      <p class="ev-works__more">
        <a class="ev-pill" href="/projeler/">Tüm arşivi keşfet ({projects.length} iş)</a>
      </p>
    </section>

    {/* ───────── 03 · Process: four stops around the sun ─────────
        Each stop is a button; the panel beside the orbit always shows one
        stop in full, and "Sonraki durak" walks through them in order.
        Without JS all four panels render. */}
    <section id="surec" class="ev-sec ev-orbit" aria-labelledby="ev-orbit-title">
      <header class="ev-sec__head">
        <p class="ev-chip"><span class="ev-chip__n">03</span><span class="ev-chip__dot"></span>Nasıl çalışırız</p>
        <h2 id="ev-orbit-title" class="ev-h2">Fikirden teslime <span class="ev-dim">dört durak.</span></h2>
      </header>

      <div class="ev-orbit__grid" data-orbit data-at="fikir">
        <div class="ev-orbit__stage">
          <svg class="ev-orbit__ring" viewBox="0 0 400 400" aria-hidden="true">
            <circle cx="200" cy="200" r="150" />
            <circle class="ev-orbit__ring-in" cx="200" cy="200" r="96" />
          </svg>
          <span class="ev-orb ev-orb--orbit" data-orbit-orb aria-hidden="true">
            <span class="ev-orb__rings" />
          </span>
          <div class="ev-orbit__stops" role="group" aria-label="Süreç durakları">
            {
              stops.map((s, i) => (
                <button
                  type="button"
                  class="ev-stop"
                  data-stop={s.key}
                  aria-pressed={i === 0 ? "true" : "false"}
                  aria-controls={`ev-panel-${s.key}`}
                  style={`--a:${s.angle}deg`}
                >
                  <span class="ev-stop__face">
                    {ASSETS.stops[s.key] ? (
                      <img src={ASSETS.stops[s.key]!} alt="" width="160" height="160" loading="lazy" />
                    ) : (
                      <svg viewBox="0 0 48 48" aria-hidden="true" class="ev-stop__ic">
                        {s.key === "fikir" && (
                          <>
                            <rect x="9" y="13" width="30" height="22" rx="1.5" />
                            <path d="M19 13v22M29 13v22M9 20.3h30M9 27.6h30" />
                            <path d="M31 40l9-9" />
                          </>
                        )}
                        {s.key === "set" && (
                          <>
                            <rect x="10" y="14" width="20" height="13" rx="2" />
                            <path d="M30 18l8-4v13l-8-4" />
                            <path d="M20 27l-7 14M20 27l7 14M20 27v14" />
                          </>
                        )}
                        {s.key === "kurgu" && (
                          <>
                            <rect x="8" y="14" width="32" height="20" rx="1.5" />
                            <path d="M8 18h32M8 30h32M16 14v4M24 14v4M32 14v4M16 30v4M24 30v4M32 30v4" />
                          </>
                        )}
                        {s.key === "teslim" && (
                          <>
                            <rect x="6" y="16" width="24" height="15" rx="1.5" />
                            <rect x="33" y="11" width="9" height="16" rx="1.5" />
                            <path d="M14 36h8" />
                          </>
                        )}
                      </svg>
                    )}
                  </span>
                  <span class="ev-stop__label">
                    <span class="ev-stop__n">{String(i + 1).padStart(2, "0")}</span>
                    {s.label}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="ev-orbit__panels">
          {
            stops.map((s, i) => (
              <article
                id={`ev-panel-${s.key}`}
                class="ev-panel"
                data-panel={s.key}
                aria-labelledby={`ev-panel-${s.key}-t`}
              >
                <p class="ev-panel__n">Durak {String(i + 1).padStart(2, "0")} / 04</p>
                <h3 id={`ev-panel-${s.key}-t`} class="ev-panel__title">
                  {s.title}
                </h3>
                <p class="ev-hand ev-panel__when">{s.when}</p>
                <p class="ev-panel__text">{s.text}</p>
                <p class="ev-hand ev-panel__note" aria-hidden="true">— {s.note}</p>
                {i < stops.length - 1 ? (
                  <button type="button" class="ev-link ev-panel__next" data-stop-next={stops[i + 1].key}>
                    Sonraki durak: {stops[i + 1].label} <span aria-hidden="true">→</span>
                  </button>
                ) : (
                  <a class="ev-pill ev-pill--sm ev-panel__next" href="#on-gorusme">
                    İlk durağa geçelim <span aria-hidden="true">→</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ───────── 04 · Services ───────── */}
    <section id="hizmetler" class="ev-sec ev-svc" aria-labelledby="ev-svc-title">
      <header class="ev-sec__head">
        <p class="ev-chip"><span class="ev-chip__n">04</span><span class="ev-chip__dot"></span>Hizmetler</p>
        <h2 id="ev-svc-title" class="ev-h2">Üç masa, <span class="ev-dim">tek ekip.</span></h2>
      </header>
      <ul class="ev-svc__list">
        {
          services.map((s, i) => (
            <li class="ev-svc__card">
              <span class="ev-hand ev-svc__tape" aria-hidden="true">
                {serviceNotes[i] ?? s.data.title}
              </span>
              <h3 class="ev-svc__title">{s.data.title}</h3>
              <p class="ev-svc__sum">{s.data.summary}</p>
              <ul class="ev-svc__feat">
                {s.data.features.slice(0, 4).map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a class="ev-link" href={`/hizmetler/#${s.id}`}>
                Detay <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ───────── Brands ───────── */}
    <section class="ev-sec ev-brands" aria-labelledby="ev-brands-title">
      <h2 id="ev-brands-title" class="ev-chip ev-brands__title">
        <span class="ev-chip__dot"></span>Birlikte çalıştığımız markalar
      </h2>
      <LogoWall />
    </section>

    {/* ───────── 05 · Call sheet: the sun rises behind the form ───────── */}
    <section id="on-gorusme" class="ev-sec ev-call" aria-labelledby="ev-call-title" data-call>
      <div class="ev-call__frame">
        <div class="ev-call__dawn" aria-hidden="true">
          {
            dawnHasVideo ? (
              <video
                class="ev-call__video"
                data-ambient
                muted
                loop
                playsinline
                preload="none"
                poster={ASSETS.dawnPoster ?? undefined}
              >
                {ASSETS.dawnWebm && <source src={ASSETS.dawnWebm} type="video/webm" />}
                {ASSETS.dawnMp4 && <source src={ASSETS.dawnMp4} type="video/mp4" />}
              </video>
            ) : (
              <span class="ev-orb ev-orb--dawn">
                <span class="ev-orb__rings" />
              </span>
            )
          }
        </div>

        <header class="ev-call__head">
          <p class="ev-chip"><span class="ev-chip__n">05</span><span class="ev-chip__dot"></span>Ücretsiz ön görüşme</p>
          <h2 id="ev-call-title" class="ev-h2">Bize bir cümle <span class="ev-dim">yazın.</span></h2>
          <p class="ev-call__lede">
            Gerisini telefonda konuşuruz. Fiyat ve kapsam için ilk görüşme ücretsiz.
          </p>
        </header>

        <form class="ev-form" action="https://api.web3forms.com/submit" method="POST" data-ev-form>
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value="Yeni ön görüşme talebi — rastcreative.com (taslak evren)" />
          <input type="hidden" name="from_name" value={SITE.name} />
          <input type="checkbox" name="botcheck" class="ev-sr" tabindex="-1" autocomplete="off" />

          <p class="ev-form__line">
            Merhaba, ben
            <label class="ev-fill">
              <span class="ev-sr">Adınız soyadınız (zorunlu)</span>
              <input id="ev-name" name="name" type="text" autocomplete="name" minlength="2" required placeholder="adınız" />
            </label>,
            <label class="ev-fill">
              <span class="ev-sr">Firma (isteğe bağlı)</span>
              <input id="ev-company" name="company" type="text" autocomplete="organization" placeholder="firmanız" />
            </label>
            için bir
            <label class="ev-fill ev-fill--select">
              <span class="ev-sr">Proje türü</span>
              <select id="ev-type" name="project_type">
                {projectTypes.map((t) => <option value={t}>{t}</option>)}
              </select>
            </label>
            düşünüyoruz. Bana
            <label class="ev-fill">
              <span class="ev-sr">Telefon (zorunlu)</span>
              <input id="ev-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" minlength="10" required placeholder="telefonunuz" />
            </label>
            numarasından ulaşabilirsiniz.
          </p>

          <label class="ev-form__note" for="ev-message">
            <span>Eklemek istediğiniz bir not var mı? <em>(isteğe bağlı)</em></span>
          </label>
          <textarea id="ev-message" class="ev-form__area" name="message" rows="2" placeholder="tarih, lokasyon, ne çekilecek…"></textarea>

          <div class="ev-form__foot">
            <button type="submit" class="ev-pill">Föyü gönder <span aria-hidden="true">→</span></button>
            <a class="ev-pill ev-pill--ghost" href={whatsappHref} data-cta-location="evren_form_wa">
              ya da WhatsApp'tan yazın
            </a>
            <a class="ev-link" href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
          </div>
          <p class="ev-form__status" data-ev-status role="status" aria-live="polite"></p>
          <p class="ev-hand ev-form__sent" aria-hidden="true">föy elimizde ✓ sizi arıyoruz</p>
          <p class="ev-form__kvkk">
            Göndererek <a href="/kvkk/">KVKK Aydınlatma Metni</a>'ni okuduğunuzu kabul
            etmiş sayılırsınız. Verileriniz yalnızca size dönüş için kullanılır.
          </p>
        </form>
      </div>
    </section>

    {/* ───────── Footer: stays in the light ───────── */}
    <footer class="ev-foot">
      <div class="ev-foot__top">
        <div class="ev-foot__brand">
          <Logo />
          <p>İyi iş kendini izletir.</p>
        </div>
        <nav class="ev-foot__col" aria-label="Alt gezinme">
          {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="/blog/">Blog</a>
        </nav>
        <div class="ev-foot__col">
          <span>{CONTACT.city}</span>
          <a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </div>
        <div class="ev-foot__col ev-foot__social">
          {
            SOCIAL.map((s) => (
              <a href={s.href} target="_blank" rel="me noopener noreferrer">
                {s.label} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="ev-foot__bottom">
        <span>© {year} {SITE.name}</span>
        <span><a href="/kvkk/">KVKK</a> · <a href="/telif/">Telif</a></span>
      </div>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  /* ───── Fonts (self-hosted; latin + latin-ext for Turkish) ───── */
  @font-face {
    font-family: "Caveat";

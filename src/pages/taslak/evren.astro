  }

  /* ───── Tokens: fog, ink, one amber light ───── */
  .ev {
    --fog: #e9e8e5;
    --fog-deep: #dcdad6;
    --card: #f8f7f5;
    --ink: #111110;
    --dim: #9a9791;

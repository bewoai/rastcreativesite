  }
  .ev-orb__rings {
    position: absolute;
    inset: -28%;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      0 0 0 3.2rem rgba(255, 255, 255, 0.07),
      0 0 0 calc(3.2rem + 1px) rgba(255, 255, 255, 0.35);

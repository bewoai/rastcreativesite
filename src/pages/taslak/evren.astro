<script>
  const root = document.querySelector<HTMLElement>("[data-ev]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const track = (name: string, params: Record<string, unknown>, cb?: () => void) => {
    const fn = (window as any).rcTrack;
    if (typeof fn === "function") fn(name, params, cb);
    else cb?.();
  };

  if (root) {
    /* ── Hero: on-air monitor cycles only while the hero is visible ── */
    const hero = root.querySelector<HTMLElement>(".ev-hero");
    const frames = [...root.querySelectorAll<HTMLImageElement>("[data-onair-frame]")];
    const onAirTitle = root.querySelector<HTMLElement>("[data-onair-title]");
    let cycle = 0;
    let frame = 0;
    const nextFrame = () => {
      if (frames.length < 2) return;
      frames[frame].classList.remove("is-on");
      frame = (frame + 1) % frames.length;
      const img = frames[frame];
      img.classList.add("is-on");
      if (onAirTitle) onAirTitle.textContent = img.dataset.title ?? "";
    };
    if (hero && !reduce) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) {
          cycle ||= window.setInterval(nextFrame, 3200);
        } else {
          window.clearInterval(cycle);
          cycle = 0;
        }
      }).observe(hero);
    }

    /* ── Dolly-in: scroll progress through the pinned hero → --p (0…1) ── */
    const dolly = root.querySelector<HTMLElement>("[data-dolly]");
    if (dolly && !reduce) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = dolly.getBoundingClientRect();
        const range = r.height - innerHeight;
        const p = range > 0 ? Math.min(1, Math.max(0, -r.top / range)) : 0;
        dolly.style.setProperty("--p", p.toFixed(4));
        dolly.toggleAttribute("data-deep", p > 0.3);
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll);
      update();
    }

    /* ── Ambient videos play only on screen ── */
    if (!reduce) {
      const io = new IntersectionObserver((entries) =>
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }),
      );
      root.querySelectorAll<HTMLVideoElement>("video[data-ambient]").forEach((v) => io.observe(v));
    }

    /* ── Button light follows the pointer ── */
    root.addEventListener("pointermove", (e) => {
      const btn = (e.target as Element).closest<HTMLElement>(".ev-btn");
      if (!btn) return;
      const r = btn.getBoundingClientRect();
      btn.style.setProperty("--gx", `${((e.clientX - r.left) / r.width) * 100}%`);
    });

    /* ── Case carousel ── */
    const trackEl = root.querySelector<HTMLElement>("[data-cases-track]");
    const cards = [...root.querySelectorAll<HTMLElement>("[data-case]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-case-dot]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-cases-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-cases-next]");
    let active = 0;
    const counter = root.querySelector<HTMLElement>("[data-case-count]");
    const setActive = (i: number) => {
      active = i;
      cards.forEach((c, k) => c.classList.toggle("is-active", k === i));
      dots.forEach((d, k) => (k === i ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === cards.length - 1;
      if (counter) counter.textContent = cards[i]?.dataset.roman ?? "";
    };
    const goTo = (i: number) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
      if (!card || !trackEl) return;
      trackEl.scrollTo({
        left: card.offsetLeft - (trackEl.clientWidth - card.clientWidth) / 2,
        behavior: reduce ? "auto" : "smooth",
      });
    };
    if (trackEl) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) setActive(cards.indexOf(e.target as HTMLElement));
          }),
        { root: trackEl, threshold: 0.6 },
      );
      cards.forEach((c) => io.observe(c));
      trackEl.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          goTo(active + 1);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          goTo(active - 1);
        }
      });
    }
    prev?.addEventListener("click", () => goTo(active - 1));
    next?.addEventListener("click", () => goTo(active + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
    cards.forEach((c, i) =>
      c.addEventListener("click", (e) => {
        if (i !== active && !(e.target as Element).closest("a, button")) goTo(i);
      }),
    );
    setActive(0);

    /* ── Cinema: plays inside the site, never sends people to YouTube ── */
    const cinema = root.querySelector<HTMLDialogElement>("[data-cinema]");
    const slot = root.querySelector<HTMLElement>("[data-cinema-slot]");
    const cinemaTitle = root.querySelector<HTMLElement>("[data-cinema-title]");
    let opener: HTMLElement | null = null;
    const closeCinema = () => cinema?.open && cinema.close();
    cinema?.addEventListener("close", () => {
      slot?.replaceChildren(); // stops playback
      opener?.focus();
    });
    root.querySelector("[data-cinema-close]")?.addEventListener("click", closeCinema);
    cinema?.addEventListener("click", (e) => {
      if (e.target === cinema) closeCinema(); // click on the dimmed backdrop
    });
    root.querySelectorAll<HTMLButtonElement>("[data-case-play]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const card = btn.closest<HTMLElement>("[data-case]");
        const id = card?.dataset.yt;
        if (!cinema || !slot || !id) return;
        opener = btn;
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
        iframe.title = btn.dataset.title ?? "Video";
        iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        slot.replaceChildren(iframe);
        if (cinemaTitle) cinemaTitle.textContent = btn.dataset.title ?? "Video";
        cinema.showModal();
        track("video_play", { event_category: "portfolio", video_id: id, location: "evren_cinema" });
      }),
    );

    /* ── Process path: the sun walks I → IV, lighting one stop at a time ── */
    const path = root.querySelector<HTMLElement>("[data-path]");
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    if (path && steps.length) {
      let at = 0;
      let walk = 0;
      const light = (i: number) => {
        at = i;
        path.style.setProperty("--at", String(i));
        steps.forEach((el, k) => el.classList.toggle("is-lit", k === i));
      };
      const start = () => {
        if (reduce || walk) return;
        walk = window.setInterval(() => light((at + 1) % steps.length), 3400);
      };
      const stop = () => {
        window.clearInterval(walk);
        walk = 0;
      };
      // Pointing at a stop moves the sun there and holds it.
      steps.forEach((el, i) => {
        el.addEventListener("pointerenter", () => {
          stop();
          light(i);
        });
        el.addEventListener("pointerleave", start);
      });
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.3 }).observe(path);
    }

    /* ── Sections surface as they arrive ── */
    const risers = [...root.querySelectorAll<HTMLElement>("[data-rise]")];
    if (reduce || !("IntersectionObserver" in window)) {
      risers.forEach((el) => el.classList.add("is-in"));
    } else {
      const rio = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              rio.unobserve(e.target);
            }
          }),
        { rootMargin: "0px 0px -4% 0px", threshold: 0.05 },
      );
      risers.forEach((el) => rio.observe(el));
    }

    /* ── Hero: the world leans a little toward the pointer ── */
    const media = root.querySelector<HTMLElement>(".ev-hero__media");
    if (hero && media && !reduce && matchMedia("(pointer: fine)").matches) {
      let mx = 0;
      let my = 0;
      let pending = false;
      hero.addEventListener("pointermove", (e) => {
        const r = hero.getBoundingClientRect();
        mx = ((e.clientX - r.left) / r.width - 0.5) * -14;
        my = ((e.clientY - r.top) / r.height - 0.5) * -10;
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          media.style.translate = `${mx}px ${my}px`;
          pending = false;
        });
      });
      media.style.transition = "translate 1.2s cubic-bezier(0.22, 1, 0.36, 1)";
    }

    /* ── Call sheet ── */
    const call = root.querySelector<HTMLElement>("[data-call]");
    const form = root.querySelector<HTMLFormElement>("[data-ev-form]");
    const status = root.querySelector<HTMLElement>("[data-ev-status]");
    form?.querySelectorAll<HTMLInputElement>(".ev-fill input").forEach((input) => {
      input.addEventListener("input", () => {
        input.style.width = `${Math.max(input.type === "tel" ? 11 : 9, input.value.length + 1)}ch`;
      });
    });
    const say = (text: string, err = false) => {
      if (!status) return;
      status.textContent = text;
      status.className = `ev-form__status${err ? " is-err" : ""}`;
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        say("Adınızı ve telefon numaranızı yazmanız yeterli.", true);
        form.reportValidity();
        return;
      }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      say("Gönderiliyor…");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          form.reset();
          say("Teşekkürler, föyünüz bize ulaştı.");
          call?.classList.add("is-sent");
          track(
            "lead_form_submit_success",
            { event_category: "lead", event_label: "evren_call_sheet", form_id: "evren_call_sheet" },
            () => window.setTimeout(() => (window.location.href = "/tesekkurler/"), reduce ? 0 : 1400),
          );
        } else {
          say(json.message ?? "Gönderilemedi. Lütfen tekrar deneyin.", true);
        }
      } catch {
        say("Bağlantı hatası. Lütfen tekrar deneyin ya da WhatsApp'tan yazın.", true);
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

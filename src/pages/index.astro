    }
  }

  /* 3.5 — stats bar */
  .stats {
    list-style: none;
    margin: 0;
    padding: 1.4rem clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);

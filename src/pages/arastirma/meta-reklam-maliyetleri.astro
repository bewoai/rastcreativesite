  <script>
    const out = document.querySelector<HTMLElement>("[data-copied-meta]");
    document.querySelectorAll<HTMLButtonElement>("[data-copy-meta]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const sel = btn.dataset.copyMeta === "html" ? "[data-cite-meta-html]" : "[data-cite-meta]";
        const ta = document.querySelector<HTMLTextAreaElement>(sel);
        if (!ta) return;
        try {
          await navigator.clipboard.writeText(ta.value);
        } catch {
          ta.select();
          document.execCommand("copy");
        }
        if (out) out.textContent = "Kopyalandı.";
      });
    });
  </script>

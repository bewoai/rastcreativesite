  <script>
    const out = document.querySelector<HTMLElement>("[data-copied-reels]");
    document.querySelectorAll<HTMLButtonElement>("[data-copy-reels]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const sel = btn.dataset.copyReels === "html" ? "[data-cite-reels-html]" : "[data-cite-reels]";
        const ta = document.querySelector<HTMLTextAreaElement>(sel);
        if (!ta) return;
        try {
          await navigator.clipboard.writeText(ta.value);
        } catch {
          ta.select();
          document.execCommand("copy");
        }
        if (out) out.textContent = "Kopyalandı.";
      });
    });
  </script>

    stats: ADS,
  },
];

const faqs = [
  {
    question: "Türkiye’de kaç kişi Instagram kullanıyor?",
    answer:
      "DataReportal’ın Digital 2026 Türkiye raporuna göre Instagram reklamları 2025 sonunda Türkiye’de 62,3 milyon kişiye ulaşabiliyordu; bu, 18 yaş üstü nüfusun %92,1’i ve ölçülen ülkeler arasında en yüksek oran. TÜİK’in 2026 araştırmasında ise 16–74 yaş arası kişilerin %71,1’i Instagram kullandığını söyledi. İlk rakam reklam aracının erişim tahmini, ikincisi hane anketi; ikisi farklı şeyi ölçüyor.",
  },
  {
    question: "Türkiye’de insanlar haftada ne kadar Reels ve kısa video izliyor?",

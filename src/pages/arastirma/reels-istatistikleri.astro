const citeText = `Rast Creative (2026). Türkiye Reels ve Kısa Video İstatistikleri 2026. Son güncelleme ${UPDATED_TR}. ${PAGE_URL}`;
const citeHtml = `<a href="${PAGE_URL}">Türkiye Reels ve kısa video istatistikleri 2026 — Rast Creative</a>`;

const jsonLd = [
  breadcrumb([
    { name: "Ana Sayfa", path: "/" },
    { name: "Araştırma", path: "/arastirma/" },
    { name: "Reels istatistikleri 2026", path: PATH },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: h1,
    description,
    url: PAGE_URL,
    mainEntityOfPage: PAGE_URL,
    inLanguage: "tr",
    datePublished: PUBLISHED,
    dateModified: UPDATED,
    image: `${SITE.url}${PATH}og.jpg`,
    author: { "@id": `${SITE.url}#organization` },
    publisher: { "@id": `${SITE.url}#organization` },
    about: ["Instagram Reels", "Kısa video", "Türkiye sosyal medya kullanımı", "Video reklam", "ThruPlay"],
    citation: Object.values(SOURCES).map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url })),
    license: "https://creativecommons.org/licenses/by/4.0/deed.tr",
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `Türkiye Reels ve kısa video istatistikleri 2026 (Rast Creative) — ${INDEX_NAME}`,
    description:
      "Türkiye’de Instagram ve kısa video kullanımına dair kaynaklı istatistikler; Rast Creative’in yönettiği Meta reklam hesaplarından anonim, toplulaştırılmış Ekim 2026 video metrikleri (ThruPlay başı maliyet, ThruPlay oranı, CPM) ve ajansın kendi Instagram hesabının Reels verileri.",
    url: PAGE_URL,
    creator: { "@id": `${SITE.url}#organization` },
    publisher: { "@id": `${SITE.url}#organization` },
    license: "https://creativecommons.org/licenses/by/4.0/deed.tr",
    isAccessibleForFree: true,
    inLanguage: "tr",
    dateModified: UPDATED,
    temporalCoverage: "2025-04-01/2026-11-02",
    spatialCoverage: { "@type": "Place", name: "Türkiye" },
    keywords: ["Reels istatistikleri", "Instagram Türkiye", "kısa video", "ThruPlay maliyeti", "Reels etkileşim oranı", "atlanma oranı"],
    variableMeasured: [
      "Haftalık kısa video izleme süresi",
      "Instagram kullanım oranı",
      "Reels etkileşim oranı",

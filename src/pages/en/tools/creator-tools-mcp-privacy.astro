---
/**
 * Privacy policy for the "Rast Creator Tools" remote MCP server (repo bewoai/rast-creator-tools-mcp, endpoint /v1/mcp).
 * Linked from the Google Connected Apps listing. Same text as PRIVACY.md in that repo — keep both in sync.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/Section.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import { CONTACT } from "../../../consts";
import { breadcrumb } from "../../../lib/schema";

const updated = "1 November 2026";
const ENDPOINT = "https://rast-creator-tools-mcp.studio-c25.workers.dev/v1/mcp";
const pageJsonLd = [
  breadcrumb([
    { name: "Free tools", path: "/en/tools/" },
    { name: "Rast Creator Tools MCP privacy policy", path: "/en/tools/creator-tools-mcp-privacy/" },
  ]),
];
---

<BaseLayout
  title="Rast Creator Tools (MCP server) privacy policy"
  description="Privacy policy of Rast Creator Tools, the free MCP server by Rast Creative Studio for AI assistants: no account, no personal data, nothing stored or logged."
  jsonLd={pageJsonLd}
>
  <Section width="narrow">
    <SectionHeading eyebrow="Legal" as="h1">
      Rast Creator Tools privacy policy
      <Fragment slot="intro">
        <p>Remote MCP server for AI assistants · Last updated: {updated}</p>
      </Fragment>
    </SectionHeading>

    <div class="legal">
      <p>
        <strong>Rast Creator Tools</strong> (the “app”) is a free remote MCP server by Rast Creative Studio (rastcreative.com) that
        answers video-production questions inside AI assistants such as Gemini. Endpoint: <code>{ENDPOINT}</code>
      </p>
      <p>
        <strong>Short version: the app collects no personal data, needs no account and stores nothing.</strong> Each request is
        calculated and answered, then forgotten.
      </p>

      <h2>What the app receives</h2>
      <p>
        When you ask an assistant a question that uses the app, the assistant sends the app only the values the tool needs, for
        example a platform name (“reels”), frame size, a text box position, a video duration and bitrate, or the text of a subtitle
        file you chose to check. The app does not receive your name, email, Google account, contacts, location or conversation
        history.
      </p>

      <h2>What the app does with it</h2>
      <ul>
        <li>The values are used only to calculate the answer for that request (safe-zone margins, overlap check, file size, subtitle issues, export settings).</li>
        <li>Nothing is written to a database, file, cache or log by the app. There are no cookies, analytics, advertising or tracking.</li>
        <li>Subtitle text is processed in memory for the single response and discarded.</li>
        <li>No data is sold, shared or used to train models.</li>
      </ul>

      <h2>Hosting</h2>
      <p>
        The app runs on Cloudflare Workers. Like any web host, Cloudflare handles network data such as IP addresses to deliver
        requests and protect against abuse, under
        <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">Cloudflare's own privacy policy</a>. Application logging
        is turned off.
      </p>

      <h2>Your choices and deletion</h2>
      <p>
        Because the app stores nothing, there is no data to view, export or delete. You can disconnect the app in your assistant's
        settings at any time (in Gemini: Settings → Connected apps).
      </p>

      <h2>Children</h2>
      <p>The app is a general-audience production tool and is not directed at children.</p>

      <h2>Links</h2>
      <p>
        Each answer includes a link to the matching free tool on rastcreative.com. If you open it, that website's own
        <a href="/kvkk/">privacy notice</a> applies (it is in Turkish and covers cookies and analytics on rastcreative.com).
      </p>

      <h2>Changes and contact</h2>
      <p>
        If the app ever starts handling data differently, this page will be updated before the change and the date above will
        change. Questions: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> — Rast Creative Studio, Sakarya, Türkiye.
      </p>
      <p>
        <a href="/en/tools/creator-tools-mcp-terms/">Terms of service</a> ·
        <a href="/en/tools/">← More free creator tools</a>
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .legal {
    margin-top: 2.5rem;
    max-width: 68ch;
    color: var(--ink-soft);
    line-height: var(--leading-body);
  }
  .legal h2 {
    margin: 2rem 0 0.6rem;
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink);
  }
  .legal p {
    margin: 0 0 1rem;
  }
  .legal ul {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .legal a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-underline-offset: 3px;
  }
</style>

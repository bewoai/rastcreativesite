From ef1d5315148bad13e644c79886c4e0b4cd3b6dfb Mon Sep 17 00:00:00 2001
From: Rast Creative Studio <studio@rastcreative.com>
Date: Tue, 18 Aug 2026 15:24:30 +0300
Subject: [PATCH 2/3] fix(nav): daralmis alt barda butonlara zemin ekle

Tab hapi daralinca WhatsApp ve Menu butonlari sayfada akan icerigin --
cogunlukla bir fotografin -- uzerinde bosta kaliyordu; kopuk duruyor ve
etiketler kontrast kaybediyordu.

Alt kenara yumusak bir karartma seridi eklendi: butonlar bir yuzeye
oturuyor ama kapali bir bara hapsolmuyor. Yalnizca .is-condensed
durumunda gorunur, reduced-motion'da gecis kapali.
---
 src/components/GlassNav.astro | 37 +++++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/src/components/GlassNav.astro b/src/components/GlassNav.astro
index d90f54c..2e6f852 100644
--- a/src/components/GlassNav.astro
+++ b/src/components/GlassNav.astro
@@ -342,6 +342,43 @@ const whatsappHref = WHATSAPP_CTA_HREF ?? "/iletisim#teklif-formu";
     padding: 0.35rem 0.65rem calc(0.35rem + env(safe-area-inset-bottom, 0px));
     pointer-events: none;
   }
+  /* Condensed state backdrop.
+     Once the tab pill collapses, the WhatsApp and menu buttons are left
+     floating over whatever happens to scroll past — usually a photo, which
+     made them look detached and cost the labels their contrast. A soft
+     bottom scrim gives both buttons a surface to sit on without boxing
+     them into a solid bar. */
+  .tabbar::before {
+    content: "";
+    position: absolute;
+    inset: auto 0 0 0;
+    height: calc(4.75rem + env(safe-area-inset-bottom, 0px));
+    background: linear-gradient(
+      180deg,
+      transparent,
+      color-mix(in srgb, var(--paper) 62%, transparent) 55%,
+      color-mix(in srgb, var(--paper) 85%, transparent)
+    );
+    -webkit-backdrop-filter: blur(10px);
+    backdrop-filter: blur(10px);
+    -webkit-mask-image: linear-gradient(180deg, transparent, #000 45%);
+    mask-image: linear-gradient(180deg, transparent, #000 45%);
+    opacity: 0;
+    visibility: hidden;
+    pointer-events: none;
+    transition:
+      opacity var(--dur) var(--ease-out),
+      visibility var(--dur) var(--ease-out);
+  }
+  .tabbar.is-condensed::before {
+    opacity: 1;
+    visibility: visible;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .tabbar::before {
+      transition: none;
+    }
+  }
   .tabbar__inner {
     pointer-events: auto;
     display: flex;
-- 
2.34.1



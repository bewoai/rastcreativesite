+           * first paint behind a ~3.3s exposure sequence loses them before
+           * they ever see the page. Organic visitors still get the full
+           * brand moment. Once flagged, the skip sticks for the session so
+           * internal navigation stays consistent.
+           */
+          let paidVisit = false;
+          try {
+            const PAID_PARAMS = [
+              "gclid",
+              "gbraid",
+              "wbraid",
+              "gad_source",
+              "gclsrc",
+              "utm_source",
+              "utm_medium",
